                              </tr>
                              <tr>
                                 <td>Diphenhydramine HCl 25 mg...............</td>
                                 <td>Nighttime sleep-aid</td>
                              </tr>
                           </tbody>
                        </table>
                        <paragraph/>
                     </text>
