            <section ID="id_link_561fa886-2381-28ba-e063-6394a90a9f25">
               <id root="5754acb8-de6f-4870-e063-6394a90abe64"/>
               <code code="34067-9" codeSystem="2.16.840.1.113883.6.1" displayName="INDICATIONS &amp; USAGE SECTION"/>
               <title>Indications and Usage</title>
               <text>
                  <paragraph>Indications and Usage</paragraph>
               </text>
               <effectiveTime value="20260724"/>
               <component>
                  <section ID="id_link_552f84c7-c6b7-c329-e063-6294a90ac3a0">
                     <id root="5754aa1c-4b8d-44e6-e063-6394a90a3ca5"/>
                     <code code="34068-7" codeSystem="2.16.840.1.113883.6.1" displayName="DOSAGE &amp; ADMINISTRATION SECTION"/>
                     <title>Directions</title>
                     <text>
                        <list listType="unordered">
                           <item>this product does not contain directions or complete warnings for adult use.</item>
                           <item>do not give more than directed (see overdose warning).</item>
                           <item>find the right dose on the chart below. If possible, use weight to dose; otherwise, use age.</item>
                           <item>repeat dose every 4 hours while symptoms</item>
                           <item>do not give more than 5 times in 24 hours</item>
                        </list>
                        <paragraph>*or as directed by a doctor</paragraph>
                        <paragraph/>
                     </text>
                     <effectiveTime value="20260724"/>
                  </section>
               </component>
            </section>
         </component>
         <component>
            <section ID="id_link_552f95c9-e6de-a1d7-e063-6294a90a83d6">
               <id root="5754ae9e-946e-8bf1-e063-6294a90ad2c4"/>
               <code code="60561-8" codeSystem="2.16.840.1.113883.6.1" displayName="OTHER SAFETY INFORMATION"/>
               <title>Other Information</title>
               <text>
                  <paragraph>Do not use if safety seal is broken or missing. Store in a cool, dry place at 20–25°C (68–77°F). Protect from excessive heat and humidity.</paragraph>
               </text>
               <effectiveTime value="20260724"/>
            </section>
         </component>
