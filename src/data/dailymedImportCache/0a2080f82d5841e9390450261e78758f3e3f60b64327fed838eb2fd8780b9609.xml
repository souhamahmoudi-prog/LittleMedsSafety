               <code code="51945-4" codeSystem="2.16.840.1.113883.6.1" displayName="PACKAGE LABEL.PRINCIPAL DISPLAY PANEL"/>
               <title>Principal Display Panel</title>
               <text>
                  <paragraph>Heartburn Relief</paragraph>
                  <paragraph>Compare to Pepcid Complete<sup>®</sup> active ingredients</paragraph>
                  <paragraph>Dual Action Complete</paragraph>
