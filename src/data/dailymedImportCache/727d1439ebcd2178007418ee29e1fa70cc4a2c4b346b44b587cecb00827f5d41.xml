         <component>
            <section ID="LINK_43a50c9e-957c-4970-8eb5-ddaa96de6cdd">
               <id root="1664ccc3-7bfd-4097-8862-a4c0dff71b37"/>
               <code code="34071-1" codeSystem="2.16.840.1.113883.6.1" displayName="WARNINGS SECTION"/>
               <title>WARNINGS</title>
               <text>
                  <table>
                     <col width="100%"/>
                     <tbody>
                        <tr>
                           <td valign="top" styleCode="     Botrule          Toprule         Lrule          Rrule     ">
                              <content styleCode="bold">WARNING: Accidental overdose of iron-containing products is a leading cause of fatal poisoning in children under 6. KEEP THIS PRODUCT OUT OF THE REACH OF CHILDREN. In case of accidental overdose, call a doctor or poison control center immediately.</content>
                           </td>
                        </tr>
                     </tbody>
                  </table>
               </text>
               <effectiveTime value="20181030"/>
            </section>
         </component>
