               <code code="34068-7" codeSystem="2.16.840.1.113883.6.1" displayName="DOSAGE &amp; ADMINISTRATION SECTION"/>
               <title>
                  <content styleCode="bold">
                     <content styleCode="italics">Directions</content>
                  </content>
               </title>
               <text>
                  <list listType="unordered">
                     <item>
                        <content styleCode="bold">do not take more than directed (see Overdose warning)</content>
                     </item>
                     <item>do not take more than 6 doses in any 24 hour period</item>
                     <item>measure only with dosing cup provided</item>
                     <item>do not use dosing cup with other products</item>
                     <item>dose as follows or as directed by a doctor</item>
                     <item>mL=milliliter</item>
                     <item>tsp=teaspoonful</item>
                  </list>
                  <paragraph>Children 6 to under 12 years of age 10mL or 2 tsp in dosing cup provided every 4 hours
  <br/>
Children under 6 years of age do not use
 </paragraph>
                  <paragraph/>
               </text>
               <effectiveTime value="20240927"/>
            </section>
