                              <paragraph>under 2 years</paragraph>
                           </td>
                           <td align="center" styleCode="Rrule Lrule Toprule Botrule " valign="middle">
                              <paragraph>ask a doctor</paragraph>
                           </td>
                        </tr>
                        <tr>
                           <td align="center" styleCode="Rrule Lrule Botrule " valign="middle">
                              <paragraph>24-35</paragraph>
                           </td>
                           <td align="center" styleCode="Rrule Lrule Toprule Botrule " valign="middle">
                              <paragraph>2-3 years</paragraph>
                           </td>
                           <td align="center" styleCode="Rrule Lrule Toprule Botrule " valign="middle">
                              <paragraph>5 mL (1 unit dose cup)</paragraph>
                           </td>
                        </tr>
                        <tr>
                           <td align="center" styleCode="Rrule Lrule Botrule " valign="middle">
                              <paragraph>36-47</paragraph>
