---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  dosageFormFilterGroups,
  dosageFormFilterOptions,
} from '../data/medicationCarbohydrateReference';

const {
  approvedRecords: suppliedApprovedRecords = [],
  mode = 'public',
  title = 'Pediatric Medication Carbohydrate Reference | LittleMeds Safety',
  description = 'Look up documented manufacturer-specific carbohydrate content for medication products used in children receiving ketogenic dietary therapy.',
} = Astro.props;
const approvedRecords = suppliedApprovedRecords.filter(
  (record) => record.approvalStatus === 'approved',
);
const approvedRecordCount = approvedRecords.length;
const isPreview = mode === 'preview';
const dosageForms = dosageFormFilterOptions;
const sourceTypes = [...new Set(approvedRecords.flatMap((record) => [
  record.fieldSourceProvenance?.carbohydrateDisplayValue?.sourceName,
  record.sourceName,
  record.sourceType,
  'DailyMed product label',
]).filter(Boolean))].sort();
---

<BaseLayout
  title={title}
  description={description}
>
  <main class="reference-page">
    <section class="reference-hero">
      <div class="reference-container">
        <a class="reference-brand" href="/" aria-label="LittleMeds Safety home">
          <span class="reference-brand__mark" aria-hidden="true">LMS</span>
          <span>LittleMeds Safety</span>
        </a>
        <p class="reference-eyebrow">Medication Reference</p>
        <h1>Pediatric Medication Carbohydrate Reference</h1>
        <p class="reference-lede">
          Search approved local records for documented, manufacturer-specific carbohydrate content of an exact medication product.
        </p>
        <div class="reference-notice">
          {isPreview ? (
            <>
              Local preview only — session-approved records shown here are not published.
            </>
          ) : (
            <>
              The public reference searches approved local records only. It does not
              query DailyMed in the browser, calculate dose exposure, assess
              ketogenic-diet compatibility, classify medications as safe or unsafe,
              estimate missing values, or apply one manufacturer's value to another
              product.
            </>
          )}
        </div>
        {isPreview && (
          <div class="preview-banner" aria-live="polite">
            <strong>Local preview only — session-approved records shown here are not published.</strong>
            <div class="preview-counts">
              <span>Existing approved records: <b id="existingApprovedPreviewCount">{approvedRecordCount}</b></span>
              <span>Approved this session: <b id="sessionApprovedPreviewCount">0</b></span>
              <span>Total preview records: <b id="totalPreviewCount">{approvedRecordCount}</b></span>
            </div>
            <p>Session-approved preview records are cleared when this browser session ends. Export the reviewed JSON files to preserve and publish them.</p>
          </div>
        )}
      </div>
    </section>

    <section class="reference-workspace">
      <div class="reference-container reference-grid">
        <section class="lookup-panel" aria-labelledby="searchTitle">
          <div class="section-title">
            <p class="reference-eyebrow">Approved Local Records</p>
            <h2 id="searchTitle">Search product-specific carbohydrate records</h2>
            <p>Only pharmacist-reviewed records with approved status appear in this public lookup.</p>
          </div>

          <div class="record-status">
            <strong id="recordStatusText">{approvedRecordCount} approved product-specific record{approvedRecordCount === 1 ? '' : 's'} currently available.</strong>
            <span id="recordStatusEmpty" hidden={approvedRecordCount !== 0}>No verified product-specific carbohydrate record is currently available.</span>
          </div>

          <label class="search-field">
            Product search
            <input
              id="productSearch"
              type="search"
              autocomplete="off"
              placeholder="Search generic, brand, manufacturer, strength, dosage form, product NDC, or package NDC"
            />
          </label>

          <div class="filter-grid" aria-label="Product filters">
            <label>
              Medication
              <select id="medicationFilter">
                <option value="">All medications</option>
              </select>
            </label>
            <label>
              Dosage form
              <select id="dosageFormFilter">
                <option value="">All dosage forms</option>
                {dosageForms.map((form) => <option value={form}>{form}</option>)}
              </select>
            </label>
            <div class="combobox-field">
              <span id="manufacturerComboboxLabel">Manufacturer</span>
              <div class="combobox" data-combobox>
                <input
                  id="manufacturerCombobox"
                  type="text"
                  role="combobox"
                  aria-autocomplete="list"
                  aria-expanded="false"
                  aria-controls="manufacturerOptions"
                  aria-labelledby="manufacturerComboboxLabel"
                  autocomplete="off"
                  placeholder="All manufacturers"
                />
                <button class="combobox-clear" id="manufacturerClear" type="button" aria-label="Clear manufacturer filter">Clear</button>
                <ul class="combobox-list" id="manufacturerOptions" role="listbox"></ul>
              </div>
            </div>
            <label>
              Quantitative value available
              <select id="quantitativeFilter">
                <option value="">All approved records</option>
                <option value="yes">Amount available</option>
                <option value="no">Not published</option>
              </select>
            </label>
            <label>
              Source type
              <select id="sourceTypeFilter">
                <option value="">All source types</option>
                {sourceTypes.map((sourceType) => <option value={sourceType}>{sourceType}</option>)}
              </select>
            </label>
            <label for="ndcFilter">
              NDC
              <input
                id="ndcFilter"
                type="search"
                inputmode="numeric"
                autocomplete="off"
                aria-describedby="ndcFilterHelp"
              />
              <small id="ndcFilterHelp" class="filter-help">Enter a full or partial product or package NDC. Hyphens are optional.</small>
            </label>
            <label>
              Carbohydrate ingredient
              <select id="carbohydrateIngredientFilter">
                <option value="">All carbohydrate ingredients</option>
              </select>
            </label>
            <label>
              Non-carbohydrate sweetener
              <select id="sweetenerFilter">
                <option value="">All sweetener statuses</option>
                <option value="__none">None identified</option>
              </select>
            </label>
            <label>
              Sort by
              <select id="sortFilter">
                <option value="medication">Medication</option>
                <option value="manufacturer">Manufacturer</option>
                <option value="dosage-form">Dosage form</option>
                <option value="carbohydrate-amount">Carbohydrate amount</option>
                <option value="verification-date">Verification date</option>
              </select>
            </label>
          </div>

          <div class="result-meta" id="resultMeta" aria-live="polite"></div>
          <div class="reference-table-wrap" id="tableWrap"></div>
          <div class="mobile-result-list" id="mobileResultList"></div>
          <p class="methodology-note">
            Carbohydrate-related ingredients are categorized using FDA nutrition-labeling concepts for sugars, sugar alcohols, starches, and related carbohydrate materials. Medication labeling may identify an ingredient without publishing its quantitative amount.
            FDA total-carbohydrate food labeling under 21 CFR 101.9(c)(6) generally uses calculation by difference; an inactive-ingredient list alone does not provide an exact total carbohydrate amount.
          </p>
          <div class="detail-actions">
            <button class="button button-primary" type="button" id="printRecord">Print Filtered Table</button>
          </div>
        </section>

        <aside class="detail-panel" aria-labelledby="methodologyTitle">
          <div class="section-title">
            <p class="reference-eyebrow">Methodology</p>
            <h2 id="methodologyTitle">Product-specific review</h2>
          </div>
          <p>
            This reference displays approved records with documented sources only.
            Each row remains manufacturer-specific and exact-product specific.
          </p>
          <div class="reference-disclaimer">
            Verify the exact manufacturer, strength, formulation, and NDC before use.
            Do not estimate missing values or apply one manufacturer's value to a
            different product. This reference does not determine ketogenic-diet
            compatibility or classify a medication as safe or unsafe.
          </div>
        </aside>
      </div>
    </section>
  </main>
</BaseLayout>

<script define:vars={{ initialApprovedRecords: approvedRecords, dosageFormFilterGroups, isPreview }}>
  const approvedPreviewStorageKey = 'littlemedsApprovedPreviewRecords';
  let approvedRecords = initialApprovedRecords.map((record) => ({ ...record }));
  const state = {
    selectedManufacturer: '',
    highlightedManufacturerIndex: -1,
  };

  const tableWrap = document.querySelector('#tableWrap');
  const mobileResultList = document.querySelector('#mobileResultList');
  const resultMeta = document.querySelector('#resultMeta');
  const printButton = document.querySelector('#printRecord');
  const searchInput = document.querySelector('#productSearch');
  const medicationFilter = document.querySelector('#medicationFilter');
  const dosageFormFilter = document.querySelector('#dosageFormFilter');
  const manufacturerCombobox = document.querySelector('#manufacturerCombobox');
  const manufacturerOptionsList = document.querySelector('#manufacturerOptions');
  const manufacturerClear = document.querySelector('#manufacturerClear');
  const quantitativeFilter = document.querySelector('#quantitativeFilter');
  const sourceTypeFilter = document.querySelector('#sourceTypeFilter');
  const ndcFilter = document.querySelector('#ndcFilter');
  const carbohydrateIngredientFilter = document.querySelector('#carbohydrateIngredientFilter');
  const sweetenerFilter = document.querySelector('#sweetenerFilter');
  const sortFilter = document.querySelector('#sortFilter');
  const recordStatusText = document.querySelector('#recordStatusText');
  const recordStatusEmpty = document.querySelector('#recordStatusEmpty');
  const existingApprovedPreviewCount = document.querySelector('#existingApprovedPreviewCount');
  const sessionApprovedPreviewCount = document.querySelector('#sessionApprovedPreviewCount');
  const totalPreviewCount = document.querySelector('#totalPreviewCount');

  function sessionApprovedPreviewRecords() {
    if (!isPreview) return [];
    try {
      let rawRecords = window.sessionStorage.getItem(approvedPreviewStorageKey);
      if (!rawRecords && window.opener?.sessionStorage) {
        rawRecords = window.opener.sessionStorage.getItem(approvedPreviewStorageKey);
        if (rawRecords) window.sessionStorage.setItem(approvedPreviewStorageKey, rawRecords);
      }
      const parsed = JSON.parse(rawRecords || '[]');
      return Array.isArray(parsed) ? parsed.filter((record) => record?.approvalStatus === 'approved') : [];
    } catch {
      return [];
    }
  }

  function mergeRecordsById(records) {
    const byId = new Map();
    for (const record of records) {
      const id = String(record?.id || '').trim();
      if (!id || byId.has(id)) continue;
      byId.set(id, record);
    }
    return [...byId.values()];
  }

  function applyPreviewRecords() {
    if (!isPreview) return;
    const sessionRecords = sessionApprovedPreviewRecords();
    approvedRecords = mergeRecordsById([...initialApprovedRecords, ...sessionRecords]);
    if (existingApprovedPreviewCount) existingApprovedPreviewCount.textContent = String(initialApprovedRecords.length);
    if (sessionApprovedPreviewCount) sessionApprovedPreviewCount.textContent = String(sessionRecords.length);
    if (totalPreviewCount) totalPreviewCount.textContent = String(approvedRecords.length);
  }

  function updateRecordStatus() {
    recordStatusText.textContent = `${approvedRecords.length} approved product-specific record${approvedRecords.length === 1 ? '' : 's'} currently available.`;
    recordStatusEmpty.hidden = approvedRecords.length !== 0;
  }

  function escapeHtml(value) {
    return String(value ?? '').replace(/[&<>"']/g, (char) => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#39;',
    }[char]));
  }

  function productName(record) {
    const generic = record.genericName || 'Medication';
    return record.brandName ? `${generic} (${record.brandName})` : generic;
  }

  function dosageAndStrength(record) {
    return [
      record.normalizedDosageForm || record.dosageForm || 'Dosage form not parsed',
      record.strength,
    ].filter(Boolean).join(' - ');
  }

  function sourceName(record) {
    return record.sourceName || record.sourceType || 'DailyMed product label';
  }

  function amountSourceName(record) {
    return record.fieldSourceProvenance?.carbohydrateDisplayValue?.sourceName || '';
  }

  function recordSourceTypes(record) {
    return [...new Set([
      sourceName(record),
      amountSourceName(record),
    ].filter(Boolean))];
  }

  function verificationDate(record) {
    return record.verifiedDate || record.reviewedDate || '';
  }

  function reviewerName(record) {
    return record.reviewedBy || record.verifiedBy || '';
  }

  function isExcludedCelluloseDerivative(value) {
    return [
      'microcrystalline cellulose',
      'carboxymethylcellulose',
      'hydroxyethyl cellulose',
      'methylcellulose',
    ].includes(normalizedOrganizationKey(value));
  }

  function carbohydrateContributingIngredients(record) {
    return ingredientArray(record).filter((ingredient) => !isExcludedCelluloseDerivative(ingredient.normalizedName || ingredient.sourceTerm));
  }

  function sortedUnique(values) {
    return [...new Set(values.map((value) => String(value || '').trim()).filter(Boolean))]
      .sort((a, b) => a.localeCompare(b, undefined, { sensitivity: 'base' }));
  }

  function setSelectOptions(select, options, firstLabel, firstValue = '') {
    const currentValue = select.value;
    select.innerHTML = [
      `<option value="${escapeHtml(firstValue)}">${escapeHtml(firstLabel)}</option>`,
      ...options.map((option) => `<option value="${escapeHtml(option)}">${escapeHtml(option)}</option>`),
    ].join('');
    if ([...select.options].some((option) => option.value === currentValue)) {
      select.value = currentValue;
    }
  }

  function renderFilterOptions() {
    setSelectOptions(
      medicationFilter,
      sortedUnique(approvedRecords.map((record) => record.genericName)),
      'All medications',
    );
    setSelectOptions(
      sourceTypeFilter,
      sortedUnique(approvedRecords.flatMap(recordSourceTypes)),
      'All source types',
    );
    setSelectOptions(
      carbohydrateIngredientFilter,
      sortedUnique(approvedRecords.flatMap((record) => carbohydrateContributingIngredients(record).map((ingredient) => ingredient.normalizedName || ingredient.sourceTerm))),
      'All carbohydrate ingredients',
    );

    const currentSweetenerValue = sweetenerFilter.value;
    const sweetenerOptions = sortedUnique(approvedRecords.flatMap((record) => sweetenerArray(record).map((sweetener) => sweetener.normalizedName || sweetener.sourceTerm)));
    sweetenerFilter.innerHTML = [
      '<option value="">All sweetener statuses</option>',
      '<option value="__none">None identified</option>',
      ...sweetenerOptions.map((sweetener) => `<option value="${escapeHtml(sweetener)}">${escapeHtml(sweetener)}</option>`),
    ].join('');
    if ([...sweetenerFilter.options].some((option) => option.value === currentSweetenerValue)) {
      sweetenerFilter.value = currentSweetenerValue;
    }
  }

  function displayQuantityStatus(status) {
    const labels = {
      'quantity-unknown': 'Not published',
      'quantity-published': 'Amount available',
      'quantitative-value-found': 'Amount available',
      'manufacturer-confirmation-required': 'Manufacturer confirmation needed',
      'manual-review-required': 'Additional review needed',
      'no-carbohydrate-ingredient-identified': 'No carbohydrate ingredient identified in reviewed source',
      'carbohydrate-ingredient-found-quantity-unknown': 'Not published',
      'ambiguous-source-text': 'Additional review needed',
    };
    return labels[status] || status || 'Additional review needed';
  }

  function normalizedOrganizationKey(value) {
    return String(value || '').replace(/\s+/g, ' ').trim().toLowerCase();
  }

  function normalizeText(value) {
    return String(value || '').replace(/\s+/g, ' ').trim().toLowerCase();
  }

  function dosageFormFilterGroup(record) {
    const form = normalizeText(record.normalizedDosageForm || record.dosageForm);
    for (const [group, values] of Object.entries(dosageFormFilterGroups)) {
      if (values.map(normalizeText).includes(form)) return group;
    }
    return 'Other';
  }

  function matchesDosageFormFilter(record) {
    return !dosageFormFilter.value || dosageFormFilterGroup(record) === dosageFormFilter.value;
  }

  function normalizedManufacturerSearch(value) {
    return String(value || '').replace(/\s+/g, ' ').trim().toLowerCase();
  }

  function displayedManufacturer(record) {
    return String(record.packagerName || '').trim()
      || String(record.labelerName || '').trim()
      || String(record.manufacturerName || '').trim()
      || String(record.distributorName || '').trim()
      || String(record.manufacturer || '').trim()
      || 'Organization not parsed';
  }

  function normalizeNdc(value) {
    return String(value || '').replace(/\D+/g, '');
  }

  function arrayValues(value) {
    if (Array.isArray(value)) return value;
    if (value === undefined || value === null || value === '') return [];
    return [value];
  }

  function ndcValues(record) {
    return [
      ...arrayValues(record.productNdc),
      ...arrayValues(record.packageNdc),
      ...arrayValues(record.ndc),
      ...arrayValues(record.packageNdcs),
      ...arrayValues(record.packageNdcList),
      ...arrayValues(record.packageNdcValues),
      ...arrayValues(record.ndcs),
      ...arrayValues(record.packaging).flatMap((item) => [
        item?.packageNdc,
        item?.package_ndc,
        item?.ndc,
      ]),
    ].filter(Boolean);
  }

  function matchesNdcFilter(record) {
    const query = normalizeNdc(ndcFilter.value);
    if (!query) return true;
    return ndcValues(record).some((value) => normalizeNdc(value).includes(query));
  }

  function displayPackageNdc(record) {
    const values = [
      ...arrayValues(record.packageNdc),
      ...arrayValues(record.packageNdcs),
      ...arrayValues(record.packageNdcList),
      ...arrayValues(record.packageNdcValues),
      ...arrayValues(record.packaging).flatMap((item) => [
        item?.packageNdc,
        item?.package_ndc,
        item?.ndc,
      ]),
    ].filter(Boolean);
    const unique = [...new Set(values.map((value) => String(value).trim()).filter(Boolean))];
    return unique.length ? unique.join(', ') : '';
  }

  function packageNdcList(record) {
    return [
      ...arrayValues(record.packageNdc),
      ...arrayValues(record.packageNdcs),
      ...arrayValues(record.packageNdcList),
      ...arrayValues(record.packageNdcValues),
      ...arrayValues(record.packaging).flatMap((item) => [
        item?.packageNdc,
        item?.package_ndc,
        item?.ndc,
      ]),
    ].filter(Boolean).map((value) => String(value).trim()).filter(Boolean);
  }

  function validSourceUrl(record) {
    try {
      const url = new URL(record.sourceUrl || '');
      return ['http:', 'https:'].includes(url.protocol) ? url.href : '';
    } catch {
      return '';
    }
  }

  function manufacturerOptionEntries() {
    const entries = new Map();
    for (const record of approvedRecords) {
      if (record.approvalStatus !== 'approved') continue;
      if (medicationFilter.value && record.genericName !== medicationFilter.value) continue;
      if (!matchesDosageFormFilter(record)) continue;
      const name = displayedManufacturer(record);
      const key = normalizedOrganizationKey(name);
      const existing = entries.get(key);
      if (existing) existing.count += 1;
      else entries.set(key, { name, count: 1 });
    }
    return [...entries.values()].sort((a, b) => a.name.localeCompare(b.name, undefined, { sensitivity: 'base' }));
  }

  function renderManufacturerOptions() {
    const selectedKey = normalizedOrganizationKey(state.selectedManufacturer);
    const options = manufacturerOptionEntries();
    const selected = options.find((option) => normalizedOrganizationKey(option.name) === selectedKey);
    state.selectedManufacturer = selected?.name || '';
    manufacturerCombobox.value = state.selectedManufacturer;
    renderManufacturerListbox(false);
  }

  function manufacturerListOptions() {
    const query = normalizedManufacturerSearch(manufacturerCombobox.value);
    const allOption = { name: '', label: 'All manufacturers' };
    const matches = manufacturerOptionEntries().filter((entry) => (
      !query || normalizedManufacturerSearch(entry.name).includes(query)
    ));
    if (query && !matches.length) return [];
    return [allOption, ...matches.map((entry) => ({
      name: entry.name,
      label: `${entry.name} (${entry.count})`,
    }))];
  }

  function renderManufacturerListbox(open = true) {
    const options = manufacturerListOptions();
    const hasMatches = options.length > 0;
    manufacturerCombobox.setAttribute('aria-expanded', open ? 'true' : 'false');
    manufacturerOptionsList.hidden = !open;
    if (!open) {
      manufacturerOptionsList.innerHTML = '';
      state.highlightedManufacturerIndex = -1;
      manufacturerCombobox.removeAttribute('aria-activedescendant');
      return;
    }
    if (!hasMatches) {
      manufacturerOptionsList.innerHTML = '<li class="combobox-empty">No matching manufacturer</li>';
      state.highlightedManufacturerIndex = -1;
      manufacturerCombobox.removeAttribute('aria-activedescendant');
      return;
    }
    state.highlightedManufacturerIndex = Math.max(0, Math.min(state.highlightedManufacturerIndex, options.length - 1));
    manufacturerOptionsList.innerHTML = options.map((option, index) => `
      <li
        id="manufacturerOption-${index}"
        role="option"
        data-manufacturer-name="${escapeHtml(option.name)}"
        aria-selected="${index === state.highlightedManufacturerIndex ? 'true' : 'false'}"
      >
        ${escapeHtml(option.label)}
      </li>
    `).join('');
    manufacturerCombobox.setAttribute('aria-activedescendant', `manufacturerOption-${state.highlightedManufacturerIndex}`);
  }

  function selectManufacturer(name) {
    state.selectedManufacturer = name;
    manufacturerCombobox.value = name;
    renderManufacturerListbox(false);
    renderResults();
  }

  function hasPublishedQuantity(record) {
    return record.extractionStatus === 'quantitative-value-found'
      && !['', 'not published', 'unknown'].includes(String(record.carbohydrateDisplayValue || '').trim().toLowerCase());
  }

  function quantitativeSortValue(record) {
    const explicit = record.carbohydrateAmount ?? record.publishedAmount ?? record.normalizedAmountMg;
    if (Number.isFinite(explicit)) return Number(explicit);
    const quantified = ingredientArray(record).find((ingredient) => Number.isFinite(ingredient.normalizedAmountMg ?? ingredient.amount));
    return Number.isFinite(quantified?.normalizedAmountMg ?? quantified?.amount)
      ? Number(quantified.normalizedAmountMg ?? quantified.amount)
      : Number.POSITIVE_INFINITY;
  }

  function carbohydrateDisplay(record) {
    if (record.carbohydrateDisplayValue) return escapeHtml(record.carbohydrateDisplayValue);
    const amount = record.carbohydrateAmount ?? record.publishedAmount ?? record.normalizedAmountMg;
    const unit = record.carbohydrateUnit || record.publishedUnit || '';
    const perUnit = record.carbohydratePerUnit || record.publishedBasis || record.normalizedBasis || '';
    if (amount !== null && amount !== undefined && Number.isFinite(Number(amount))) {
      return escapeHtml(`${amount}${unit ? ` ${unit}` : ''}${perUnit ? `/${perUnit}` : ''}`);
    }
    const quantified = ingredientArray(record).filter((ingredient) => ingredient.normalizedAmountMg !== null || ingredient.amount !== null);
    if (quantified.length) {
      return quantified.map((ingredient) => {
        const value = ingredient.carbohydrateDisplayValue || [
          ingredient.amount ?? ingredient.normalizedAmountMg,
          ingredient.unit || ingredient.amountUnit,
          ingredient.concentration || ingredient.amountBasis || ingredient.normalizedBasis,
        ].filter(Boolean).join(' ');
        return escapeHtml(value);
      }).join('<br />');
    }
    return 'Not published';
  }

  function ingredientTags(items, emptyText = 'None identified') {
    const names = [...new Set(items.map((item) => item.normalizedName || item.sourceTerm).filter(Boolean))];
    if (!names.length) return `<span class="muted-text">${escapeHtml(emptyText)}</span>`;
    return `<span class="tag-list">${names.map((name) => `<span class="ingredient-tag">${escapeHtml(name)}</span>`).join('')}</span>`;
  }

  function sourceCell(record, includeUrl = false) {
    const href = validSourceUrl(record);
    const source = sourceName(record);
    const amountSource = record.fieldSourceProvenance?.carbohydrateDisplayValue;
    const additionalReferences = String(record.additionalReferences || '').trim();
    const dateParts = [
      record.sourceDate ? `Source date: ${record.sourceDate}` : '',
      verificationDate(record) ? `Verified: ${verificationDate(record)}` : '',
      reviewerName(record) ? `Reviewer: ${reviewerName(record)}` : '',
    ].filter(Boolean);
    return `
      <div class="source-cell">
        <strong>Primary source:</strong>
        ${href
          ? `<a href="${escapeHtml(href)}" target="_blank" rel="noopener noreferrer">${escapeHtml(source)}</a>`
          : `<span>${escapeHtml(source || 'Source documentation on file')}</span>`}
        ${includeUrl && href ? `<small>${escapeHtml(href)}</small>` : ''}
        ${dateParts.length ? `<small>${escapeHtml(dateParts.join(' | '))}</small>` : ''}
        ${amountSource ? `
          <strong>Carbohydrate amount source:</strong>
          <span>${escapeHtml(amountSource.sourceName || amountSource.sourceReference || 'Supplemental carbohydrate reference')}</span>
        ` : ''}
        ${additionalReferences ? `
          <strong>Additional references:</strong>
          <span class="additional-references">${escapeHtml(additionalReferences).replace(/\n/g, '<br />')}</span>
        ` : ''}
      </div>
    `;
  }

  function printFilterSummary() {
    const values = [
      ['Search', searchInput.value.trim() || 'All'],
      ['Medication', medicationFilter.value || 'All'],
      ['Manufacturer', state.selectedManufacturer || 'All'],
      ['Dosage form', dosageFormFilter.value || 'All'],
      ['NDC', ndcFilter.value.trim() || 'All'],
      ['Quantitative value', quantitativeFilter.value || 'All'],
      ['Carbohydrate ingredient', carbohydrateIngredientFilter.value || 'All'],
      ['Non-carbohydrate sweetener', sweetenerFilter.value === '__none' ? 'None identified' : sweetenerFilter.value || 'All'],
      ['Sort', sortFilter.options[sortFilter.selectedIndex]?.textContent || 'Medication'],
    ];
    return values.map(([label, value]) => `${label}: ${value}`).join(' | ');
  }

  function matchesRecord(record) {
    if (record.approvalStatus !== 'approved') return false;
    if (medicationFilter.value && record.genericName !== medicationFilter.value) return false;
    const query = searchInput.value.trim().toLowerCase();
    const searchable = [
      record.genericName,
      record.brandName,
      displayedManufacturer(record),
      record.labelerName,
      record.packagerName,
      record.manufacturerName,
      record.distributorName,
      record.strength,
      record.dosageForm,
      record.originalDosageForm,
      record.normalizedDosageForm,
      record.route,
      record.productNdc,
      record.packageNdc,
      record.packageDescription,
      ...ingredientArray(record).flatMap((ingredient) => [
        ingredient.normalizedName,
        ingredient.sourceTerm,
      ]),
      ...sweetenerArray(record).flatMap((sweetener) => [
        sweetener.normalizedName,
        sweetener.sourceTerm,
      ]),
    ].join(' ').toLowerCase();

    if (query && !searchable.includes(query)) return false;
    if (!matchesDosageFormFilter(record)) return false;
    if (state.selectedManufacturer && normalizedOrganizationKey(displayedManufacturer(record)) !== normalizedOrganizationKey(state.selectedManufacturer)) return false;
    if (sourceTypeFilter.value && !recordSourceTypes(record).includes(sourceTypeFilter.value)) return false;
    if (quantitativeFilter.value === 'yes' && !hasPublishedQuantity(record)) return false;
    if (quantitativeFilter.value === 'no' && hasPublishedQuantity(record)) return false;
    if (carbohydrateIngredientFilter.value && !carbohydrateContributingIngredients(record).some((ingredient) => normalizedOrganizationKey(ingredient.normalizedName || ingredient.sourceTerm) === normalizedOrganizationKey(carbohydrateIngredientFilter.value))) return false;
    if (sweetenerFilter.value === '__none' && sweetenerArray(record).length) return false;
    if (sweetenerFilter.value && sweetenerFilter.value !== '__none' && !sweetenerArray(record).some((sweetener) => normalizedOrganizationKey(sweetener.normalizedName || sweetener.sourceTerm) === normalizedOrganizationKey(sweetenerFilter.value))) return false;
    if (!matchesNdcFilter(record)) return false;
    if (!validSourceUrl(record) && !sourceName(record)) return false;
    return true;
  }

  function filteredRecords() {
    return approvedRecords.filter(matchesRecord).sort((a, b) => {
      const sort = sortFilter.value;
      if (sort === 'manufacturer') return displayedManufacturer(a).localeCompare(displayedManufacturer(b), undefined, { sensitivity: 'base' });
      if (sort === 'dosage-form') return dosageAndStrength(a).localeCompare(dosageAndStrength(b), undefined, { sensitivity: 'base' });
      if (sort === 'carbohydrate-amount') return quantitativeSortValue(a) - quantitativeSortValue(b);
      if (sort === 'verification-date') return String(verificationDate(b)).localeCompare(String(verificationDate(a)));
      return productName(a).localeCompare(productName(b), undefined, { sensitivity: 'base' });
    });
  }

  function renderResults() {
    const matches = filteredRecords();
    resultMeta.textContent = `${matches.length} approved product-specific record${matches.length === 1 ? '' : 's'} found.`;

    if (!matches.length) {
      tableWrap.innerHTML = `
        <div class="empty-state">
          <strong>${ndcFilter.value.trim() ? 'No records match the entered NDC and selected filters.' : 'No verified product-specific carbohydrate record is currently available.'}</strong>
          <span>Verify the exact manufacturer, formulation, and NDC using product labeling, manufacturer medical information, or an approved ketogenic medication reference.</span>
        </div>
      `;
      mobileResultList.innerHTML = '';
      return;
    }

    const tableRows = matches.map((record) => {
      const packageNdcs = packageNdcList(record);
      const sweeteners = record.nonCarbohydrateSweeteners || sweetenerArray(record);
      return `
        <tr>
          <td class="product-cell"><strong>${escapeHtml(productName(record))}</strong></td>
          <td>${escapeHtml(displayedManufacturer(record))}</td>
          <td>${escapeHtml(dosageAndStrength(record))}</td>
          <td>
            <span>${escapeHtml(record.productNdc || 'not listed')}</span>
            ${packageNdcs.length ? `
              <details>
                <summary>Package NDCs</summary>
                <span>${escapeHtml(packageNdcs.join(', '))}</span>
              </details>
            ` : ''}
          </td>
          <td class="amount-cell">${carbohydrateDisplay(record)}</td>
          <td>${ingredientTags(carbohydrateContributingIngredients(record), 'None identified')}</td>
          <td>${ingredientTags(sweeteners, 'None identified')}</td>
          <td>${sourceCell(record, false)}</td>
        </tr>
      `;
    }).join('');

    tableWrap.innerHTML = `
      <div class="print-summary">
        <strong>Pediatric Medication Carbohydrate Reference</strong>
        <span>Printed: ${escapeHtml(new Date().toLocaleString())}</span>
        <span>${escapeHtml(printFilterSummary())}</span>
      </div>
      <table class="reference-table">
        <thead>
          <tr>
            <th>Medication product</th>
            <th>Manufacturer</th>
            <th>Dosage form and strength</th>
            <th>NDC</th>
            <th>Carbohydrate amount</th>
            <th>Carbohydrate-contributing ingredients</th>
            <th>Non-carbohydrate sweeteners</th>
            <th>Source</th>
          </tr>
        </thead>
        <tbody>${tableRows}</tbody>
      </table>
    `;

    mobileResultList.innerHTML = matches.map((record) => {
      const packageNdcs = packageNdcList(record);
      const sweeteners = record.nonCarbohydrateSweeteners || sweetenerArray(record);
      return `
        <article class="mobile-result-card">
          <header>
            <strong>${escapeHtml(productName(record))}</strong>
            <span>${escapeHtml(displayedManufacturer(record))}</span>
          </header>
          <dl>
            <div><dt>Dosage form and strength</dt><dd>${escapeHtml(dosageAndStrength(record))}</dd></div>
            <div><dt>NDC</dt><dd>${escapeHtml(record.productNdc || 'not listed')}${packageNdcs.length ? `<br /><small>Package NDCs: ${escapeHtml(packageNdcs.join(', '))}</small>` : ''}</dd></div>
            <div><dt>Carbohydrate amount</dt><dd>${carbohydrateDisplay(record)}</dd></div>
            <div><dt>Carbohydrate-contributing ingredients</dt><dd>${ingredientTags(carbohydrateContributingIngredients(record), 'None identified')}</dd></div>
            <div><dt>Non-carbohydrate sweeteners</dt><dd>${ingredientTags(sweeteners, 'None identified')}</dd></div>
            <div><dt>Source</dt><dd>${sourceCell(record, false)}</dd></div>
          </dl>
        </article>
      `;
    }).join('');
  }

  function ingredientList(record) {
    const ingredients = ingredientArray(record);
    if (!ingredients.length) return '<p class="empty-message">No carbohydrate-related ingredient was identified in the reviewed source.</p>';
    return `
      <div class="ingredient-summary">
        <strong>Carbohydrate-contributing ingredients: ${ingredients.length}</strong>
        <div class="ingredient-card-list">
          ${ingredients.map((ingredient) => `
            <article class="ingredient-card">
              <h4>${escapeHtml(ingredient.normalizedName || 'Carbohydrate ingredient')}</h4>
              <p><b>Carbohydrate source:</b> ${escapeHtml(ingredient.sourceTerm || 'Not stated')}</p>
              <details>
                <summary>Source excerpt</summary>
                <p>${escapeHtml(ingredient.sourceExcerpt || 'Source excerpt not available.')}</p>
              </details>
            </article>
          `).join('')}
        </div>
      </div>
    `;
  }

  function ingredientArray(record) {
    if (Array.isArray(record.carbohydrateIngredients)) return record.carbohydrateIngredients;
    if (record.carbohydrateIngredient) {
      return [{
        normalizedName: record.carbohydrateIngredient,
        sourceTerm: record.carbohydrateIngredient,
        sourceExcerpt: record.sourceExcerpt || '',
        amount: record.normalizedAmountMg ?? record.publishedAmount ?? null,
        amountUnit: record.publishedUnit || '',
        amountBasis: record.publishedBasis || '',
        normalizedAmountMg: record.normalizedAmountMg ?? null,
        normalizedBasis: record.normalizedBasis || '',
        quantityStatus: record.publishedAmount === null ? 'quantity-unknown' : 'quantity-published',
      }];
    }
    return [];
  }

  function sweetenerArray(record) {
    return Array.isArray(record.nonNutritiveSweeteners) ? record.nonNutritiveSweeteners : [];
  }

  function sweetenerList(record) {
    const sweeteners = sweetenerArray(record);
    if (!sweeteners.length) return '';
    return `
      <div class="ingredient-summary sweetener-summary">
        <strong>Non-carbohydrate sweeteners: ${sweeteners.length}</strong>
        <p class="helper-text">Non-carbohydrate sweeteners are displayed separately and are not included in the medication carbohydrate amount.</p>
        <div class="ingredient-card-list">
          ${sweeteners.map((sweetener) => `
            <article class="ingredient-card">
              <h4>${escapeHtml(sweetener.normalizedName || 'Non-nutritive sweetener')}</h4>
              <p><b>Source:</b> ${escapeHtml(sweetener.sourceTerm || 'Not stated')}</p>
              <details>
                <summary>Source excerpt</summary>
                <p>${escapeHtml(sweetener.sourceExcerpt || 'Source excerpt not available.')}</p>
              </details>
            </article>
          `).join('')}
        </div>
      </div>
    `;
  }

  function sourceDetails(record) {
    return [
      ['Generic name', record.genericName],
      ['Brand name', record.brandName || 'Not stated'],
      ['Manufacturer or labeler', displayedManufacturer(record)],
      ['Strength', record.strength || 'Not parsed'],
      ['Dosage form', record.normalizedDosageForm || record.dosageForm || 'Not parsed'],
      ['Product NDC', record.productNdc],
      ['Package NDC', displayPackageNdc(record) || 'Not listed'],
      ['Package description', record.packageDescription || 'Review source label'],
      ['DailyMed set ID', record.sourceSetId],
      ['Source date', record.sourceDate],
      ['Additional references', record.additionalReferences],
      ['Review date', record.reviewedDate || 'Not verified'],
      ['Notes', record.notes],
    ];
  }

  manufacturerCombobox.addEventListener('input', () => {
    state.selectedManufacturer = '';
    state.highlightedManufacturerIndex = 0;
    renderManufacturerListbox(true);
    renderResults();
  });

  manufacturerCombobox.addEventListener('focus', () => {
    state.highlightedManufacturerIndex = 0;
    renderManufacturerListbox(true);
  });

  manufacturerCombobox.addEventListener('keydown', (event) => {
    const options = manufacturerListOptions();
    if (!options.length && ['ArrowDown', 'ArrowUp', 'Enter'].includes(event.key)) {
      event.preventDefault();
      renderManufacturerListbox(true);
      return;
    }
    if (event.key === 'ArrowDown') {
      event.preventDefault();
      state.highlightedManufacturerIndex = Math.min(options.length - 1, state.highlightedManufacturerIndex + 1);
      renderManufacturerListbox(true);
    } else if (event.key === 'ArrowUp') {
      event.preventDefault();
      state.highlightedManufacturerIndex = Math.max(0, state.highlightedManufacturerIndex - 1);
      renderManufacturerListbox(true);
    } else if (event.key === 'Enter') {
      event.preventDefault();
      const option = options[state.highlightedManufacturerIndex];
      if (option) selectManufacturer(option.name);
    } else if (event.key === 'Escape') {
      manufacturerCombobox.value = state.selectedManufacturer;
      renderManufacturerListbox(false);
    }
  });

  manufacturerCombobox.addEventListener('blur', () => {
    window.setTimeout(() => {
      if (document.activeElement?.closest('[data-combobox]')) return;
      manufacturerCombobox.value = state.selectedManufacturer;
      renderManufacturerListbox(false);
    }, 100);
  });

  manufacturerOptionsList.addEventListener('mousedown', (event) => {
    const option = event.target.closest('[role="option"]');
    if (!option) return;
    event.preventDefault();
    selectManufacturer(option.dataset.manufacturerName || '');
  });

  manufacturerClear.addEventListener('click', () => {
    selectManufacturer('');
    manufacturerCombobox.focus();
  });

  document.addEventListener('click', (event) => {
    if (!event.target.closest('[data-combobox]')) {
      manufacturerCombobox.value = state.selectedManufacturer;
      renderManufacturerListbox(false);
    }
  });

  [searchInput, medicationFilter, dosageFormFilter, quantitativeFilter, sourceTypeFilter, ndcFilter, carbohydrateIngredientFilter, sweetenerFilter, sortFilter].forEach((input) => {
    input.addEventListener('input', renderResults);
    input.addEventListener('change', () => {
      if (input === medicationFilter || input === dosageFormFilter) renderManufacturerOptions();
      renderResults();
    });
  });

  printButton.addEventListener('click', () => {
    window.print();
  });

  const printOpenedDetails = new Set();
  window.addEventListener('beforeprint', () => {
    document.querySelectorAll('.detail-panel details:not([open])').forEach((details) => {
      printOpenedDetails.add(details);
      details.setAttribute('open', '');
    });
  });

  window.addEventListener('afterprint', () => {
    printOpenedDetails.forEach((details) => details.removeAttribute('open'));
    printOpenedDetails.clear();
  });

  applyPreviewRecords();
  updateRecordStatus();
  renderFilterOptions();
  renderManufacturerOptions();
  renderResults();
</script>

