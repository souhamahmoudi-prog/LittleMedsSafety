            <section ID="id_link_09d2fe2f-73b7-924c-e063-6394a90a9c44">
               <id root="09d2fe2f-73b6-924c-e063-6394a90a9c44"/>
               <code code="55106-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ACTIVE INGREDIENT SECTION"/>
