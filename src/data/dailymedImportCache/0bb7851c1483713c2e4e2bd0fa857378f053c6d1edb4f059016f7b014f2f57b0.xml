               <title>
                  <content styleCode="italics">
                     <content styleCode="bold">Other information</content>
                  </content>
               </title>
               <text>
                  <list listType="unordered">
                     <item>
                        <content styleCode="bold">each 20 mL contains</content>
                     </item>
                     <item>sodium 20 mg</item>
                     <item>Store between 20-25°C (68-77°F)</item>
                     <item>do not refrigerate</item>
                     <item>keep carton for complete Drug facts</item>
                  </list>
               </text>
               <effectiveTime value="20230918"/>
            </section>
