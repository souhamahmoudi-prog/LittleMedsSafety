               <id root="4e7c4e6c-bdd0-2d56-e063-6394a90a945a"/>
               <code code="34068-7" codeSystem="2.16.840.1.113883.6.1" displayName="DOSAGE &amp; ADMINISTRATION SECTION"/>
               <title>Directions</title>
               <text>
                  <paragraph>Take only one dose (1 Pouch) per day (24 hours)</paragraph>
                  <paragraph/>
                  <paragraph>Adults and children 12 years and over:1 Pouch at bedtime if needed, or as directed by a doctor</paragraph>
               </text>
               <effectiveTime value="20260501"/>
            </section>
