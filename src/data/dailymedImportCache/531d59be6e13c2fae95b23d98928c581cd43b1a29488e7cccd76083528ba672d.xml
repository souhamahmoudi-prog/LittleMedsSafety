               <title>Principal Display Panel</title>
               <text>
                  <paragraph>Compare to active ingredient in ZzzQuil®*</paragraph>
                  <paragraph>
                     <content styleCode="bold">Nighttime Sleep Aid<br/>
                     </content>
                  </paragraph>
                  <paragraph>50 mg Diphenhydramine HCI per 30 mL</paragraph>
                  <list listType="unordered" styleCode="Disk">
                     <item>Non habit-forming</item>
                     <item>Not for treating cold or flu</item>
                     <item>Alcohol 10%</item>
                  </list>
                  <paragraph>Berry Flavor</paragraph>
                  <paragraph>FL OZ (mL)</paragraph>
                  <paragraph>*This product is not manufactured or distributed by The Procter &amp; Gamble Company. Vicks® ZzzQuil® is a registered trademark of The Procter &amp; Gamble Company.</paragraph>
                  <paragraph>
                     <content styleCode="bold">Failure to follow these warnings could result in serious consequences</content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">TAMPER EVIDENT: DO NOT USE IF PRINTED SAFETY SEAL AROUND DOSAGE CUP OR UNDER CAP IS BROKEN OR MISSING.</content>
                  </paragraph>
                  <paragraph>Distributed by Target Corporation</paragraph>
                  <paragraph>Minneapolis, MN 55403</paragraph>
               </text>
               <effectiveTime value="20260721"/>
            </section>
