               <title>
                  <content styleCode="italics">
                     <content styleCode="bold">Other Information</content>
                  </content>
               </title>
               <text>
                  <list listType="unordered">
                     <item>
                        <content styleCode="bold">each piece contains:</content> sodium 6 mg. 
   <content styleCode="bold">low sodium</content>
                     </item>
                     <item>store in a cool dry place between 20-25°C (68-77°F).</item>
                     <item>
                        <content styleCode="bold">Child Resistant Container</content>; do not use if printed seal under cap is broken or missing.
  </item>
                  </list>
               </text>
               <effectiveTime value="20230701"/>
            </section>
