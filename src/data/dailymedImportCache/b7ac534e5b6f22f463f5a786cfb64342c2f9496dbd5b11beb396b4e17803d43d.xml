               <title>Inactive Ingredients</title>
               <text>
                  <paragraph>Butylated hydroxytolene, gelatin, glycerin, mannitol, pharmaceutical ink, polyethylene glycol 400, purified water, sodium hydroxide, Sorbitan, Sorbitol</paragraph>
               </text>
               <effectiveTime value="20260220"/>
            </section>
