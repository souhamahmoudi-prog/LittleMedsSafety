            <section ID="ID_8c5fa263-602f-4536-b69c-9eca86dc987e">
               <id root="438018c4-8731-1a2d-e063-6294a90a4c46"/>
               <code code="55106-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ACTIVE INGREDIENT SECTION"/>
               <title>
                  <content styleCode="italics">Active ingredients (in each 30 mL)</content>
               </title>
               <text>
                  <paragraph>Acetaminophen 650 mg</paragraph>
                  <paragraph>Dextromethorphan HBr 20 mg</paragraph>
                  <paragraph>Guaifenesin 400 mg</paragraph>
               </text>
               <effectiveTime value="20231220"/>
            </section>
