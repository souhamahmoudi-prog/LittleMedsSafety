               <code code="60561-8" codeSystem="2.16.840.1.113883.6.1" displayName="OTHER SAFETY INFORMATION"/>
               <title>Attention:</title>
               <text>
                  <paragraph>use only enclosed dosing cup specfically designed for use with this product</paragraph>
               </text>
               <effectiveTime value="20170415"/>
            </section>
         </component>
