         <component>
            <section ID="i4i_OTC_Purpose_id_d1b56e72-6d83-4517-82a2-b7bb9261f87a">
               <id root="bd74830f-98f8-456d-9742-ce42fcfaf758"/>
               <code code="55105-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - PURPOSE SECTION"/>
               <title>Purpose</title>
               <text>
                  <paragraph>Antihistamine</paragraph>
               </text>
