            <section ID="LINK_3ffa7ae0-dcc4-4db2-9dad-7c6ac0bd35f0">
               <id root="6878db17-00f3-4df4-a7a9-d81d9b6a36eb"/>
               <code code="51945-4" codeSystem="2.16.840.1.113883.6.1" displayName="PACKAGE LABEL.PRINCIPAL DISPLAY PANEL"/>
               <title>
                  <content styleCode="italics">Principal Display Panel</content>
               </title>
               <text>
                  <paragraph>
                     <content styleCode="bold">Compare to Children's Benadryl® Allergy Chewable Tablets </content>active ingredient <content styleCode="bold">*</content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">NDC  46122-798-51</content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">GOOD NEIGHBOR PHARMACY</content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">CHILDREN’S </content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">Allergy Relief</content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">Chewables</content>
                     <br/>Diphenhydramine HCl, 12.5 (Antihistamine)</paragraph>
                  <paragraph>For Relief of:</paragraph>
                  <list listType="unordered">
                     <item>
                        <caption>•</caption>Sneezing</item>
                     <item>
                        <caption>•</caption>Runny Nose</item>
                     <item>
                        <caption>•</caption>Itchy throat or nose</item>
                     <item>
                        <caption>•</caption>Itchy, watery eyes</item>
                  </list>
                  <paragraph>4-6 Hours/Dose</paragraph>
                  <paragraph>
                     <content styleCode="bold">Grape Flavor</content>
