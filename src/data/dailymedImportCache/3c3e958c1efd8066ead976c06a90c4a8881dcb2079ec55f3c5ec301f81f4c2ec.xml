               <title>
                  <content styleCode="bold">
                     <content styleCode="italics">Active ingredient (in each 5 mL)</content>
                  </content>
               </title>
               <text>
                  <paragraph>Ibuprofen, USP 100 mg (NSAID)**<br/>**nonsteroidal anti-inflammatory drug</paragraph>
               </text>
               <effectiveTime value="20260506"/>
            </section>
