               <title>Inactive ingredients</title>
               <text>
                  <paragraph>anhydrous citric acid, flavors, non crystallizing sorbitol solution, propylene glycol, purified water, sodium benzoate and sucralose.</paragraph>
               </text>
               <effectiveTime value="20190315"/>
            </section>
