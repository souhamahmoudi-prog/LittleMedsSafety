               <code code="55106-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ACTIVE INGREDIENT SECTION"/>
               <title>
                  <content styleCode="bold">Active ingredient (in each capsule)</content>
               </title>
               <text>
                  <paragraph>Diphenhydramine HCl 25mg</paragraph>
               </text>
               <effectiveTime value="20230613"/>
               <component>
                  <section>
                     <id root="3ef18db5-d31a-ea10-e063-6294a90a5ca9"/>
                     <code code="55105-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - PURPOSE SECTION"/>
                     <title>
                        <content styleCode="bold">Purpose</content>
                     </title>
                     <text>
                        <paragraph>Antihistamine</paragraph>
                     </text>
                     <effectiveTime value="20230613"/>
                  </section>
               </component>
            </section>
