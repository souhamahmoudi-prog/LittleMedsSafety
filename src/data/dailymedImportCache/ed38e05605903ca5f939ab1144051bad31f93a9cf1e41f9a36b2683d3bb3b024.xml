            <section ID="ID_07FCA6CE-0C55-4FA5-BBD2-92FDD491252D">
               <id root="874239e6-6230-46c7-9d76-addd731e6c7b"/>
               <code code="51945-4" codeSystem="2.16.840.1.113883.6.1" displayName="PACKAGE LABEL.PRINCIPAL DISPLAY PANEL"/>
               <title>Package/Label Principal Display Panel </title>
               <text>
                  <paragraph>NEW FORMULA</paragraph>
                  <paragraph>equate™</paragraph>
                  <paragraph>Compare to Vicks® DayQuil® VapoCOOL® active ingredients</paragraph>
                  <paragraph>DAYTIME</paragraph>
                  <paragraph>NON-DROWSY</paragraph>
                  <paragraph>VAPOR ICE<sup>®</sup>
                  </paragraph>
                  <paragraph>Cold &amp; Flu</paragraph>
                  <paragraph>Acetaminophen – Pain Reliever/Fever Reducer</paragraph>
                  <paragraph>Dextromethorphan HBr – Cough Suppressant</paragraph>
                  <paragraph>Relief of:</paragraph>
