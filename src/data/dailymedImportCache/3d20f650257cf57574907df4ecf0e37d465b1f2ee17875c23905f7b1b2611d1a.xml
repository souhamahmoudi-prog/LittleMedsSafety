         <component>
            <section ID="ID_5f1e60fb-ffb9-4077-a841-1418f645c2e2">
               <id root="8fc7d747-62a1-4151-b7b0-fbc997740305"/>
               <code code="34068-7" codeSystem="2.16.840.1.113883.6.1" displayName="DOSAGE &amp; ADMINISTRATION SECTION"/>
               <title>Directions </title>
               <text>
                  <list listType="unordered">
                     <item>
                        <caption>•</caption>do not break or chew tablet; swallow tablet whole</item>
                  </list>
                  <table styleCode="Noautorules" width="100%">
                     <col width="49%"/>
                     <col width="49%"/>
                     <tbody>
                        <tr>
                           <td styleCode="Rrule Botrule Toprule " valign="top">
                              <list listType="unordered">
                                 <item>
                                    <caption> </caption>adults and children 12 years and over</item>
                              </list>
                           </td>
                           <td styleCode="Botrule Lrule Toprule " valign="top">
                              <list listType="unordered">
                                 <item>
                                    <caption> </caption>take 1 tablet every 12 hours; do not take more than 2 tablets in 24 hours.</item>
                              </list>
                           </td>
                        </tr>
                        <tr>
                           <td styleCode="Rrule Botrule " valign="top">
                              <list listType="unordered">
                                 <item>
                                    <caption> </caption>adults 65 years and over</item>
                              </list>
                           </td>
                           <td styleCode="Lrule Toprule Botrule " valign="top">
                              <list listType="unordered">
                                 <item>
                                    <caption> </caption>ask a doctor</item>
                              </list>
                           </td>
                        </tr>
                        <tr>
                           <td styleCode="Rrule Botrule " valign="top">
                              <list listType="unordered">
                                 <item>
                                    <caption> </caption>children under 12 years of age</item>
                              </list>
                           </td>
                           <td styleCode="Lrule Toprule Botrule " valign="top">
                              <list listType="unordered">
                                 <item>
                                    <caption> </caption>ask a doctor</item>
                              </list>
                           </td>
                        </tr>
                        <tr>
                           <td styleCode="Rrule Botrule Toprule " valign="top">
                              <list listType="unordered">
                                 <item>
                                    <caption> </caption>consumers with liver or kidney disease</item>
                              </list>
                           </td>
                           <td styleCode="Botrule Lrule Toprule " valign="top">
                              <list listType="unordered">
                                 <item>
                                    <caption> </caption>ask a doctor</item>
                              </list>
                           </td>
                        </tr>
                     </tbody>
                  </table>
               </text>
               <effectiveTime value="20250204"/>
            </section>
         </component>
