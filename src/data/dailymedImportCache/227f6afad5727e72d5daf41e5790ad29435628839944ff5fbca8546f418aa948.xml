                     <item>store at 20° to 25°C (68° to 77°F)</item>
                     <item>
                        <content styleCode="bold">do not use if shrink sleeves is broken or missing</content>
                     </item>
                  </list>
               </text>
               <effectiveTime value="20260527"/>
            </section>
         </component>
