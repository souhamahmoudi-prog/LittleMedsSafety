               <code code="55105-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - PURPOSE SECTION"/>
               <text>
                  <paragraph>Acetaminophen 325 mg..Pain reliever/fever reducer
  <br/>
Dextromethorphan HBr 10 mg....Cough suppressant
 </paragraph>
               </text>
