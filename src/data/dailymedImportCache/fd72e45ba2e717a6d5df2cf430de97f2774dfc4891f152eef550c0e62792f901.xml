               <code code="60561-8" codeSystem="2.16.840.1.113883.6.1" displayName="OTHER SAFETY INFORMATION"/>
               <title>Other information</title>
               <text>
                  <paragraph>store at 66-77*F (20-25*C), do not use if securety cap is altered or broken</paragraph>
               </text>
               <effectiveTime value="20170410"/>
            </section>
