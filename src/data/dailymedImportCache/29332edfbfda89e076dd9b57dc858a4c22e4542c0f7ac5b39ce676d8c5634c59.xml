         <component>
            <section ID="ID_9d5580a9-18d2-4509-aa7d-916501e1dcde">
               <id root="4cd0b1dd-7174-e3e0-e063-6394a90a627c"/>
               <code code="55106-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ACTIVE INGREDIENT SECTION"/>
               <title>Active ingredient (in each 5 mL)</title>
               <text>
                  <paragraph>Ibuprofen USP 100 mg (NSAID)
 
  <sup>*</sup>
                  </paragraph>
                  <paragraph>
                     <sup>*</sup>nonsteroidal anti-inflammatory drug

 </paragraph>
               </text>
               <effectiveTime value="20241216"/>
            </section>
