---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Human Factors Engineering | LittleMeds Safety"
  description="Workflow design, cognitive load, usability, standardization, interruptions, labeling, and alert fatigue."
>
  <header class="site-header">
    <div class="container header-inner">
      <a class="logo" href="/" aria-label="LittleMeds Safety home">
        <span class="logo-mark" aria-hidden="true">LMS</span>
        <span>LittleMeds Safety</span>
      </a>
      <div class="header-links">
        <nav class="primary-nav" aria-label="Primary navigation">
          <a href="/topics">Topics</a>
          <a href="/#tools">Tools</a>
          <a href="/#resources">Resources</a>
          <a href="/#about">About</a>
        </nav>
        <a class="search-link" href="/#resources">Search</a>
      </div>
    </div>
  </header>
  <main>
    <section class="topic-detail">
      <div class="container topic-detail__grid">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/topics">Topics</a>
          <span>Human Factors Engineering</span>
        </nav>
        <div class="topic-detail__header">
          <p class="eyebrow">Topic</p>
          <h1>Human Factors Engineering</h1>
          <p>
            Workflow design, cognitive load, usability, standardization,
            interruptions, labeling, and alert fatigue.
          </p>
        </div>
        <aside class="empty-state">
          <strong>Resources coming soon</strong>
          <span>Article links and practical tools will be added here as this topic grows.</span>
        </aside>
      </div>
    </section>
  </main>
</BaseLayout>
