                     <code code="50569-3" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ASK DOCTOR SECTION"/>
                     <title>
                        <content styleCode="bold">Ask a doctor before use if you have</content>
                     </title>
                     <text>
                        <list listType="unordered" styleCode="Square">
                           <item>a breathing problem such as emphysema or chronic bronchitis</item>
                           <item>glaucoma</item>
                           <item>difficulty in urination due to enlargement of the prostate gland</item>
                        </list>
                     </text>
                     <effectiveTime value="20260727"/>
                  </section>
               </component>
