         <component>
            <section ID="ID_09a95603-08f6-4c9d-a942-b6c12e0f1e9c">
               <id root="3cf1c37f-527b-d410-e063-6394a90a4132"/>
               <code code="55105-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - PURPOSE SECTION"/>
               <title>Purpose</title>
               <text>
                  <paragraph>Antihistamine</paragraph>
               </text>
               <effectiveTime value="20250822"/>
            </section>
