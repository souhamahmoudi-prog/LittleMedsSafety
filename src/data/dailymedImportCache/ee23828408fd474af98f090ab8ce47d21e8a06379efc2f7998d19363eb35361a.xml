               <code code="42229-5" displayName="SPL UNCLASSIFIED SECTION" codeSystem="2.16.840.1.113883.6.1"/>
               <title>OTHER INFORMATION</title>
               <text>
                  <paragraph>
                     <content styleCode="bold">• </content>store between 20-25°C (68-77°F)
       
 
  <content styleCode="bold">
                        <br/> • do not use if foil inner seal is broken or missing.
       
 
  </content>
                  </paragraph>
               </text>
               <effectiveTime value="20180619"/>
            </section>
         </component>
