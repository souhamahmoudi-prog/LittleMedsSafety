               <code code="55106-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ACTIVE INGREDIENT SECTION"/>
               <text>
                  <paragraph>
                     <content styleCode="bold">Active ingredient (per 5 mL teaspoonful)</content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold"/>﻿Acetaminophen 160 mg

 </paragraph>
               </text>
               <effectiveTime value="20210315"/>
            </section>
