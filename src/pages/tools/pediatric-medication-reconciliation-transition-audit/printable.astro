---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {
  conditionalDomains,
  transitionOptions,
  printableTransitionModules,
  sharedCoreDomains,
} from '../../../data/medicationReconciliationTransitionAudit';

const conditionalDomainGroups = [
  ['Admission', conditionalDomains.admission],
  ['Internal Transfer', conditionalDomains['internal-transfer']],
  ['Interfacility Transfer', conditionalDomains['interfacility-transfer']],
  ['Discharge Home', conditionalDomains['discharge-home']],
  ['Discharge to Another Facility', conditionalDomains['discharge-facility']],
  ['Procedural Transitions', conditionalDomains.procedural],
  ['PICU or NICU Transfer', conditionalDomains['picu-nicu']],
];

const auditFields = [
  'Facility or organization',
  'Department or unit',
  'Auditor',
  'Audit date',
  'Transition type',
  'Population or care area',
  'Policy or procedure reviewed',
  'Policy version or revision date',
  'Audit period',
  'Number of records reviewed',
  'Previous audit date',
  'Notes',
];

const summaryFields = [
  'Total applicable criteria',
  'Compliant',
  'Deficient',
  'Not applicable',
  'Readiness percentage',
  'Readiness classification',
  'Key findings',
  'Recommended process actions',
  'Auditor signature and date',
  'Leadership reviewer signature and date',
];

const documentVersion = 'Version 1.0';
const documentDate = 'July 28, 2026';
---

<BaseLayout
  title="Printable Pediatric Medication Reconciliation and Transition Audit | LittleMeds Safety"
  description="Printable blank Pediatric Medication Reconciliation and Transition Audit checklist for manual completion."
>
  <main class="printable-audit">
    <div class="screen-controls" aria-label="Printable audit actions">
      <button class="button button-primary" type="button" id="printBlankAudit">Print Blank Audit Form</button>
      <a class="button button-secondary" href="/tools/pediatric-medication-reconciliation-transition-audit">Return to Interactive Tool</a>
    </div>

    <article class="print-document">
      <header class="print-header">
        <div class="print-brand">
          <span class="print-brand__mark" aria-hidden="true">LMS</span>
          <span>LittleMeds Safety</span>
        </div>
        <p>{documentVersion} | Audit date: ____________________</p>
        <h1>Pediatric Medication Reconciliation and Transition Audit</h1>
        <p class="professional-notice">
          <strong>Professional notice:</strong>
          This audit must be used with the organization's approved medication-reconciliation policy, formulary, transition-of-care procedures, and documentation standards. It does not replace clinical judgment, patient-specific reconciliation, or institutional policy.
        </p>
      </header>

      <section class="print-section audit-info-section">
        <h2>Audit Information</h2>
        <div class="line-grid">
          {auditFields.map((field) => (
            <div class={field === 'Notes' ? 'line-field line-field--wide' : 'line-field'}>
              <span>{field}</span>
              <span class="write-line"></span>
            </div>
          ))}
        </div>
      </section>

      <section class="print-section medication-selector">
        <h2>Transition Type Selection</h2>
        <p>Select the transition type being audited. Print the matching appendix module pages as needed.</p>
        <div class="checkbox-grid">
          {transitionOptions.map(([, title]) => (
            <label><span class="box" aria-hidden="true"></span>{title}</label>
          ))}
        </div>
      </section>

      <section class="print-section checklist-intro">
        <h2>Shared Core Blank Audit Form</h2>
        <p>
          Complete the shared core domains below for every transition type.
          Conditional domains and transition-specific modules are provided in
          the appendices so users may print only the pages needed for the
          selected transition type.
        </p>
      </section>

      {sharedCoreDomains.map((domain) => (
        <section class="print-section domain-section">
          <h2>{domain.name}</h2>
          <table class="checklist-table">
            <thead>
              <tr>
                <th>Criterion</th>
                <th>Compliant</th>
                <th>Deficient</th>
                <th>N/A</th>
              </tr>
            </thead>
            <tbody>
              {domain.items.map((criterion) => (
                <tr>
                  <td>{criterion}</td>
                  <td><span class="checkbox-symbol" aria-hidden="true">□</span> Compliant</td>
                  <td><span class="checkbox-symbol" aria-hidden="true">□</span> Deficient</td>
                  <td><span class="checkbox-symbol" aria-hidden="true">□</span> N/A</td>
                </tr>
              ))}
            </tbody>
          </table>
          <div class="notes-block">
            <strong>Notes:</strong>
            <span></span>
            <span></span>
          </div>
        </section>
      ))}

      <section class="print-section summary-section">
        <h2>Blank Audit Summary</h2>
        <div class="summary-grid">
          {summaryFields.map((field) => (
            <div class={field.includes('findings') || field.includes('actions') ? 'summary-field summary-field--wide' : 'summary-field'}>
              <span>{field}</span>
              <span class="write-line"></span>
            </div>
          ))}
        </div>
        <div class="formula-box">
          <h3>Scoring Formula</h3>
          <p>Readiness percentage = Compliant ÷ (Compliant + Deficient) × 100</p>
          <h3>Suggested Classifications</h3>
          <ul>
            <li>95-100%: Process safeguards well established</li>
            <li>85-94%: Improvement opportunities identified</li>
            <li>Below 85%: Priority process review recommended</li>
          </ul>
          <p>
            These are suggested quality-improvement indicators and may be
            modified by institutional policy.
          </p>
        </div>
      </section>

      <section class="print-section appendix-intro">
        <h2>Appendix: Conditional Domains</h2>
        <p>
          Use the conditional domain set that matches the selected transition.
          These domains are not intended to appear for every audit.
        </p>
      </section>

      {conditionalDomainGroups.map(([groupName, domains]) => (
        <section class="print-section appendix-module">
          <h2>{groupName}</h2>
          {domains.map((domain) => (
            <section class="nested-print-domain">
              <h3>{domain.name}</h3>
              <table class="checklist-table">
                <thead>
                  <tr>
                    <th>Criterion</th>
                    <th>Compliant</th>
                    <th>Deficient</th>
                    <th>N/A</th>
                  </tr>
                </thead>
                <tbody>
                  {domain.items.map((criterion) => (
                    <tr>
                      <td>{criterion}</td>
                      <td><span class="checkbox-symbol" aria-hidden="true">□</span> Compliant</td>
                      <td><span class="checkbox-symbol" aria-hidden="true">□</span> Deficient</td>
                      <td><span class="checkbox-symbol" aria-hidden="true">□</span> N/A</td>
                    </tr>
                  ))}
                </tbody>
              </table>
              <div class="notes-block">
                <strong>Notes:</strong>
                <span></span>
                <span></span>
              </div>
            </section>
          ))}
        </section>
      ))}

      <section class="print-section appendix-intro">
        <h2>Appendix: Transition-Specific Modules</h2>
        <p>
          Print only the module pages needed for the selected transition type. These appendix criteria are separated from the primary blank form.
        </p>
      </section>

      {printableTransitionModules.map((module) => (
        <section class="print-section appendix-module">
          <h2>{module.title}</h2>
          {module.items.length ? (
            <table class="checklist-table">
              <thead>
                <tr>
                  <th>Criterion</th>
                  <th>Compliant</th>
                  <th>Deficient</th>
                  <th>N/A</th>
                </tr>
              </thead>
              <tbody>
                {module.items.map((criterion) => (
                  <tr>
                    <td>{criterion}</td>
                    <td><span class="checkbox-symbol" aria-hidden="true">□</span> Compliant</td>
                    <td><span class="checkbox-symbol" aria-hidden="true">□</span> Deficient</td>
                    <td><span class="checkbox-symbol" aria-hidden="true">□</span> N/A</td>
                  </tr>
                ))}
              </tbody>
            </table>
          ) : (
            <div class="other-module-lines">
              <p>Institution-defined transition: ______________________________________________</p>
              <p>Local transition-specific criteria:</p>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
            </div>
          )}
          <div class="notes-block">
            <strong>Notes:</strong>
            <span></span>
            <span></span>
          </div>
        </section>
      ))}

      <footer class="print-footer">
        <span>LittleMeds Safety | Pediatric Medication Reconciliation and Transition Audit</span>
        <span>{documentVersion} | {documentDate}</span>
      </footer>
    </article>
  </main>
</BaseLayout>

<script>
  document.querySelector('#printBlankAudit')?.addEventListener('click', () => {
    window.print();
  });
</script>

<style is:global>
  .printable-audit {
    background: #f7f9fb;
    color: #111827;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
      sans-serif;
  }

  .screen-controls {
    position: sticky;
    top: 0;
    z-index: 5;
    display: flex;
    justify-content: center;
    gap: 12px;
    border-bottom: 1px solid #dbe4ea;
    background: #fff;
    padding: 14px;
  }

  .print-document {
    width: min(100% - 40px, 8.5in);
    margin: 28px auto;
    background: #fff;
    padding: 0.65in;
    box-shadow: 0 18px 45px rgba(18, 59, 93, 0.1);
  }

  .print-header {
    border-bottom: 2px solid #123b5d;
    padding-bottom: 18px;
  }

  .print-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #123b5d;
    font-weight: 800;
  }

  .print-brand__mark {
    display: grid;
    width: 36px;
    height: 36px;
    place-items: center;
    border-radius: 6px;
    background: #123b5d;
    color: #fff;
    font-size: 0.72rem;
  }

  .print-header h1 {
    max-width: none;
    margin: 14px 0 10px;
    color: #123b5d;
    font-size: 24pt;
    line-height: 1.1;
  }

  .professional-notice {
    border: 1px solid #b9c9d4;
    border-left: 4px solid #123b5d;
    margin: 12px 0 0;
    padding: 10px 12px;
  }

  .print-section {
    break-inside: avoid;
    margin-top: 22px;
  }

  .print-section h2 {
    margin: 0 0 10px;
    color: #123b5d;
    font-family: inherit;
    font-size: 18pt;
    line-height: 1.15;
  }

  .print-section h3 {
    margin: 12px 0 4px;
    color: #123b5d;
    font-size: 12pt;
  }

  .line-grid,
  .summary-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px 18px;
  }

  .line-field,
  .summary-field {
    display: grid;
    gap: 8px;
    font-weight: 700;
  }

  .line-field--wide,
  .summary-field--wide {
    grid-column: 1 / -1;
  }

  .write-line,
  .notes-block span,
  .other-module-lines span {
    display: block;
    min-height: 24px;
    border-bottom: 1px solid #111827;
  }

  .checkbox-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px 16px;
  }

  .checkbox-grid label {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #111827;
    font-weight: 650;
  }

  .box {
    width: 13px;
    height: 13px;
    border: 1.5px solid #111827;
    background: #fff;
  }

  .checklist-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 10.5pt;
    line-height: 1.3;
  }

  .checklist-table th,
  .checklist-table td {
    border: 1px solid #111827;
    padding: 6px 7px;
    text-align: left;
    vertical-align: top;
  }

  .checklist-table th {
    background: #eef3f6;
    color: #123b5d;
    font-weight: 800;
  }

  .checklist-table th:first-child {
    width: 56%;
  }

  .checklist-table tr {
    break-inside: avoid;
    page-break-inside: avoid;
  }

  .checkbox-symbol {
    font-size: 13pt;
    line-height: 1;
  }

  .notes-block {
    display: grid;
    gap: 8px;
    margin-top: 12px;
  }

  .summary-section,
  .appendix-intro,
  .appendix-module {
    break-before: page;
  }

  .nested-print-domain {
    break-inside: avoid;
    margin-top: 18px;
  }

  .nested-print-domain h3 {
    margin-bottom: 8px;
    color: #123b5d;
    font-size: 13pt;
  }

  .formula-box {
    border: 1px solid #111827;
    margin-top: 18px;
    padding: 12px;
  }

  .formula-box ul {
    margin: 6px 0 10px;
    padding-left: 20px;
  }

  .other-module-lines {
    display: grid;
    gap: 8px;
    border: 1px solid #111827;
    padding: 12px;
  }

  .print-footer {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    border-top: 1px solid #111827;
    margin-top: 24px;
    padding-top: 8px;
    color: #263946;
    font-size: 9pt;
  }

  @page {
    size: Letter portrait;
    margin: 0.55in;
    @bottom-center {
      content: "LittleMeds Safety | Pediatric Medication Reconciliation and Transition Audit | Page " counter(page);
      font-size: 8pt;
      color: #123b5d;
    }
  }

  @media print {
    html,
    body {
      background: #fff !important;
      color: #111827;
      font-size: 10.5pt;
    }

    .screen-controls,
    button,
    .button {
      display: none !important;
    }

    .print-document {
      width: auto;
      margin: 0;
      padding: 0;
      box-shadow: none;
    }

    .print-section {
      margin-top: 16px;
    }

    .print-section h2 {
      font-size: 16pt;
    }

    .checklist-table {
      font-size: 10pt;
    }

    .checklist-table thead {
      display: table-header-group;
    }

    .print-footer {
      position: running(print-footer);
    }
  }
</style>
