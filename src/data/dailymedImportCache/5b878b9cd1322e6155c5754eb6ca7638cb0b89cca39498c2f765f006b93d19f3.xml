         <component>
            <section ID="Lbf66d672-cc51-4baf-8a78-1c28ac43253c">
               <id root="0bbf66f3-1f50-4df5-a1f0-afbdc3e41976"/>
               <code code="55105-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - PURPOSE SECTION"/>
               <title/>
               <text/>
               <effectiveTime value="20200324"/>
            </section>
