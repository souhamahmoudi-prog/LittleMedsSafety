         <component>
            <section>
               <id root="46f2d5ac-91cd-922f-e063-6394a90af4ed"/>
               <code code="51945-4" codeSystem="2.16.840.1.113883.6.1" displayName="PACKAGE LABEL.PRINCIPAL DISPLAY PANEL"/>
               <title>Package Labeling PURO PHARMA Children's Pain &amp; Fever Acetaminophen Oral Suspension Cherry Flavor</title>
               <text>
                  <paragraph>
                     <content styleCode="bold">PURO</content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">PHARMA</content>
                     <content styleCode="bold">             NDC 83474-001-04</content>
                  </paragraph>
                  <paragraph/>
                  <paragraph>COMPARE TO THE</paragraph>
                  <paragraph>ACTIVE INGREDIENT</paragraph>
                  <paragraph>IN CHILDREN'S TYLENOL</paragraph>
                  <paragraph>ORAL SUSPENSION*</paragraph>
                  <paragraph/>
                  <paragraph>
                     <content styleCode="bold">PURO</content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">PHARMA</content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">Children's Pain &amp; Fever</content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">Acetaminophen</content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">Oral Suspension</content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">Pain reliever</content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">Fever Reducer</content>
