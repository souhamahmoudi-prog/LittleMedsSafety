               <code code="55106-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ACTIVE INGREDIENT SECTION"/>
               <title>
                  <content styleCode="bold">
                     <content styleCode="italics">Active ingredient (in each 30 mL)</content>
                  </content>
               </title>
               <text>
                  <paragraph>Diphenhydramine HCl 50 mg</paragraph>
               </text>
               <effectiveTime value="20260622"/>
            </section>
