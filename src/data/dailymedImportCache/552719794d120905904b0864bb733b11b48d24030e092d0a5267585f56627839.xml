         <component>
            <section ID="LINK_f9e6b486-e6bc-410e-a544-15713934d7c9">
               <id root="f58412fb-792d-4612-9c02-24b82a63d346"/>
               <code code="34068-7" codeSystem="2.16.840.1.113883.6.1" displayName="DOSAGE &amp; ADMINISTRATION SECTION"/>
               <title>
                  <content styleCode="bold">
                     <content styleCode="italics">Directions</content>
                  </content>
               </title>
               <text>
                  <list listType="unordered" styleCode="Disk">
                     <item>
                        <content styleCode="bold">do not take more than directed</content>
                     </item>
                     <item>drink a full glass of water with each dose</item>
                     <item>adults and children 12 years and over: take 2 caplets every 6 hours. Do not take more than 8 caplets in 24 hours.</item>
                     <item>children under 12 years: ask a doctor</item>
                  </list>
               </text>
               <effectiveTime value="20260713"/>
            </section>
         </component>
