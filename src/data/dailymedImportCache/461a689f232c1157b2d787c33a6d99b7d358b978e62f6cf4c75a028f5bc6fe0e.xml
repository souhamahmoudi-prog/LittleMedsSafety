               <id root="407ab511-af27-7aa7-e063-6294a90abd54"/>
               <code code="44425-7" codeSystem="2.16.840.1.113883.6.1" displayName="STORAGE AND HANDLING SECTION"/>
               <text>
                  <paragraph>
                     <content styleCode="bold">Other information</content>
                  </paragraph>
                  <list listType="unordered">
                     <item>store between 20-25°C (68-77°F)</item>
                     <item>do not use if carton or sachet is torn, broken or punctured.</item>
                  </list>
               </text>
               <effectiveTime value="20251001"/>
            </section>
         </component>
