                        <tr>
                           <td>Age</td>
                           <td>Dose</td>
                        </tr>
                        <tr>
                           <td>Adults &amp; children 12 yrs &amp; over</td>
                           <td>one packet (dose) every 4 hours</td>
                        </tr>
                        <tr>
                           <td>Children under 12 yrs</td>
                           <td>Do not use</td>
                        </tr>
                     </tbody>
                  </table>
                  <paragraph/>
               </text>
