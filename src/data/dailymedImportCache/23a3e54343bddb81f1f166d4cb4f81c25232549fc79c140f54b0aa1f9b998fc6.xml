               <text>
                  <paragraph>
                     <content styleCode="italics">
                        <content styleCode="bold">Inactive ingredients</content>
                     </content>
                  </paragraph>
                  <paragraph>Acesullame potassium, anhydrous citric acid,<br/>carboxymethylcellulose sodium, D&amp;C Red #33, FD&amp;C<br/>Blue #1, flavors, glycerin, microcrystalline, cellulose,<br/>polysorbate 80, propylene glycol, purified water, sodium<br/>benzoate,sucrose, and xanthan gum</paragraph>
               </text>
