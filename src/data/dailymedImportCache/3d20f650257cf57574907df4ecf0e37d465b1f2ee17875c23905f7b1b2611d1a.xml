               <code code="55106-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ACTIVE INGREDIENT SECTION"/>
               <title>Active ingredients (in each extended release tablet) </title>
               <text>
                  <paragraph>Cetirizine HCl 5 mg</paragraph>
                  <paragraph>Pseudoephedrine HCl 120 mg</paragraph>
               </text>
               <effectiveTime value="20210616"/>
            </section>
