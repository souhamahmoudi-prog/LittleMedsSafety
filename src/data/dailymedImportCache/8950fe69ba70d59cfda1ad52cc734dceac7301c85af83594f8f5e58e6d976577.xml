               <text>
                  <paragraph>carnauba wax, hypromellose, magnesium stearate, microcrystalline cellulose, powdered cellulose, pregelatinized starch, propylene glycol, sodium starch glycolate, titanium dioxide</paragraph>
               </text>
               <effectiveTime value="20210420"/>
            </section>
         </component>
