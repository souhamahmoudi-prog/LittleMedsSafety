               <text>
                  <paragraph>
                     <content styleCode="bold">
                        <content styleCode="italics">Purpose</content>
                     </content>
                  </paragraph>
                  <paragraph>Antihistamine</paragraph>
               </text>
               <effectiveTime value="20200701"/>
