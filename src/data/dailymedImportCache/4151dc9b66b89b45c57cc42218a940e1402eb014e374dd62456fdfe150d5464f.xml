         <component>
            <section ID="L58be6b47-f917-4e02-9d67-6dc6a7b7460a">
               <id root="844549b0-40a9-43cc-9c34-cc2e06055921"/>
               <code code="34067-9" codeSystem="2.16.840.1.113883.6.1" displayName="INDICATIONS &amp; USAGE SECTION"/>
               <text>
                  <paragraph>
                     <content styleCode="bold">﻿Uses</content>
                  </paragraph>
                  <list listType="unordered">
                     <item>temporarily relieves minor aches and pains due to:</item>
                     <item>headache</item>
                     <item>muscular aches</item>
                     <item>backache</item>
                     <item>minor pain of arthritis</item>
                     <item>the common cold</item>
                     <item>toothache</item>
                     <item>premenstrual and menstrual cramps</item>
                     <item>temporarily reduces fever﻿</item>
                  </list>
               </text>
               <effectiveTime value="20200205"/>
            </section>
         </component>
