         <component>
            <section ID="ID_DFFC291D-0CCE-426D-9BCE-3F58415AE7D7">
               <id root="81fea774-e664-42e6-aafd-e772e684a0fe"/>
               <code code="34068-7" codeSystem="2.16.840.1.113883.6.1" displayName="DOSAGE &amp; ADMINISTRATION SECTION"/>
               <title>Directions </title>
               <text>
                  <list listType="unordered">
                     <item>
                        <caption>•</caption>do not divide, crush, chew or dissolve the tablet</item>
                  </list>
                  <table styleCode="Noautorules" width="100%">
                     <col width="50%"/>
                     <col width="50%"/>
                     <tbody>
                        <tr>
                           <td styleCode="Rrule Botrule " valign="top">
                              <paragraph>adults and children 12 years and over</paragraph>
                           </td>
                           <td styleCode="Botrule Lrule " valign="top">
                              <paragraph>1 tablet every 12 hours; not more than 2 tablets in 24 hours</paragraph>
                           </td>
                        </tr>
                        <tr>
                           <td styleCode="Rrule Botrule " valign="top">
                              <paragraph>children under 12 years of age</paragraph>
                           </td>
                           <td styleCode="Lrule Toprule Botrule " valign="top">
                              <paragraph>ask a doctor</paragraph>
                           </td>
                        </tr>
                        <tr>
                           <td styleCode="Rrule Botrule Toprule " valign="top">
                              <paragraph>consumers with liver or kidney disease</paragraph>
                           </td>
                           <td styleCode="Botrule Lrule Toprule " valign="top">
                              <paragraph>ask a doctor</paragraph>
                           </td>
                        </tr>
                     </tbody>
                  </table>
               </text>
               <effectiveTime value="20250509"/>
            </section>
         </component>
         <component>
            <section ID="ID_90135a12-a223-409c-bd5b-20735adb37ea">
