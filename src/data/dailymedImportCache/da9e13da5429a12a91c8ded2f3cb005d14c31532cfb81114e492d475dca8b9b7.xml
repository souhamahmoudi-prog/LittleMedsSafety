               <code code="34068-7" codeSystem="2.16.840.1.113883.6.1" displayName="DOSAGE &amp; ADMINISTRATION SECTION"/>
               <title>
                  <content styleCode="italics">Directions</content>
               </title>
               <text>
                  <list listType="unordered">
                     <item>
                        <caption>▪</caption>
                        <content styleCode="bold">this product does not contain directions or complete warnings for adult use.</content>
                     </item>
                     <item>
                        <caption>▪</caption>
                        <content styleCode="bold">do not give more than directed (see overdose warning)</content>
                     </item>
                     <item>
                        <caption>▪</caption>find the right dose on chart below. If possible, use weight to dose; otherwise use age.  </item>
                     <item>
                        <caption>▪</caption>chew completely do not swallow whole</item>
                     <item>
                        <caption>▪</caption>repeat dose every 4 hours while symptoms last  </item>
                     <item>
                        <caption>▪</caption>do not give more than 5 times in 24 hours or as directed by a doctor</item>
                  </list>
