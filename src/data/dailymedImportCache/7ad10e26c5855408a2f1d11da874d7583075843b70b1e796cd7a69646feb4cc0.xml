            <section ID="ID_7AC89B19-C67F-4E45-BE87-7BFCFA519B23">
               <id root="81d6a6ba-b34e-4cb5-a362-99c4f102c36e"/>
               <code code="50565-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - KEEP OUT OF REACH OF CHILDREN SECTION"/>
               <title>Keep Out of Reach of Children</title>
               <text>
                  <paragraph>
                     <content styleCode="bold">Keep out of reach of children</content>. In case of overdose, get medical help or contact a Poison Control Center right away.</paragraph>
               </text>
               <effectiveTime value="20250630"/>
            </section>
