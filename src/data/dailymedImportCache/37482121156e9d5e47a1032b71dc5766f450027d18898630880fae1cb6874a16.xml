               <title>
                  <content styleCode="bold">Other Information</content>
               </title>
               <text>
                  <list>
                     <item>store at 20° – 25°C (68° – 77°F)<br/>
                     </item>
                     <item>tamper-evident: do not use if foil seal under cap, printed with “SEALED for YOUR PROTECTION” is missing, open or broken</item>
                  </list>
               </text>
               <effectiveTime value="20240117"/>
            </section>
