         <component>
            <section>
               <id root="c1d40ace-6795-42f2-b989-a68730748bd4"/>
               <code code="34068-7" codeSystem="2.16.840.1.113883.6.1" displayName="DOSAGE &amp; ADMINISTRATION SECTION"/>
               <title>
                  <content styleCode="italics">
                     <content styleCode="bold">Directions</content>
                  </content>
               </title>
               <text>
                  <paragraph>• take every 4 to 6 hours, or as directed by a physician<br/>• do not take more than 6 doses in 24 hours</paragraph>
                  <table width="50%">
                     <colgroup>
                        <col width="50%" align="left" valign="top"/>
                        <col width="50%" align="left" valign="top"/>
                     </colgroup>
                     <thead>
                        <tr styleCode="Botrule First Last">
                           <th styleCode="Rrule Toprule" align="center">age</th>
                           <th styleCode="Toprule" align="center">dose</th>
                        </tr>
                     </thead>
                     <tbody>
                        <tr styleCode="Botrule First">
                           <td styleCode="Rrule" align="left">Adults and children over 12 years of age</td>
                           <td align="left">10 mL (25 mg) to 20 mL (50 mg)</td>
                        </tr>
                        <tr styleCode="Botrule">
                           <td styleCode="Rrule" align="left">Children 6 to under 12 years of age</td>
                           <td align="left">10 mL (25 mg)</td>
                        </tr>
                        <tr>
                           <td styleCode="Rrule" align="left">Children under 6 years of age</td>
                           <td align="left">Do not use</td>
                        </tr>
                     </tbody>
                  </table>
                  <paragraph/>
               </text>
               <effectiveTime value="20241017"/>
            </section>
         </component>
         <component>
            <section>
               <id root="e1ad6e77-5db9-44fb-ab7e-92d1e790dcf4"/>
               <code code="42229-5" codeSystem="2.16.840.1.113883.6.1" displayName="SPL UNCLASSIFIED SECTION"/>
               <title>
                  <content styleCode="italics">
                     <content styleCode="bold">Other information</content>
                  </content>
               </title>
               <text>
                  <paragraph>• each 10 mL contains sodium: 6 mg<br/>• store at 20° to 25°C (68° to 77°F). [See USP Controlled Room Temperature]<br/>• do not use if lid is torn or broken</paragraph>
               </text>
               <effectiveTime value="20241017"/>
            </section>
         </component>
