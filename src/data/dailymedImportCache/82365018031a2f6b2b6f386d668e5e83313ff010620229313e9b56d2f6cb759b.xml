                           </th>
                           <th align="left" styleCode="Rrule Botrule Toprule " valign="top">
                              <content styleCode="bold">Age (yr)</content>
                           </th>
                           <th align="left" styleCode="Rrule Botrule Toprule " valign="top">
                              <content styleCode="bold">Dose (mL)</content>
                           </th>
                        </tr>
                     </thead>
                     <tbody>
                        <tr>
                           <td styleCode="Rrule Lrule Toprule Botrule " valign="top">
                              <paragraph>under 36</paragraph>
                           </td>
                           <td styleCode="Rrule Toprule Botrule " valign="top">
                              <paragraph>under 4 years</paragraph>
                           </td>
                           <td styleCode="Rrule Toprule Botrule " valign="top">
                              <paragraph>do not use</paragraph>
                           </td>
                        </tr>
                        <tr>
                           <td styleCode="Rrule Lrule Botrule " valign="top">
                              <paragraph>36-47</paragraph>
                           </td>
                           <td styleCode="Rrule Botrule " valign="top">
                              <paragraph>4 to 5 years</paragraph>
                           </td>
                           <td styleCode="Rrule Botrule " valign="top">
                              <paragraph>do not use unless directed by a doctor</paragraph>
                           </td>
                        </tr>
                        <tr>
                           <td styleCode="Rrule Botrule Lrule " valign="top">
                              <paragraph>48-95</paragraph>
                           </td>
                           <td styleCode="Rrule Botrule " valign="top">
                              <paragraph>6 to 11 years</paragraph>
                           </td>
                           <td styleCode="Rrule Botrule " valign="top">
                              <paragraph>10 mL</paragraph>
                           </td>
                        </tr>
                     </tbody>
                  </table>
                  <paragraph>
                     <content styleCode="bold">Attention:</content>use only enclosed dosing cup specifically designed for use with this product. Do not use any other dosing device.

 </paragraph>
