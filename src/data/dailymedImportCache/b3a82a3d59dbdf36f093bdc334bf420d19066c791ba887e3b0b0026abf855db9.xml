               <code code="34068-7" codeSystem="2.16.840.1.113883.6.1" displayName="DOSAGE &amp; ADMINISTRATION SECTION"/>
               <title>DIRECTIONS</title>
               <text>
                  <paragraph>Adults 18 and over: 1 tablet sublingually or dissolved completely in mouth 2 to 3 times per day or as directed by a physician</paragraph>
               </text>
