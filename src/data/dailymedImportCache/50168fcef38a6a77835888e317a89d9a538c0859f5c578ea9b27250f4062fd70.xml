                     <id root="5531b080-318b-f716-e063-6294a90a9b79"/>
                     <code code="50565-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - KEEP OUT OF REACH OF CHILDREN SECTION"/>
                     <title>
                        <content styleCode="bold">Keep out of reach of children.</content>
                     </title>
                     <text>
                        <paragraph>In case of accidental overdose, get medical help or contact a Poison Control Center (1-800-222-1222) right away.</paragraph>
                     </text>
                     <effectiveTime value="20260626"/>
                  </section>
               </component>
            </section>
         </component>
         <component>
            <section ID="id_link_291a61fc-1414-1b17-e063-6394a90a96af">
               <id root="5531c6cf-b53a-8377-e063-6394a90a4eee"/>
               <code code="34068-7" codeSystem="2.16.840.1.113883.6.1" displayName="DOSAGE &amp; ADMINISTRATION SECTION"/>
               <title>
                  <content styleCode="italics">
                     <content styleCode="bold">Directions</content>
                  </content>
               </title>
               <text>
                  <paragraph>■ do not take more than directed</paragraph>
                  <paragraph>■ chew thoroughly before swallowing</paragraph>
                  <table border="0">
                     <tbody>
                        <tr>
                           <td>
                              <content styleCode="bold">Age </content>
                           </td>
                           <td>
                              <content styleCode="bold">Dose (chew)</content>
                           </td>
                        </tr>
                        <tr>
                           <td>
                              <paragraph>adults and children 12 years and over</paragraph>
                           </td>
                           <td>take 2 chewables at bedtime if needed</td>
                        </tr>
                        <tr>
                           <td>children under 12 years</td>
                           <td>do not use</td>
                        </tr>
                     </tbody>
                  </table>
                  <paragraph/>
               </text>
               <effectiveTime value="20260626"/>
            </section>
         </component>
         <component>
            <section ID="id_link_0c54aa3e-9f38-faa6-e063-6394a90a0127">
               <id root="5531d6e1-3267-1a03-e063-6294a90ab1ee"/>
               <code code="44425-7" codeSystem="2.16.840.1.113883.6.1" displayName="STORAGE AND HANDLING SECTION"/>
               <title>
                  <content styleCode="italics">
                     <content styleCode="bold">Other Information</content>
                  </content>
               </title>
               <text>
                  <paragraph>■ store between 68-77°F (20-25°C)</paragraph>
                  <paragraph>■ avoid high humidity and protect from light</paragraph>
                  <paragraph>■ do not use if foil seal under cap is torn, broken or missing</paragraph>
                  <paragraph>■ see bottom of bottle for lot number and expiration date</paragraph>
               </text>
               <effectiveTime value="20260626"/>
            </section>
         </component>
         <component>
            <section ID="id_link_0c54aa3e-9f3d-faa6-e063-6394a90a0127">
               <id root="5531dd10-8257-95b7-e063-6394a90ae7ee"/>
               <code code="51727-6" codeSystem="2.16.840.1.113883.6.1" displayName="INACTIVE INGREDIENT SECTION"/>
               <title>
                  <content styleCode="italics">
                     <content styleCode="bold">Inactive Ingredients</content>
                  </content>
               </title>
               <text>
                  <paragraph>beta-cyclodextrin, carrageenan, corn syrup, flavors, purified water, sucrose, sucralose</paragraph>
               </text>
               <effectiveTime value="20260626"/>
            </section>
         </component>
