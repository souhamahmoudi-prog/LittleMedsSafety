               <code code="44425-7" codeSystem="2.16.840.1.113883.6.1" displayName="STORAGE AND HANDLING SECTION"/>
               <title>
                  <content styleCode="italics">Other information</content>
               </title>
               <text>
                  <list listType="unordered">
                     <item>
                        <caption>▪</caption>each packet contains: <content styleCode="bold">potassium 6mg</content>
                     </item>
                     <item>
                        <caption>▪</caption>store at room temperature. Protect from excessive heat and moisture. </item>
                  </list>
               </text>
               <effectiveTime value="20220118"/>
            </section>
