               <title>
                  <content styleCode="italics">Other information</content>
               </title>
               <text>
                  <list listType="unordered">
                     <item>
                        <content styleCode="bold">each packet contains:</content>potassium 10 mg, sodium 20 mg
 
  </item>
                     <item>
                        <content styleCode="bold">phenylketonurics:</content>contains phenylalanine 14 mg per packet
 
  </item>
                     <item>store at controlled room temperature 20
  
   <sup>o</sup>-25
  
   <sup>o</sup>C (68
  
   <sup>o</sup>-77
  
   <sup>o</sup>F). Protect product from heat and moisture.
 
  </item>
                  </list>
               </text>
               <effectiveTime value="20180315"/>
            </section>
