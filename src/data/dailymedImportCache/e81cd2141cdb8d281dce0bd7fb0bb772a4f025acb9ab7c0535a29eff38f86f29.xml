               <title>Other information</title>
               <text>
                  <list listType="unordered">
                     <item>
                        <caption>•</caption>
                        <content styleCode="bold">each 5 mL (1 tsp) contains:</content> sodium 15 mg</item>
                     <item>
                        <caption>•</caption>store at 20-25°C (68-77°F). Protect from light. Store in outer carton until contents used.</item>
                     <item>
                        <caption>•</caption>do not use if printed neckband is broken or missing</item>
                  </list>
                  <paragraph>
                     <content styleCode="bold">Relabeled By: Preferred Pharmaceuticals Inc.</content>
                  </paragraph>
               </text>
               <effectiveTime value="20260325"/>
