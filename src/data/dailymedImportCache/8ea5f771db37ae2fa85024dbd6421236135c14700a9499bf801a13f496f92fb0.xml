               <title>Inactive ingredients</title>
               <text>
                  <paragraph>D&amp;C yellow #10, FD&amp;C blue #1, gelatin, glycerin, lecithin, light mineral oil, mannitol, polyethylene glycol, povidone, propylene glycol, purified water, sorbitan, sorbitol, white ink</paragraph>
               </text>
               <effectiveTime value="20260701"/>
            </section>
         </component>
         <component>
            <section ID="LINK_caebece8-1881-46a1-be49-375852c6b651">
               <id root="b0c45dc7-9269-401e-8edb-58f92c899624"/>
               <code code="53413-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - QUESTIONS SECTION"/>
