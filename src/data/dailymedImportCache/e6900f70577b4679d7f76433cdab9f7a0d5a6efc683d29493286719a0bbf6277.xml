               <title>DESCRIPTION</title>
               <text>
                  <paragraph>OB Complete<sup>®</sup> Petite is an oval-shaped  plum colored softgel capsule, imprinted "<content styleCode="bold">VP 059</content>".</paragraph>
               </text>
               <effectiveTime value="20211124"/>
            </section>
         </component>
