               <id root="8f1e7438-91d8-44ec-aada-553b29c132b7"/>
               <code code="51945-4" codeSystem="2.16.840.1.113883.6.1" displayName="PACKAGE LABEL.PRINCIPAL DISPLAY PANEL"/>
               <title>Product Label</title>
               <text>
                  <paragraph>NDC 68016-224-00<br/>
                     <br/>COMPARE TO THE ACTIVE INGREDIENTS IN CHILDREN’S MUCINEX® COLD, COUGH, and SORE THROAT LIQUID<br/>
                     <br/>
                     <content styleCode="bold">Premier Value®</content>
                     <br/>
                     <content styleCode="bold">Children's Cold, Cough, and Sore Throat</content>
                     <br/>
                     <br/>Acetaminophen / Guaifenesin / Dextromethorphan HBr / Phenylephrine HCL<br/>
                     <br/>
                     <content styleCode="bold">PAIN RELIEVER / FEVER REDUCER</content>
                     <br/>
                     <content styleCode="bold">EXPECTORANT</content>
                     <br/>
                     <content styleCode="bold">COUGH SUPPRESSANT</content>
                     <br/>
                     <content styleCode="bold">NASAL DECONGESTANT</content>
                     <br/>
                     <br/>Guaifenesin 100 mg<br/>Dextromethorphan HBr 5 mg<br/>Phenylephrine HCL 2.5 mg<br/>
                     <br/>    * Cough<br/>    * Sore Throat<br/>    * Nasal Congestion<br/>    * Chest Congestion<br/>
                     <br/>
                     <br/>For ages 6 to 12<br/>
