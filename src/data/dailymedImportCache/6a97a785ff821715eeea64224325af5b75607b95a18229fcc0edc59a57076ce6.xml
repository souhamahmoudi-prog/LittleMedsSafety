               <code code="34071-1" codeSystem="2.16.840.1.113883.6.1" displayName="WARNINGS SECTION"/>
               <title>WARNINGS</title>
               <text>
                  <paragraph>As in the case of all medications, keep out of reach of children.</paragraph>
               </text>
               <effectiveTime value="20250915"/>
            </section>
