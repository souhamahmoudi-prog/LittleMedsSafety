               <code code="51727-6" codeSystem="2.16.840.1.113883.6.1" displayName="INACTIVE INGREDIENT SECTION"/>
               <title>
                  <content styleCode="italics">
                     <content styleCode="bold">Inactive Ingredient</content>
                  </content>
               </title>
               <text>
                  <paragraph>
                     <br/>
Citric acid, corn syrup, FD&amp;C red no. 40, glycerin, hydroxyethyl cellulose, methylparaben, propylene glycol, propylparaben,
  <br/>
purified water, sodium citrate, sorbitol solution, natural and artificial strawberry flavor, sucralose.
 </paragraph>
               </text>
               <effectiveTime value="20230401"/>
