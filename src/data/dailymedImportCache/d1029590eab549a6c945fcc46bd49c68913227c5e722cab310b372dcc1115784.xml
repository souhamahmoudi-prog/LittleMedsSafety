                  </table>
                  <paragraph>*or as directed by a doctor</paragraph>
               </text>
               <effectiveTime value="20231110"/>
            </section>
         </component>
         <component>
            <section ID="L604eb75c-fbc5-4f54-8b50-a2cb345de558">
               <id root="3cbcfd7f-c3ba-4bb3-9d3c-aa986c3ffe8f"/>
