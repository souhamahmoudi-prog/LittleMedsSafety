         <component>
            <section ID="id_link_30ca698c-7fe6-9fa7-e063-6294a90abd86">
               <id root="53b5fbb1-4c72-0f2c-e063-6394a90a4f7b"/>
               <code code="55106-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ACTIVE INGREDIENT SECTION"/>
               <title>Active ingredient (in each 5 mL)</title>
               <text>
                  <paragraph>Cetirizine HCl 5 mg</paragraph>
               </text>
               <effectiveTime value="20250320"/>
            </section>
