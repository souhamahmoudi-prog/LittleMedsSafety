               <code code="60561-8" codeSystem="2.16.840.1.113883.6.1" displayName="OTHER SAFETY INFORMATION"/>
               <title>Other information</title>
               <text>
                  <list listType="unordered" styleCode="Disk">
                     <item>
                        <content styleCode="bold">each capsule contains</content>: potassium 20 mg </item>
                     <item>read all warnings and directions before use. Keep carton </item>
                     <item>store between 20° to 25°C (68°to 77°F) </item>
                     <item>avoid excessive heat above 40°C (104°F). Protect from light</item>
                     <item>swallow whole; do not crush, chew, or dissolve</item>
                  </list>
               </text>
               <effectiveTime value="20260723"/>
            </section>
         </component>
