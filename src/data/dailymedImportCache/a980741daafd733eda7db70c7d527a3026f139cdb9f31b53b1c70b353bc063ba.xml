            <section ID="L13609d49-3a9a-444a-a99a-acfa60d8800b">
               <id root="498adc5b-0e6c-f64c-e063-6394a90a62ea"/>
               <code code="34068-7" codeSystem="2.16.840.1.113883.6.1" displayName="DOSAGE &amp; ADMINISTRATION SECTION"/>
               <title>
                  <content styleCode="bold">Directions 
  <br/>
                     <br/>
                  </content>● adults and children 6 years and over:  One 10 mg tablet once daily; do not take more than one 10 mg tablet in 24 hours. A 5 mg product may be appropriate for less severe symptoms 
 <br/>  ● adults 65 years and over : ask a doctor 
 <br/>  ● children under 6 years of age : ask a doctor 
 <br/>  ● consumers with liver or kidney disease :  ask a doctor
</title>
               <text>
                  <paragraph/>
               </text>
               <effectiveTime value="20240124"/>
            </section>
         </component>
