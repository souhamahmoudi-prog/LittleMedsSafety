            <section ID="i4i_Principal_display_panel_id_f742d40c-6722-4869-9750-c921891d9605">
               <id root="44f5c12b-83c6-d13c-e063-6394a90a63f7"/>
               <code code="51945-4" codeSystem="2.16.840.1.113883.6.1" displayName="PACKAGE LABEL.PRINCIPAL DISPLAY PANEL"/>
               <title>Principal Display</title>
               <text>
                  <paragraph>*Compare to the active ingredients in THERAFLU
 
  <sup>®</sup>Daytime Severe Cold &amp;Cold

 </paragraph>
                  <paragraph>WinCo FOODS</paragraph>
                  <paragraph>Severe Cold &amp; Cough</paragraph>
                  <paragraph>Daytime</paragraph>
                  <paragraph>
                     <content styleCode="bold">ACETAMINOPHEN – PAIN RELIEVER/FEVER REDUER</content>
