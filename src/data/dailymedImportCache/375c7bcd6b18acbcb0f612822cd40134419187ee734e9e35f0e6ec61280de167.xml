               <code codeSystem="2.16.840.1.113883.6.1" code="51945-4" displayName="PACKAGE LABEL.PRINCIPAL DISPLAY PANEL"/>
               <title>Principal Display Panel </title>
               <text>
                  <paragraph>COMPARE TO THERAFLU MULTI-SYMPTOM FLU RELIEF MAX STRENGTH** DAYTIME active ingredients*</paragraph>
                  <paragraph>
                     <content styleCode="bold">NDC 70000-0764-1</content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">
                        <content styleCode="italics">Max Strength**</content>
                     </content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">
                        <content styleCode="italics">Daytime</content>
