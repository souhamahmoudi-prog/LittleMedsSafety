         <component>
            <section ID="_20648043-21e2-d472-97ec-56e327025a63">
               <id root="464d2938-3b12-482b-b9f4-e4ace37c1003"/>
               <code code="55105-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - PURPOSE SECTION"/>
               <title>Purpose</title>
               <text>
                  <paragraph>Antihistamine</paragraph>
               </text>
               <effectiveTime value="20260301"/>
            </section>
