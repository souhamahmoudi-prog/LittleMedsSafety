                           <td> 11 years</td>
                           <td>
                              <paragraph> 15 mL</paragraph>
                           </td>
                        </tr>
                     </tbody>
                  </table>
                  <paragraph>*or as directed by a doctor</paragraph>
               </text>
               <effectiveTime value="20250120"/>
            </section>
         </component>
         <component>
            <section ID="L604eb75c-fbc5-4f54-8b50-a2cb345de558">
               <id root="3352f777-8247-4ac8-838a-7d7816c7377f"/>
               <code code="60561-8" codeSystem="2.16.840.1.113883.6.1" displayName="OTHER SAFETY INFORMATION"/>
               <text>
                  <paragraph>
                     <content styleCode="italics">
                        <content styleCode="bold">Other information</content>
                     </content>
                     <br/>■ <content styleCode="bold">each 5 mL contains:</content> sodium 2 mg<br/>■ store between 20-25° C (68-77° F)<br/>■ <content styleCode="bold">do not use if printed </content>
                     <content styleCode="bold">neckband is broken or missing</content>
                  </paragraph>
               </text>
               <effectiveTime value="20250127"/>
            </section>
         </component>
         <component>
