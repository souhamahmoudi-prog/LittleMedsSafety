               <code code="44425-7" codeSystem="2.16.840.1.113883.6.1" displayName="STORAGE AND HANDLING SECTION"/>
               <title>Other information</title>
               <text>
                  <list listType="unordered">
                     <item>
                        <caption>•</caption>
                        <content styleCode="bold">each 5 mL contains:</content> sodium 15 mg</item>
                     <item>
                        <caption>•</caption>store at 20-25°C (68-77°F). Protect from light. Store in outer carton until contents used.</item>
                     <item>
                        <caption>•</caption>
                        <content styleCode="bold">do not use if printed neckband is broken or missing</content>
                     </item>
                  </list>
               </text>
               <effectiveTime value="20190102"/>
            </section>
