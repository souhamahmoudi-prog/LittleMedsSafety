         <component>
            <section ID="ID_156c256b-a620-44fb-9b1f-05bd31c34a9e">
               <id root="0c1218f5-7430-4ae3-8c52-afc03424f9cd"/>
               <code code="55105-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - PURPOSE SECTION"/>
               <title>Purposes </title>
               <text>
                  <paragraph>Pain reliever</paragraph>
                  <paragraph>Pain reliever aid</paragraph>
               </text>
               <effectiveTime value="20241105"/>
            </section>
