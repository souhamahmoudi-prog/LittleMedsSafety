               <code code="60561-8" codeSystem="2.16.840.1.113883.6.1" displayName="OTHER SAFETY INFORMATION"/>
               <title>Other information</title>
               <text>
                  <paragraph>Store at controlled room temperature</paragraph>
                  <paragraph>Avoid excessive heat above 40 °C (104 °F).</paragraph>
                  <paragraph>Protect from moisture.</paragraph>
               </text>
