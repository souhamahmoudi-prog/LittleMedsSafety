               <code code="55106-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ACTIVE INGREDIENT SECTION"/>
               <title>Active ingredient</title>
               <text>
                  <paragraph>
                     <content styleCode="bold">Drug Facts</content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">Active ingredient</content>
                     <br/>(in each 5 mL = 1 teaspoonful)</paragraph>
                  <paragraph>Acetaminophen 160 mg<br/>
                  </paragraph>
               </text>
               <effectiveTime value="20131220"/>
            </section>
