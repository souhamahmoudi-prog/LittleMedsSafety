               <code code="60561-8" codeSystem="2.16.840.1.113883.6.1" displayName="OTHER SAFETY INFORMATION"/>
               <title>Other information </title>
               <text>
                  <list listType="unordered">
                     <item>
                        <caption>•</caption>store between 20° to 25°C (68° to 77°F)</item>
                     <item>
                        <caption>•</caption>
                        <content styleCode="bold">do not use if blister unit is broken or torn</content>
                     </item>
                     <item>
                        <caption>•</caption>see side panel for lot number and expiration date</item>
                     <item>
                        <caption>•</caption>meets USP <content styleCode="italics">Dissolution Test 2</content>
                     </item>
                  </list>
               </text>
               <effectiveTime value="20260228"/>
