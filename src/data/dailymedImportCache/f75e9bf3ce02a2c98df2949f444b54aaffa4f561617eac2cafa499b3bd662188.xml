               <code code="34068-7" codeSystem="2.16.840.1.113883.6.1" displayName="DOSAGE &amp; ADMINISTRATION SECTION"/>
               <title>
                  <content styleCode="italics">Directions</content>
               </title>
               <text>
                  <list listType="unordered">
                     <item>
                        <content styleCode="bold">this product does not contain directions or complete warnings for adult use.</content>
                     </item>
                     <item>
                        <content styleCode="bold">do not give more than directed (see overdose warning)</content>
                     </item>
                     <item>find the right dose on chart below. If possible, use weight to dose; otherwise use age.</item>
                     <item>chew before swallowing</item>
                     <item>if needed, repeat dose every 4 hours while symptoms last</item>
                     <item>do not give more than 5 times in 24 hours</item>
                  </list>
                  <table width="100%">
                     <col width="16%"/>
                     <col width="14%"/>
                     <col width="14%"/>
                     <col width="14%"/>
                     <col width="14%"/>
                     <col width="14%"/>
                     <col width="13%"/>
                     <tbody>
                        <tr>
                           <td styleCode="Rrule Botrule Lrule Toprule " valign="top">
                              <paragraph>
                                 <content styleCode="bold">Weight (lbs)</content>
                              </paragraph>
                           </td>
                           <td styleCode="Rrule Botrule Lrule Toprule " valign="top">
                              <paragraph>under 24</paragraph>
                           </td>
                           <td styleCode="Rrule Botrule Lrule Toprule " valign="top">
                              <paragraph>24-35</paragraph>
                           </td>
                           <td styleCode="Rrule Botrule Lrule Toprule " valign="top">
                              <paragraph>36-47</paragraph>
                           </td>
                           <td styleCode="Rrule Botrule Lrule Toprule " valign="top">
                              <paragraph>48-59</paragraph>
                           </td>
                           <td styleCode="Rrule Botrule Lrule Toprule " valign="top">
                              <paragraph>60-71</paragraph>
                           </td>
                           <td styleCode="Rrule Botrule Lrule Toprule " valign="top">
                              <paragraph>72-95</paragraph>
                           </td>
                        </tr>
                        <tr>
                           <td styleCode="Rrule Lrule Botrule " valign="top">
                              <paragraph>
                                 <content styleCode="bold">Age (yrs)</content>
                              </paragraph>
                           </td>
                           <td styleCode="Rrule Lrule Botrule " valign="top">
                              <paragraph>under 2 years</paragraph>
                           </td>
                           <td styleCode="Rrule Lrule Botrule " valign="top">
                              <paragraph>2-3- years</paragraph>
                           </td>
                           <td styleCode="Rrule Lrule Botrule " valign="top">
                              <paragraph> 4-5 years</paragraph>
                           </td>
                           <td styleCode="Rrule Lrule Botrule " valign="top">
                              <paragraph>6-8 years</paragraph>
                           </td>
                           <td styleCode="Rrule Lrule Botrule " valign="top">
                              <paragraph>9-10 years</paragraph>
                           </td>
                           <td styleCode="Rrule Lrule Botrule " valign="top">
                              <paragraph>11 years</paragraph>
                           </td>
                        </tr>
                        <tr>
                           <td styleCode="Rrule Botrule Lrule " valign="top">
                              <paragraph>
                                 <content styleCode="bold">Dose(tablets)*</content>
                              </paragraph>
                           </td>
                           <td styleCode="Rrule Botrule Lrule " valign="top">
                              <paragraph> ask a doctor</paragraph>
                           </td>
                           <td styleCode="Rrule Botrule Lrule " valign="top">
                              <paragraph> 1</paragraph>
                           </td>
                           <td styleCode="Rrule Botrule Lrule " valign="top">
                              <paragraph>1 1/2</paragraph>
                           </td>
                           <td styleCode="Rrule Botrule Lrule " valign="top">
                              <paragraph>2</paragraph>
                           </td>
                           <td styleCode="Rrule Botrule Lrule " valign="top">
                              <paragraph>2 1/2</paragraph>
                           </td>
                           <td styleCode="Rrule Botrule Lrule " valign="top">
                              <paragraph>3</paragraph>
                           </td>
                        </tr>
                     </tbody>
                  </table>
                  <list listType="unordered">
                     <item>*or as directed by a doctor</item>
                  </list>
               </text>
               <effectiveTime value="20251208"/>
