               <title>
                  <content styleCode="bold">Stop use and ask a doctor if</content>
               </title>
               <text>
                  <paragraph>
                     <content styleCode="bold">Stop use and ask a doctor if </content>
                  </paragraph>
                  <list listType="unordered">
                     <item>condition worsens or does not improve withn 7 days</item>
                     <item>symptoms persist for more than 7 days or clear up and occur again within a few days </item>
                  </list>
               </text>
               <effectiveTime value="20251101"/>
            </section>
