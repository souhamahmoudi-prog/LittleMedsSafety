               <code code="55106-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ACTIVE INGREDIENT SECTION"/>
               <title>Active ingredient (in each rectal suppository)</title>
               <text>
                  <paragraph>Acetaminophen 120 mg </paragraph>
               </text>
               <effectiveTime value="20250606"/>
            </section>
