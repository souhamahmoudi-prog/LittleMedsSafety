         <component>
            <section>
               <id root="e07c1c3f-72d5-495c-bb9d-18cac6ccd1ba"/>
               <code code="44425-7" codeSystem="2.16.840.1.113883.6.1" displayName="STORAGE AND HANDLING SECTION"/>
               <title>Other information</title>
               <text>
                  <list listType="unordered" styleCode="square">
                     <item>
                        <content styleCode="bold">each 5 mL contains:</content> sodium 2 mg</item>
                     <item>store at 20-25°C (68-77°F)</item>
                     <item>do not freeze</item>
                  </list>
               </text>
               <effectiveTime value="20250801"/>
            </section>
         </component>
         <component>
            <section>
               <id root="43edcfe1-3e9a-49be-8707-0716aab0ae4e"/>
               <code code="51727-6" codeSystem="2.16.840.1.113883.6.1" displayName="INACTIVE INGREDIENT SECTION"/>
