            <section ID="i4i_Principal_display_panel_id_53b99287-4ba2-40e5-8661-6272f191f76a">
               <id root="a9a16d65-8f51-4080-9565-e040a892bd75"/>
               <code code="51945-4" codeSystem="2.16.840.1.113883.6.1" displayName="PACKAGE LABEL.PRINCIPAL DISPLAY PANEL"/>
               <title>Package/Label Principal Display Panel</title>
               <text>
                  <paragraph>Walgreens</paragraph>
                  <paragraph>Compare to the active ingredient in Infants’ Tylenol<sup>®</sup>
                  </paragraph>
                  <paragraph>WALGREENS PHARMACIST RECOMMENDED</paragraph>
                  <paragraph>Dye-Free</paragraph>
                  <paragraph>Infants’</paragraph>
