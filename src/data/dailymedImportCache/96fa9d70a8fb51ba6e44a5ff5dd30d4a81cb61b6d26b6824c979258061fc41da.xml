               <title>
                  <content styleCode="italics">Other information</content>
               </title>
               <text>
                  <list listType="unordered">
                     <item>
                        <content styleCode="bold">Keep carton for full directions for use</content>
                     </item>
                     <item>
                        <content styleCode="bold">each 5 mL (1 tsp) contains</content>: sodium 3 mg
 
  </item>
                     <item>store between 20-25°C (68-77°F)</item>
                     <item>do not refrigerate</item>
                  </list>
               </text>
               <effectiveTime value="20240502"/>
            </section>
         </component>
