               <code code="44425-7" codeSystem="2.16.840.1.113883.6.1" displayName="STORAGE AND HANDLING SECTION"/>
               <title>Other information</title>
               <text>
                  <list listType="unordered">
                     <item>
                        <caption>•</caption>
                        <content styleCode="bold">each 5 mL contains</content>: sodium 3 mg</item>
                     <item>
                        <caption>•</caption>store at 20-25<sup>°</sup>C (68-77<sup>°</sup>F)</item>
                     <item>
                        <caption>•</caption>
                        <content styleCode="bold">do not use if printed neckband is broken or missing</content>
                     </item>
                  </list>
               </text>
               <effectiveTime value="20240415"/>
            </section>
         </component>
         <component>
            <section ID="i4i_inactive_ingredients_id_f28deaa7-61b9-4f9a-9764-a40e900c37cc">
