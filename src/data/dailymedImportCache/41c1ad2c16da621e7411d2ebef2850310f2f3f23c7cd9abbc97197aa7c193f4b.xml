         <component>
            <section ID="LINK_5938b4da-d33c-487a-9e50-f75a8ecb6c58">
               <id root="3388c0e9-a280-4c35-bcbb-933c8358bcf5"/>
               <code code="55105-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - PURPOSE SECTION"/>
               <title>
                  <content styleCode="bold">
                     <content styleCode="italics">Purpose</content>
                  </content>
               </title>
               <text>
                  <paragraph>Pain reliever<br/>
Antihistamine</paragraph>
               </text>
