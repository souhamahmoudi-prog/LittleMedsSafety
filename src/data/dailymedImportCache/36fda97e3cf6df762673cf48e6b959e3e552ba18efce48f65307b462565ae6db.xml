               <code code="55106-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ACTIVE INGREDIENT SECTION"/>
               <title>Active ingredient (in each 0.8 mL)</title>
               <text>
                  <paragraph>Acetaminophen 80 mg</paragraph>
               </text>
               <effectiveTime value="20090717"/>
            </section>
