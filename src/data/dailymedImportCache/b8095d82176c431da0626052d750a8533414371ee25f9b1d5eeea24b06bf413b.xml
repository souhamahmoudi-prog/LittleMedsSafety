               <id root="3a6e4086-8e4b-bf14-e063-6394a90a2c06"/>
               <code code="51727-6" codeSystem="2.16.840.1.113883.6.1" displayName="INACTIVE INGREDIENT SECTION"/>
               <title>
                  <content styleCode="italics">
                     <content styleCode="bold">Inactive ingredients</content>
                  </content>
               </title>
               <text>
                  <paragraph/>
                  <paragraph/>
                  <paragraph>FD&amp;C red 40, gelatin,glycerin, polyethylene glycol 400, polyoxyl 40 hydrogenated castor oil, povidone K30,purified water, sorbitol sorbitan solution, titanium dioxide</paragraph>
               </text>
               <effectiveTime value="20250517"/>
            </section>
         </component>
