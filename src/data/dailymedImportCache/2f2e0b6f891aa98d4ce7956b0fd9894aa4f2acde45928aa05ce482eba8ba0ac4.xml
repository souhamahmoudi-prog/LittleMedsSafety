               </component>
               <component>
                  <section ID="id_link_5622a166-de96-bb58-e063-6394a90a7512">
                     <id root="5622a166-de97-bb58-e063-6394a90a7512"/>
                     <code code="53414-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - PREGNANCY OR BREAST FEEDING SECTION"/>
                     <title>
                        <content styleCode="bold">If pregnant or breast-feeding,</content>
                     </title>
                     <text>
                        <paragraph>ask a health professional before use.</paragraph>
                     </text>
                     <effectiveTime value="20260708"/>
                  </section>
               </component>
               <component>
                  <section ID="id_link_5622ba7e-2f3d-adc9-e063-6294a90ac3e9">
                     <id root="5622bc46-00e4-7d3b-e063-6294a90a63a7"/>
                     <code code="34088-5" codeSystem="2.16.840.1.113883.6.1" displayName="OVERDOSAGE SECTION"/>
                     <title>
                        <content styleCode="bold">Overdose warning:</content>
                     </title>
                     <text>
                        <paragraph>Taking more than directed can cause serious health problems. In case of overdose, get medical help or contact a Poison Control Center right away. Quick medical attention is critical for adults as well as for children even if you dot notice any signs or symptoms.</paragraph>
                     </text>
                     <effectiveTime value="20260708"/>
                  </section>
               </component>
            </section>
         </component>
         <component>
            <section ID="id_link_5622c392-4e5b-d3a7-e063-6394a90a7655">
               <id root="5622ca4c-4fcd-8feb-e063-6294a90a54ba"/>
               <code code="34068-7" codeSystem="2.16.840.1.113883.6.1" displayName="DOSAGE &amp; ADMINISTRATION SECTION"/>
               <title>
                  <content styleCode="bold">
                     <content styleCode="italics">Directions</content>
                  </content>
               </title>
               <text>
                  <list listType="unordered">
                     <item>Take only as directed.</item>
                     <item>Do not exceed 4 doses per 24 hours.</item>
                  </list>
                  <table border="0">
                     <tbody>
                        <tr>
                           <td>Adults &amp; Children 12 yrs &amp; over</td>
                           <td>2 softgels with water every 4 hrs</td>
                        </tr>
                        <tr>
                           <td>Children 4 to under 12 yrs</td>
                           <td>Ask a doctor</td>
                        </tr>
                        <tr>
                           <td>Children under 4 yrs</td>
                           <td>Do not use</td>
                        </tr>
                     </tbody>
                  </table>
                  <paragraph/>
               </text>
               <effectiveTime value="20260708"/>
            </section>
         </component>
         <component>
