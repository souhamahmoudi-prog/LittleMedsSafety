            <section ID="i4i_section_id_46fef845-f7f3-4d39-bfb5-06ff3f5a0c04">
               <id root="828d2f2d-b9b4-4c29-91e4-e6e341e8390a"/>
               <code code="42229-5" codeSystem="2.16.840.1.113883.6.1" displayName="SPL UNCLASSIFIED SECTION"/>
               <text>
                  <paragraph>
                     <content styleCode="bold">CETIRIZINE HCl</content>
                     <br/>
                     <content styleCode="bold">10 mg TABLETS, USP</content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">Antihistamine</content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">Indoor &amp; Outdoor Allergies</content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">TAMPER EVIDENT: DO NOT USE IF BLISTER UNITS ARE TORN, BROKEN OR SHOW ANY SIGNS OF TAMPERING.</content>
                  </paragraph>
               </text>
               <effectiveTime value="20240109"/>
            </section>
