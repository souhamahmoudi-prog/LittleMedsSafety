               <id root="5533616c-6af4-b471-e063-6294a90a583e"/>
               <code code="34067-9" codeSystem="2.16.840.1.113883.6.1" displayName="INDICATIONS &amp; USAGE SECTION"/>
               <title>
                  <content styleCode="italics">
                     <content styleCode="bold">Uses</content>
                  </content>
               </title>
               <text>
                  <paragraph>Temporarily relieves</paragraph>
                  <paragraph>■ runny nose</paragraph>
                  <paragraph>■ sneezing</paragraph>
                  <paragraph>■ itchy nose or throat</paragraph>
                  <paragraph>■ itchy, watery eyes due to hay fever</paragraph>
                  <paragraph>■ other upper respiratory allergies</paragraph>
               </text>
               <effectiveTime value="20260626"/>
            </section>
         </component>
