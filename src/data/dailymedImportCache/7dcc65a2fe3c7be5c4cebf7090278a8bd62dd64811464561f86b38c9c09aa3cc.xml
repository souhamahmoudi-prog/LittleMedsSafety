               <code code="42232-9" codeSystem="2.16.840.1.113883.6.1" displayName="PRECAUTIONS SECTION"/>
               <title>
                  <content styleCode="bold">PRECAUTIONS</content>:</title>
               <text>
                  <paragraph>
                     <content styleCode="bold">General: Do not exceed recommended dose.</content>
                  </paragraph>
                  <paragraph>
                     <br/>
                     <content styleCode="bold">If pregnant or breast-feeding,</content> ask a physician or other health care professional before use.</paragraph>
               </text>
               <effectiveTime value="20250621"/>
            </section>
