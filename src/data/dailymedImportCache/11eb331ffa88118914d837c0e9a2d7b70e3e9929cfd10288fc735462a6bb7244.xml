                     <content styleCode="bold">Inactive ingredients</content>
                  </content>
               </title>
               <text>
                  <paragraph>anhydrous citric acid, butylparaben, FD&amp;C red # 40, flavor, glycerin, high fructose corn syrup, microcrystalline cellulose and carboxymethylcellulose sodium, propylene glycol, purified water, sodium benzoate, sorbitol solution, sucralose, xanthan gum</paragraph>
               </text>
               <effectiveTime value="20131220"/>
            </section>
         </component>
