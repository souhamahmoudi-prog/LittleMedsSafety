               <title>Inactive ingredients</title>
               <text>
                  <paragraph>butyl paraben, cellulose, citric acid, FD&amp;C Blue # 1 FD&amp;C Red # 33, glycerin, high fructose corn syrup, propylene glycol, sodium benzoate, sorbitol, water, xanthan gum</paragraph>
               </text>
               <effectiveTime value="20130403"/>
            </section>
         </component>
