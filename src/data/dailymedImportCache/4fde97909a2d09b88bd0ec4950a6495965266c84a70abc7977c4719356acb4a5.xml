               <title>INACTIVE INGREDIENTS</title>
               <text>
                  <paragraph>Lactose monohydrate, magnesium stearate, sodium starch glycolate and starch maize pregelatinized</paragraph>
               </text>
               <effectiveTime value="20170621"/>
            </section>
