         <component>
            <section ID="Unclassified_Section_1">
               <id root="096a80e6-ab01-42b5-b8cb-03c710396394"/>
               <code code="51727-6" codeSystem="2.16.840.1.113883.6.1" displayName="INACTIVE INGREDIENT SECTION"/>
               <title>INACTIVE INGREDIENT SECTION</title>
               <text>
                  <paragraph>
                     <content styleCode="underline">Berry flavor (with dye)</content>
                  </paragraph>
                  <br/>
                  <br/>
                  <paragraph>Acesulfame potassium, anhydrous citric acid, carboxymethylcellulose sodium, D&amp;C Yellow #10, FD&amp;C Red #40, flavors, glycerin, microcrystalline cellulose, polysorbate 80, propylene glycol, purified water, sodium benzoate, sucrose, and xanthan gum.</paragraph>
                  <br/>
                  <paragraph>
                     <content styleCode="underline">Berry flavor (dye free)</content>
                  </paragraph>
                  <br/>
                  <paragraph>Acesulfame potassium, anhydrous citric acid, carboxymethylcellulose sodium, flavors, glycerin, microcrystalline cellulose, polysorbate 80, propylene glycol, purified water, sodium benzoate, sucrose, and xanthan gum.</paragraph>
                  <br/>
                  <paragraph>
                     <content styleCode="underline">Grape flavor</content>
                  </paragraph>
                  <paragraph>
