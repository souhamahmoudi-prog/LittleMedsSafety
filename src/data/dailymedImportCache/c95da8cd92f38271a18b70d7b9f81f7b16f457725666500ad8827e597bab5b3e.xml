               <code code="55105-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - PURPOSE SECTION"/>
               <title>
                  <content styleCode="bold"/>
               </title>
               <text>
                  <paragraph>
                     <content styleCode="bold">Adults:</content>One (1) tablet daily, preferably after meals or as directed by the doctor.

 </paragraph>
                  <paragraph>
                     <content styleCode="bold">Children:</content>As directed by the doctor.

 </paragraph>
               </text>
               <effectiveTime value="20130514"/>
            </section>
         </component>
         <component>
            <section>
               <id root="2a327df7-e761-8130-e063-6294a90a6e83"/>
               <code code="55106-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ACTIVE INGREDIENT SECTION"/>
               <title>
                  <content styleCode="bold"/>
               </title>
               <text>
                  <paragraph>
                     <content styleCode="bold">EACH TABLET CONTAINS:                                                                 </content>% U.S. RDA*

 </paragraph>
                  <paragraph>Elemental Iron 65 mg (Equivalent to 325 mg of Ferrous Sulfate)                        60</paragraph>
                  <paragraph>*U.S. Recommended Daily Allowance</paragraph>
               </text>
               <effectiveTime value="20130514"/>
            </section>
         </component>
