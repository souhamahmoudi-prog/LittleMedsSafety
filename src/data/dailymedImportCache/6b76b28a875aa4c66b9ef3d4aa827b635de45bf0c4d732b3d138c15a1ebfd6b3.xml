               <text>
                  <paragraph>
                     <content styleCode="italics">
                        <content styleCode="bold">Directions</content>
                     </content>
                  </paragraph>
                  <list listType="unordered">
                     <item>
                        <content styleCode="bold">do not use more than directed</content>
                     </item>
                     <item>
                        <content styleCode="bold">adults and children 2 years of age and older: </content>apply to affected area not more than 3 to 4 times daily
  </item>
                     <item>
                        <content styleCode="bold">for children under 2 years of age: </content>do not use, consult a doctor
  </item>
                  </list>
                  <paragraph/>
               </text>
               <effectiveTime value="20251101"/>
