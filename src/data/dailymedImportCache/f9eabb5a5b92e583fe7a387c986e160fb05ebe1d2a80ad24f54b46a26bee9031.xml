               <text>
                  <paragraph>
                     <content styleCode="bold">Keep out of reach of children.</content>
                     <br/>
                     <content styleCode="bold">Overdose warning: </content>Taking more than the recommended dose
  <br/>
(overdose) may cause liver damage. In case of overdose, get
  <br/>
medical help or contact a Poison Control Center right away. Quick
  <br/>
medical attention is critical even if you do not notice any signs or
  <br/>
symptoms.
 </paragraph>
                  <paragraph/>
                  <paragraph/>
               </text>
               <effectiveTime value="20260601"/>
            </section>
