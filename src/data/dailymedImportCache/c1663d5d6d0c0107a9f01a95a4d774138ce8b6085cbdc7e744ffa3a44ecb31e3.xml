                              <content styleCode="bold">Age (yr)</content>
                              <br/>
                           </td>
                           <td align="center" styleCode="Rrule" valign="top">
                              <content styleCode="bold">Dose (tablets)*</content>
                              <br/>
                           </td>
                        </tr>
                        <tr styleCode="Botrule">
                           <td align="center" styleCode="Lrule Rrule" valign="top">under 24 
     <br/>
                           </td>
                           <td align="center" styleCode="Rrule" valign="top">under 2 years 
     <br/>
                           </td>
                           <td align="center" styleCode="Rrule" valign="top">ask a doctor 
     <br/>
                           </td>
                        </tr>
                        <tr styleCode="Botrule">
                           <td align="center" styleCode="Lrule Rrule" valign="top">24 to 35 
     <br/>
                           </td>
                           <td align="center" styleCode="Rrule" valign="top">2 to 3 years 
     <br/>
                           </td>
                           <td align="center" styleCode="Rrule" valign="top">1 tablet 
     <br/>
                           </td>
                        </tr>
                        <tr styleCode="Botrule">
                           <td align="center" styleCode="Lrule Rrule" valign="top">36 to 47 
     <br/>
                           </td>
                           <td align="center" styleCode="Rrule" valign="top">4 to 5 years 
     <br/>
                           </td>
                           <td align="center" styleCode="Rrule" valign="top">1½ tablets 
     <br/>
                           </td>
                        </tr>
                        <tr styleCode="Botrule">
                           <td align="center" styleCode="Lrule Rrule" valign="top">48 to 59 
     <br/>
                           </td>
                           <td align="center" styleCode="Rrule" valign="top">6 to 8 years 
     <br/>
                           </td>
                           <td align="center" styleCode="Rrule" valign="top">2 tablets 
     <br/>
                           </td>
                        </tr>
                        <tr styleCode="Botrule">
                           <td align="center" styleCode="Lrule Rrule" valign="top">60 to 71 
     <br/>
                           </td>
                           <td align="center" styleCode="Rrule" valign="top">9 to 10 years 
     <br/>
                           </td>
                           <td align="center" styleCode="Rrule" valign="top">2½ tablets 
     <br/>
                           </td>
                        </tr>
                        <tr>
                           <td align="center" styleCode="Lrule Rrule" valign="top">72 to 95 
     <br/>
                           </td>
                           <td align="center" styleCode="Rrule" valign="top">11 years 
