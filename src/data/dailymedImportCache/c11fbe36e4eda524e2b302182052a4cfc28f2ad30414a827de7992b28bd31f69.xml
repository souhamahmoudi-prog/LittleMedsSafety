               <code code="34068-7" codeSystem="2.16.840.1.113883.6.1" displayName="DOSAGE &amp; ADMINISTRATION SECTION"/>
               <title>Directions </title>
               <text>
                  <list listType="unordered">
                     <item>
                        <caption>•</caption>
                        <content styleCode="bold">do not use more than directed</content>
                     </item>
                     <item>
                        <caption>•</caption>drink a full glass of water with each dose</item>
                     <item>
                        <caption>•</caption>adults and children 12 years of age and over: take 2 geltabs every 6 hours; not more than 8 geltabs in 24 hours</item>
                     <item>
                        <caption>•</caption>children under 12 years: ask a doctor</item>
                  </list>
               </text>
               <effectiveTime value="20241105"/>
            </section>
         </component>
