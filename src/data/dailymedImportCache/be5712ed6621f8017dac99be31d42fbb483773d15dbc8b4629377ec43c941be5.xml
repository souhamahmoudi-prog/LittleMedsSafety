               <title>
                  <content styleCode="bold">
                     <content styleCode="italics">Other information</content>
                  </content>
               </title>
               <text>
                  <paragraph>store between 20° to 25°C (68° to 77°F).</paragraph>
               </text>
               <effectiveTime value="20241014"/>
            </section>
         </component>
