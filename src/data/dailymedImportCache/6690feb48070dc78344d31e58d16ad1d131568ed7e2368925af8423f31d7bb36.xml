               <text>
                  <paragraph>
                     <content styleCode="italics">
                        <content styleCode="bold">Drug Facts       </content>
                     </content>
                  </paragraph>
                  <paragraph>
                     <br/>
                     <content styleCode="italics">
                        <content styleCode="bold">Active ingredient                   </content>
                     </content>
                     <br/>
                     <content styleCode="italics">
                        <content styleCode="bold">(in each 5 mL teaspoon)</content>
                     </content>
                  </paragraph>
                  <paragraph>Diphenhydramine HCL 12.5 mg</paragraph>
               </text>
               <effectiveTime value="20201009"/>
            </section>
