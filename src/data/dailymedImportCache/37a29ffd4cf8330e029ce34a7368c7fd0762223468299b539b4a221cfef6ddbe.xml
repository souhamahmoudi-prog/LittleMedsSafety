         <component>
            <section ID="id_link_3807a122-42f6-ee3a-e063-6394a90aa6b1">
               <id root="3807c159-576e-ec68-e063-6294a90ab7d2"/>
               <code code="34068-7" codeSystem="2.16.840.1.113883.6.1" displayName="DOSAGE &amp; ADMINISTRATION SECTION"/>
               <title>Directions</title>
               <text>
                  <list listType="unordered">
                     <item>This product does not contain directions or complete warnings</item>
                  </list>
                  <paragraph>for adult use</paragraph>
                  <list listType="unordered">
                     <item>do not give more than directed (see overdose warning)</item>
                     <item>shake well before using</item>
                     <item>mL=milliliter</item>
                     <item>find the right dose on chart below. If possible, use weight to dose; otherwise, use age.</item>
                     <item>repeat dose every 4 hours while symptoms last</item>
                     <item>do not give more than 5 times in 24 hours</item>
                  </list>
                  <table border="0" cellpadding="0" cellspacing="0" width="385px">
                     <tbody>
                        <tr>
                           <td>
                              <paragraph>
                                 <content styleCode="bold"> Weight (lbs.)</content>
                              </paragraph>
                           </td>
                           <td>
                              <paragraph>
                                 <content styleCode="bold"> Age (yrs.)</content>
                              </paragraph>
                           </td>
                           <td>
                              <paragraph>
                                 <content styleCode="bold"> Dose (tsp or mL)</content>
                              </paragraph>
                           </td>
                        </tr>
                        <tr>
                           <td>
                              <paragraph> under 24</paragraph>
                           </td>
                           <td>
                              <paragraph> under 2</paragraph>
                           </td>
                           <td>
                              <paragraph> ask a doctor</paragraph>
                           </td>
                        </tr>
                        <tr>
                           <td>
                              <paragraph> 24 to 35</paragraph>
                           </td>
                           <td>
                              <paragraph> 2 to 3</paragraph>
                           </td>
                           <td>
                              <paragraph> 1 tsp or 5 mL</paragraph>
                           </td>
                        </tr>
                        <tr>
                           <td>
                              <paragraph> 36 to 47</paragraph>
                           </td>
                           <td>
                              <paragraph> 4 to 5</paragraph>
                           </td>
                           <td>
                              <paragraph> 1 1/2 tsp or 7.5 mL</paragraph>
                           </td>
                        </tr>
                        <tr>
                           <td>
                              <paragraph> 48 to 59</paragraph>
                           </td>
                           <td>
                              <paragraph> 6 to 8</paragraph>
                           </td>
                           <td>
                              <paragraph> 2 tsp or 10 mL</paragraph>
                           </td>
                        </tr>
                        <tr>
                           <td>
                              <paragraph> 60 to 71</paragraph>
                           </td>
                           <td>
                              <paragraph> 9 to 10</paragraph>
                           </td>
                           <td>
                              <paragraph> 2 1/2 tsp or 12.5 mL</paragraph>
                           </td>
                        </tr>
                        <tr>
                           <td>
                              <paragraph> 72 to 95</paragraph>
                           </td>
                           <td>
                              <paragraph> 11</paragraph>
                           </td>
                           <td>
                              <paragraph> 3 tsp or 15 mL</paragraph>
                           </td>
                        </tr>
                     </tbody>
                  </table>
                  <paragraph>*or as directed by a doctor</paragraph>
                  <list listType="unordered">
                     <item>Attention: use only enclosed dosing cup designed for use with this product. Do not use any other dosing device.</item>
                  </list>
                  <paragraph/>
               </text>
               <effectiveTime value="20240819"/>
            </section>
         </component>
