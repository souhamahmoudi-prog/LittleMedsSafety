         <component>
            <section ID="id_link_1c68352f-f06a-4100-e063-6294a90aea2b">
               <id root="1c68352f-f069-4100-e063-6294a90aea2b"/>
               <code code="55105-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - PURPOSE SECTION"/>
               <text>
                  <paragraph>
                     <content styleCode="bold">Ingredient                              Purpose</content>
                  </paragraph>
                  <paragraph>ALFALFA:                              Improves appetite and helps in digestion resulting in improved mental and physical health and weight gain</paragraph>
                  <paragraph>CINCHONA OFF:                  Helps against exhaustion from general debility</paragraph>
                  <paragraph>AVENA SATIVA:                    Convalescence</paragraph>
                  <paragraph>HYDRASTIS CAN:                Improves appetite</paragraph>
                  <paragraph>GINSENG:                             Acts as a general tonic, boosts immunity, improves appetite, and increase resistance to infection.</paragraph>
                  <paragraph>FERRIC CITRATE:                It compensates for the generalized weakness of the body due to anemia.</paragraph>
                  <paragraph>NAT PHOS:                           Strengthens muscles &amp; bones</paragraph>
                  <paragraph>MAG PHOS:                          Helps in relieving muscular cramps</paragraph>
                  <paragraph>CALC PHOS:                         for bone development and anemia after acute and chronic wasting diseases</paragraph>
                  <paragraph>KALI PHOS:                           Helps in weakness and fatigue</paragraph>
                  <paragraph>FERR PHOS:                         Remedy for the first stage of all febrile conditions.</paragraph>
               </text>
               <effectiveTime value="20240704"/>
            </section>
         </component>
         <component>
            <section ID="id_link_1c685193-07f7-88a1-e063-6294a90a8b77">
               <id root="1c685193-07f6-88a1-e063-6294a90a8b77"/>
               <code code="34071-1" codeSystem="2.16.840.1.113883.6.1" displayName="WARNINGS SECTION"/>
               <title>Warnings</title>
               <text>
                  <paragraph>
                     <content styleCode="bold">Warnings:</content>
                  </paragraph>
                  <paragraph>Do not:</paragraph>
                  <list listType="unordered">
                     <item>use if you have an allergy or hypersensitivity to components of the formula</item>
                     <item>apply to wounds or damaged skin</item>
                  </list>
                  <paragraph/>
                  <paragraph>if pregnant or breast feeding, ask a licensed homeopathic practitioner before use</paragraph>
                  <paragraph/>
                  <paragraph/>
                  <paragraph/>
                  <paragraph/>
               </text>
               <effectiveTime value="20240704"/>
            </section>
         </component>
