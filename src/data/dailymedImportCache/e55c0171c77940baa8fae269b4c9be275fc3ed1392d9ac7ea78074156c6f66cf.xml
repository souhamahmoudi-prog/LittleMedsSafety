               <code code="51945-4" codeSystem="2.16.840.1.113883.6.1" displayName="PACKAGE LABEL.PRINCIPAL DISPLAY PANEL"/>
               <title>PACKAGE LABEL-PRINCIPAL DISPLAY PANEL - 119 g Bottle Label</title>
               <text>
                  <paragraph>
                     <content styleCode="bold">AUROHEALTH<br/>
                        <br/> NDC 58602-805-01<br/>
                        <br/> Compare to active ingredient <br/> of MiraLax<sup>®</sup>*<br/>
                        <br/>
                     </content>
                     <content styleCode="bold">Polyethylene Glycol 3350<br/> Powder for Oral Solution<br/>
                        <br/>
                     </content>
                     <content styleCode="bold">Osmotic Laxative</content>
                  </paragraph>
                  <list listType="unordered" styleCode="disc">
