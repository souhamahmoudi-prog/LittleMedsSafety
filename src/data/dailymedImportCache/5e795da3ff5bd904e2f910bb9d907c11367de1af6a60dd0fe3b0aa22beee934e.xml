               <code code="55106-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ACTIVE INGREDIENT SECTION"/>
               <title>
                  <content styleCode="italics">
                     <content styleCode="bold">Active ingredient (in each dose)</content>
                  </content>
               </title>
               <text>
                  <paragraph>Polyethlene Glycol 3350, 17 g</paragraph>
               </text>
               <effectiveTime value="20250609"/>
            </section>
