            <section ID="LINK_75dd4aa9-eab2-4e02-927c-e5041478d516">
               <id root="5de97d31-d319-41a2-89c1-205abfcd73e3"/>
               <code code="69718-5" codeSystem="2.16.840.1.113883.6.1" displayName="STATEMENT OF IDENTITY SECTION"/>
               <title>SUPPLEMENT FACTS</title>
               <text>
                  <paragraph>
                     <content styleCode="bold">Other Ingredients: </content>stearic acid, magnesium stearate, gum guar, dibasic calcium phosphate, croscarmellose sodium, silicon dioxide, ethylcellulose.</paragraph>
                  <paragraph>Use as a dietary supplement for pregnant or lactating women. </paragraph>
               </text>
               <effectiveTime value="20181030"/>
            </section>
