               <code code="55106-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ACTIVE INGREDIENT SECTION"/>
               <title>Active ingredients (in each packet) </title>
               <text>
                  <paragraph>Acetaminophen 500 mg</paragraph>
                  <paragraph>Dextromethorphan HBr 20 mg</paragraph>
               </text>
               <effectiveTime value="20250409"/>
            </section>
