               <code codeSystem="2.16.840.1.113883.6.1" code="34067-9" displayName="INDICATIONS &amp; USAGE SECTION"/>
               <title>
                  <content styleCode="bold">SUGGESTED USE
</content>
               </title>
               <text>
                  <paragraph>
                     <content styleCode="bold">Adults:</content> One (1) tablet daily, preferably after meals or as directed by the doctor. <content styleCode="bold">Children: </content>As directed by the doctor.</paragraph>
               </text>
