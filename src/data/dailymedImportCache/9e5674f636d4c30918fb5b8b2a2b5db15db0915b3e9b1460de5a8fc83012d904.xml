               <code code="53413-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - QUESTIONS SECTION"/>
               <title>
                  <content styleCode="italics">Questions or comments?</content>
               </title>
               <text>
                  <paragraph>
                     <content styleCode="bold">1-800-755-4008</content> (toll-free) or 
       
 
  <content styleCode="bold">215-273-8755</content> (collect)
      

 </paragraph>
               </text>
               <effectiveTime value="20200904"/>
            </section>
         </component>
