            <section ID="LINK_fb80791e-2230-44ef-91ba-7f9630552cf1">
               <id root="29f394a9-e6c7-48f2-ab48-cdb406f3d2d7"/>
               <code code="51945-4" codeSystem="2.16.840.1.113883.6.1" displayName="PACKAGE LABEL.PRINCIPAL DISPLAY PANEL"/>
               <title>Product Label</title>
               <text>
                  <renderMultiMedia referencedObject="MM1">
                     <caption>CVS HEALTH Children's Pain and Fever Grape Flavor</caption>
