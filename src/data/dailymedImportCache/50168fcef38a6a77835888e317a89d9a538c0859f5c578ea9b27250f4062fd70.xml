               <id root="5531b6bd-8b5a-f36b-e063-6294a90a6ea1"/>
               <code code="34067-9" codeSystem="2.16.840.1.113883.6.1" displayName="INDICATIONS &amp; USAGE SECTION"/>
               <title>
                  <content styleCode="italics">
                     <content styleCode="bold">Uses</content>
                  </content>
               </title>
               <text>
                  <paragraph>■ for relief of occasional sleeplessness</paragraph>
                  <paragraph>■ reduces time to fall asleep if you have difficulty falling asleep</paragraph>
               </text>
               <effectiveTime value="20260626"/>
            </section>
         </component>
