               <title>HEALTH CLAIM:</title>
               <text>
                  <paragraph>Bentivite Tablets -  Dietary Supplement</paragraph>
                  <paragraph>Dispensed by Prescription</paragraph>
                  <table width="100%">
                     <caption>Supplement Facts </caption>
                     <tbody>
                        <tr>
                           <td styleCode="Botrule Lrule Rrule Toprule">
                              <content styleCode="bold">Serving Size: 1 Tablet</content>
                              <br/>Serving per Bottle: 30</td>
                           <td styleCode="Botrule Lrule Rrule Toprule"/>
                           <td styleCode="Botrule Lrule Rrule Toprule"/>
                        </tr>
                        <tr>
                           <td styleCode="Botrule Lrule Rrule Toprule">
                              <content styleCode="bold">Amount Per Serving:</content>
                           </td>
                           <td styleCode="Botrule Lrule Rrule Toprule"/>
                           <td styleCode="Botrule Lrule Rrule Toprule">
                              <content styleCode="bold">% Daily Value</content>
                           </td>
                        </tr>
                        <tr>
                           <td styleCode="Botrule Lrule Rrule Toprule">Iron (as ferrous sulfate)</td>
                           <td styleCode="Botrule Lrule Rrule Toprule">35 mg</td>
                           <td styleCode="Botrule Lrule Rrule Toprule">194%</td>
                        </tr>
                        <tr>
                           <td styleCode="Botrule Lrule Rrule Toprule">Folic Acid</td>
