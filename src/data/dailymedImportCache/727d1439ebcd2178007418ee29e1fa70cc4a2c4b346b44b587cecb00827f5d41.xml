         <component>
            <section ID="LINK_c4517b82-279e-4bf2-b926-55c21772b33d">
               <id root="540403b2-39de-4621-a41e-7a18e9bc931e"/>
               <code code="69719-3" codeSystem="2.16.840.1.113883.6.1" displayName="HEALTH CLAIM SECTION"/>
               <title>HOW SUPPLIED</title>
               <text>
                  <paragraph>Right Step is available as a tan capsule shaped tablet. Available in bottles 30 and 100.</paragraph>
                  <paragraph>Tamper-Evident Feature: Each bottle is sealed with a tamper-evident safety seal for your protection.  Do not use if this seal is missing or broken.</paragraph>
               </text>
               <effectiveTime value="20181030"/>
            </section>
         </component>
