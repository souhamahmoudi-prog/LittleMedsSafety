               <title>
                  <content styleCode="bold">
                     <content styleCode="italics">Active ingredient (in each chewable tablet)</content>
                  </content>
               </title>
               <text>
                  <paragraph>Acetaminophen 80 mg</paragraph>
               </text>
               <effectiveTime value="20240918"/>
            </section>
