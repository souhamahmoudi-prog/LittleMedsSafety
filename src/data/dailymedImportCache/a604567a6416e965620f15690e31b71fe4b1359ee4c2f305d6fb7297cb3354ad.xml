            <section ID="id_link_60cb7643-7137-cda9-e053-2a91aa0aedd3">
               <id root="04112095-edd8-75e4-e063-6294a90a5b0d"/>
               <code code="55106-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ACTIVE INGREDIENT SECTION"/>
               <title>Active ingredient (in each dose)</title>
               <text>
                  <paragraph>Polyethylene Glycol 3350, 17 grams (cap filled to the indicated “17 GRAMS” line)</paragraph>
               </text>
               <effectiveTime value="20120425"/>
            </section>
