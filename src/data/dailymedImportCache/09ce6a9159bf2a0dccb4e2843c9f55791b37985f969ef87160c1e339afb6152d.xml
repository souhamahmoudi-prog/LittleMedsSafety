         <component>
            <section ID="ID_ffd7b40e-174b-42bd-b035-10f69c35c8fe">
               <id root="456f2b31-da7b-baaa-e063-6394a90a8454"/>
               <code code="34068-7" codeSystem="2.16.840.1.113883.6.1" displayName="DOSAGE &amp; ADMINISTRATION SECTION"/>
               <title>
                  <content styleCode="italics">Directions</content>
               </title>
               <text>
                  <list listType="unordered">
                     <item>
                        <content styleCode="bold">do not use more than directed</content>
                     </item>
                     <item>take every 6 hours, while symptoms persist</item>
                     <item>do not take more than 3 packets in 24 hours unless directed by a doctor</item>
                  </list>
                  <table width="100%">
                     <col width="72%"/>
                     <col width="28%"/>
                     <tbody>
                        <tr>
                           <td styleCode="Rrule Botrule Lrule Toprule " valign="top">
                              <list listType="ordered">
                                 <item>Age</item>
                              </list>
                           </td>
                           <td styleCode="Rrule Botrule Lrule Toprule " valign="top">
                              <list listType="ordered">
                                 <item>Dose</item>
                              </list>
                           </td>
                        </tr>
                        <tr>
                           <td styleCode="Rrule Lrule Botrule " valign="top">
                              <list listType="ordered">
                                 <item>adults and children 12 years of age and over</item>
                              </list>
                           </td>
                           <td styleCode="Rrule Lrule Botrule " valign="top">
                              <list listType="ordered">
                                 <item>One packet</item>
                              </list>
                           </td>
                        </tr>
                        <tr>
                           <td styleCode="Rrule Botrule Lrule " valign="top">
                              <list listType="ordered">
                                 <item>children under 12 years of age</item>
                              </list>
                           </td>
                           <td styleCode="Rrule Botrule Lrule " valign="top">
                              <list listType="ordered">
                                 <item>do not use</item>
                              </list>
                           </td>
                        </tr>
                     </tbody>
                  </table>
                  <list listType="unordered">
                     <item>dissolve contents of one packet into 8 oz. hot water: sip while hot. Consume the entire drink within 10-15 minutes.</item>
                     <item>if using a microwave, add contents of one packet to 8 oz. of cool water: sip briskly before and after heating.</item>
                     <item>do not overheat.</item>
                  </list>
               </text>
               <effectiveTime value="20230504"/>
            </section>
         </component>
