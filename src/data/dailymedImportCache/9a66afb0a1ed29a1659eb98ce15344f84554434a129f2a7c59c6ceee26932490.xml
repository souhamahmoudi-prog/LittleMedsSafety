         <component>
            <section ID="id_link_51d71d55-ad56-f74f-e063-6394a90abc97">
               <id root="51d71d55-ad55-f74f-e063-6394a90abc97"/>
               <code code="60561-8" codeSystem="2.16.840.1.113883.6.1" displayName="OTHER SAFETY INFORMATION"/>
               <title>
                  <content styleCode="bold">Other Information</content>
               </title>
               <text>
                  <list listType="unordered">
                     <item>store between 20 - 25° C (68-77° F)</item>
                     <item>Do not use if carton or sachet is torn, broken or punctured. </item>
                  </list>
               </text>
               <effectiveTime value="20260515"/>
            </section>
         </component>
