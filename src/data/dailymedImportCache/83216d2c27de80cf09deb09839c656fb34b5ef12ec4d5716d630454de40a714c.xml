            <section ID="LINK_01de7f3c-770f-4a28-9765-c00e68ab8284">
               <id root="d6771fff-b843-4914-9b4f-c32b232b787f"/>
               <code code="55106-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ACTIVE INGREDIENT SECTION"/>
               <title>Active ingredient (in each softgel)</title>
               <text>
                  <paragraph>Diphenhydramine HCL 50 mg</paragraph>
               </text>
               <effectiveTime value="20260721"/>
               <component>
                  <section ID="LINK_607f262d-ad60-4ec4-bad6-4b44734aac8d">
                     <id root="9665b433-24dc-46f5-b92c-0983046bdda6"/>
                     <code code="55105-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - PURPOSE SECTION"/>
                     <title>Purpose</title>
                     <text>
                        <paragraph>Nighttime sleep-aid</paragraph>
                     </text>
                     <effectiveTime value="20260721"/>
                  </section>
               </component>
            </section>
