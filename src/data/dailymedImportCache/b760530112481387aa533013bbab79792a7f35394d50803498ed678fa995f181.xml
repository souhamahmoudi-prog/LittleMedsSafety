               <code code="69718-5" codeSystem="2.16.840.1.113883.6.1" displayName="STATEMENT OF IDENTITY SECTION"/>
               <text>
                  <table width="60%">
                     <col width="40%" align="left" valign="middle"/>
                     <col width="30%" align="center" valign="middle"/>
                     <col width="30%" align="center" valign="middle"/>
                     <thead>
                        <tr>
                           <th styleCode="Lrule Rrule" colspan="3">Supplement Facts</th>
                        </tr>
                        <tr styleCode="Botrule">
                           <th styleCode="Lrule Rrule" colspan="3">Serving Size 1 Tablet</th>
                        </tr>
                        <tr>
                           <th styleCode="Lrule"/>
                           <th>Amount per Serving</th>
                           <th styleCode="Rrule">% Daily Value</th>
                        </tr>
                     </thead>
                     <tbody>
                        <tr>
                           <td styleCode="Lrule">Iron<br/>(as dried ferrous sulfate)</td>
                           <td valign="bottom">65 mg</td>
                           <td styleCode="Rrule" valign="bottom">361%</td>
                        </tr>
                     </tbody>
                  </table>
                  <paragraph>Other Ingredients: microcrystalline cellulose, dibasic calcium phosphate dihydrate, anhydrous lactose, hypromellose phthalate, croscarmellose sodium, stearic acid, magnesium stearate, triacetin, FD&amp;C Red #40 aluminum lake, colloidal silicon dioxide, titanium dioxide, hypromellose, mineral oil.</paragraph>
                  <paragraph>
                     <content styleCode="bold">Contains: Milk</content>
                  </paragraph>
               </text>
