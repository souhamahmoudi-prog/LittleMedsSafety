               <code code="42229-5" codeSystem="2.16.840.1.113883.6.1" displayName="SPL UNCLASSIFIED SECTION"/>
               <title>Additional Information Listed On Other Panels</title>
               <text>
                  <paragraph>Walgreens</paragraph>
                  <paragraph>
                     <content styleCode="bold">Compare to Theraflu® Nighttime Severe Cold &amp;Cough active ingredient††</content>
                  </paragraph>
                  <paragraph>NIGHTTIME</paragraph>
                  <paragraph>Wal-Flu
 
  <sup>®</sup>Severe

 </paragraph>
                  <paragraph>Cold &amp; Cough</paragraph>
                  <paragraph>
                     <content styleCode="bold">ACETAMINOPHEN/</content>PAIN RELIEVER/ FEVER REDUCER

 </paragraph>
                  <paragraph>DIPHENHYDRAMINE HCl /</paragraph>
                  <paragraph>ANTIHISTAMINE/ COUGH SUPPRESSANT</paragraph>
                  <paragraph>PHENYLEPHRINE HCl / NASAL DECONGESTANT</paragraph>
                  <paragraph>
                     <content styleCode="bold">ASPARTAME FREE</content>
                  </paragraph>
                  <paragraph>
