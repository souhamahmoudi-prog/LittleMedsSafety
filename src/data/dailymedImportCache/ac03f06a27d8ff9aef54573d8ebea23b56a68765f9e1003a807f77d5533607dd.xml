         <component>
            <section ID="id_link_4d6e2bdd-5267-f4b8-e063-6394a90a2bd4">
               <id root="4d6e2bdd-5266-f4b8-e063-6394a90a2bd4"/>
               <code code="55105-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - PURPOSE SECTION"/>
               <text>
                  <paragraph>Uses
  <br/>
Temporarily relieves occasional
  <br/>
minor irritation and pain
  <br/>
associated with sore mouth and
  <br/>
sore throat.
 </paragraph>
               </text>
               <effectiveTime value="20260320"/>
            </section>
         </component>
         <component>
            <section ID="id_link_4d6e3443-7a2e-280b-e063-6394a90a1ea6">
               <id root="4d6e3443-7a2d-280b-e063-6394a90a1ea6"/>
               <code code="50565-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - KEEP OUT OF REACH OF CHILDREN SECTION"/>
               <text>
                  <paragraph>Keep out of reach of children</paragraph>
               </text>
               <effectiveTime value="20260320"/>
            </section>
         </component>
         <component>
            <section ID="id_link_4d6e36dc-c76a-e9c2-e063-6394a90ac247">
               <id root="4d6e36dc-c769-e9c2-e063-6394a90ac247"/>
               <code code="34068-7" codeSystem="2.16.840.1.113883.6.1" displayName="DOSAGE &amp; ADMINISTRATION SECTION"/>
               <text>
                  <paragraph>Apply a small amount
  <br/>
of gel to the affected area of the
  <br/>
mouth. Gargle, swish around, or
  <br/>
allow to remain in place at least 1
  <br/>
minute and then spit out. Use up
  <br/>
to 4 times daily or as directed by a
  <br/>
dentist or doctor.
 </paragraph>
               </text>
               <effectiveTime value="20260320"/>
            </section>
         </component>
         <component>
            <section ID="id_link_4d6e38d9-dbf0-e9f8-e063-6394a90a5408">
               <id root="4d6e38d9-dbef-e9f8-e063-6394a90a5408"/>
               <code code="34071-1" codeSystem="2.16.840.1.113883.6.1" displayName="WARNINGS SECTION"/>
               <text>
                  <paragraph>Warnings
  <br/>
Do not use
  <br/>
In children under 2 years of age
  <br/>
unless directed by a doctor
  <br/>
Sore throat warnings
  <br/>
1If sore throat is severe, persists for
  <br/>
more than 2 days, is accompanied
  <br/>
or followed by fever, headache,
  <br/>
rash, swelling, nausea, or
  <br/>
vomiting, consult a doctor
  <br/>
promptly. These may be serious.
 </paragraph>
               </text>
               <effectiveTime value="20260320"/>
            </section>
         </component>
         <component>
            <section ID="id_link_4d6e2bdd-5269-f4b8-e063-6394a90a2bd4">
               <id root="4d6e2bdd-5268-f4b8-e063-6394a90a2bd4"/>
               <code code="34067-9" codeSystem="2.16.840.1.113883.6.1" displayName="INDICATIONS &amp; USAGE SECTION"/>
               <text>
                  <paragraph>Directions
  <br/>
Adults and children 2 years of ageand older: Apply a small amountof gel to the affected area of themouth. Gargle, swish around, orallow to remain in place at least 1minute and then spit out. Use upto 4 times daily or as directed by adentist or doctor.Children under 12 years of ageshould be supervised in the use of
  <br/>
this product.Children under 2 years of age:Consult a dentist or doctor.
 </paragraph>
               </text>
               <effectiveTime value="20260320"/>
            </section>
         </component>
