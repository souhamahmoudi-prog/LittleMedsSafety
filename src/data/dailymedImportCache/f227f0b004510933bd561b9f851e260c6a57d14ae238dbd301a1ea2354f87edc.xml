               <code code="51945-4" codeSystem="2.16.840.1.113883.6.1" displayName="PACKAGE LABEL.PRINCIPAL DISPLAY PANEL"/>
               <title>Principal Display Panel</title>
               <text>
                  <paragraph>Compare to the Active Ingredient in Maximum Strength Pepcid<sup>®</sup> AC</paragraph>
                  <paragraph>berkley jensen<sub>®</sub>
                  </paragraph>
                  <paragraph>MAXIMUM STRENGTH</paragraph>
                  <paragraph>FAMOTIDINE TABLETS, 20mg</paragraph>
                  <paragraph>ACID REDUCER</paragraph>
                  <paragraph>JUST ONE TABLET PREVENTS &amp; RELIEVES HEARTBURN DUE TO ACID INDIGESTION</paragraph>
                  <paragraph>ACTUAL SIZE</paragraph>
