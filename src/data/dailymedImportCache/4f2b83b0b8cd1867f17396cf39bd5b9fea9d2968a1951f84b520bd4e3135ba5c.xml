               <title/>
               <text>
                  <paragraph>Questions or comments? (888) 221-3496 M-F 9 am to 5 pm 
  <br/>  you may also use this number to report serious adverse events associated with the use of this product
 </paragraph>
               </text>
               <effectiveTime value="20140618"/>
            </section>
         </component>
