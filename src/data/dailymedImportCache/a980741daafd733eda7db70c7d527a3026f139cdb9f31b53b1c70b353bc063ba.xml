         <component>
            <section ID="Ld37ccf45-2bb5-49bd-966a-74167d292872">
               <id root="498adc5b-0e68-f64c-e063-6394a90a62ea"/>
               <code code="50567-7" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - WHEN USING SECTION"/>
               <title>
                  <content styleCode="bold">When using this product</content>
                  <br/>
                  <br/>  ● drowsiness may occur 
 <br/>  ● avoid alcoholic drinks 
 <br/>  ● alcohol, sedatives, and tranquilizers may increase drowsiness 
 <br/>  ● be careful when driving a motor vehicle or operating machinery
</title>
               <text>
                  <paragraph/>
               </text>
               <effectiveTime value="20240124"/>
            </section>
         </component>
         <component>
            <section ID="L6b08d58e-26a9-425d-88b9-898a4bf8ddce">
               <id root="498adc5b-0e69-f64c-e063-6394a90a62ea"/>
               <code code="50566-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - STOP USE SECTION"/>
               <title>
                  <content styleCode="bold">Stop use and ask a doctor if</content>an allergic reaction to this product occurs. Seek medical help right away.
</title>
               <text>
                  <paragraph/>
               </text>
               <effectiveTime value="20240124"/>
            </section>
         </component>
