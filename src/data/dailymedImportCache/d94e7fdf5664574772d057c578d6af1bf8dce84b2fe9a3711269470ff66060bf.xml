                     <thead>
                        <tr>
                           <th styleCode="Lrule Rrule" colspan="2" align="left">Supplement Facts</th>
                        </tr>
                        <tr styleCode="Botrule">
                           <th styleCode="Lrule Rrule" colspan="2" align="left">Serving Size: 1 Tablet</th>
                        </tr>
                        <tr>
                           <th styleCode="Lrule" align="left">Amount Per Serving</th>
                           <th styleCode="Rrule" align="right">% Daily Value</th>
                        </tr>
                     </thead>
                     <tbody>
                        <tr styleCode="First Last">
                           <td styleCode="Lrule" align="left">Iron (as dried ferrous sulfate) 65 mg</td>
                           <td styleCode="Rrule" align="right">361%</td>
                        </tr>
                     </tbody>
                  </table>
                  <paragraph>
                     <content styleCode="bold">Other ingredients:</content> carmine, croscarmellose sodium, dicalcium phosphate, hypromellose, isomalt, magnesium stearate, methacrylic acid copolymer, microcrystalline cellulose, riboflavin, rice starch, silicon dioxide, sodium lauryl sulfate, sodium starch glycolate, stearic acid, talc, triacetin, triglycerides</paragraph>
