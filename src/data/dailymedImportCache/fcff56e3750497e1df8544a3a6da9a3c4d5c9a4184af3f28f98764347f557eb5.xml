               <title>
                  <content styleCode="italics">Other information</content>
               </title>
               <text>
                  <list listType="unordered">
                     <item>
                        <content styleCode="bold">each packet contains</content>: potassium 6 mg
 
  </item>
                     <item>store at room temperature. Protect from excessive heat and moisture.</item>
                  </list>
               </text>
               <effectiveTime value="20230504"/>
            </section>
         </component>
