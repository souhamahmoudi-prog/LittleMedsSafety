               <component>
                  <section ID="id_link_852c4113-7f72-1148-e053-2991aa0a7659">
                     <id root="13cbee81-e2f2-f362-e063-6294a90a29c8"/>
                     <code code="55105-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - PURPOSE SECTION"/>
                     <text>
                        <table border="0" width="100%">
                           <tbody>
                              <tr>
                                 <td>
                                    <content styleCode="italics">
                                       <content styleCode="bold">Active ingredients (in each packet)</content>
                                    </content>
                                 </td>
                                 <td>
                                    <content styleCode="italics">
                                       <content styleCode="bold">Purposes</content>
                                    </content>
                                 </td>
                              </tr>
                              <tr>
                                 <td>
                                    <content styleCode="bold">Acetaminophen 325 mg…………………………………</content>
                                 </td>
                                 <td>
                                    <content styleCode="bold">Pain reliever/ fever reducer </content>
                                 </td>
                              </tr>
                              <tr>
                                 <td>Dextromethorphan HBr 10 mg…………………………...</td>
                                 <td>Cough suppressant</td>
                              </tr>
                              <tr>
                                 <td>
                                    <paragraph>Guaifenesin 200 mg .....................................</paragraph>
                                 </td>
                                 <td>
                                    <paragraph>Expectorant</paragraph>
                                 </td>
                              </tr>
                              <tr>
                                 <td>Phenylephrine HCL 5 mg…….…………………………..</td>
                                 <td>
                                    <paragraph>Nasal decongestant</paragraph>
                                 </td>
                              </tr>
                           </tbody>
                        </table>
                        <paragraph/>
                     </text>
