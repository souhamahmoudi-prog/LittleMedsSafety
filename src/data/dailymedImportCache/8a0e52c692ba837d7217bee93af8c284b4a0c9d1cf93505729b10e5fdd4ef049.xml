               <code codeSystem="2.16.840.1.113883.6.1" code="51945-4" displayName="PACKAGE LABEL.PRINCIPAL DISPLAY PANEL"/>
               <title>Principal Display</title>
               <text>
                  <renderMultiMedia referencedObject="ID_95cdf7b3-d53a-49ad-9dc9-560beee8c604" ID="id331352978"/>
                  <paragraph>Compare to the active ingredients in Theraflu Multi-Symptom Severe Cold*</paragraph>
                  <paragraph>NDC 55319-547-06</paragraph>
                  <paragraph>MULTI-SYMPTOM</paragraph>
                  <paragraph>
                     <content styleCode="bold">SEVERE COLD</content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">Acetaminophen</content>
                  </paragraph>
                  <paragraph>Pain Reliever/ Fever Reducer</paragraph>
                  <paragraph>
                     <content styleCode="bold">Dextromethorphan HBr</content>
                  </paragraph>
                  <paragraph>Cough Suppressant</paragraph>
                  <paragraph>
