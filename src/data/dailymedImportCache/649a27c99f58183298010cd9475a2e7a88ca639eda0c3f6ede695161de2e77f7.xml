         <component>
            <section ID="id_link_28ed332e-2d27-caa9-e063-6294a90adfa0">
               <id root="552ce687-b273-6668-e063-6394a90a347b"/>
               <code code="34068-7" codeSystem="2.16.840.1.113883.6.1" displayName="DOSAGE &amp; ADMINISTRATION SECTION"/>
               <title>
                  <content styleCode="italics">
                     <content styleCode="bold">Directions</content>
                  </content>
               </title>
               <text>
                  <list listType="unordered">
                     <item>do not exceed 12 vials in a 24-hour period</item>
                     <item>follow the “Easy to Use” instructions on pouch</item>
                  </list>
                  <paragraph/>
                  <table border="0" width="100%">
                     <tbody>
                        <tr>
                           <td>
                              <content styleCode="bold">Age</content>
                           </td>
                           <td>
                              <content styleCode="bold">Dose</content>
                           </td>
                        </tr>
                        <tr>
                           <td>Adults and children 12 years of age and older</td>
                           <td>take 1 - 2 vials every 4-6 hours</td>
                        </tr>
                        <tr>
                           <td>children under 12 years of age</td>
                           <td>do not use</td>
                        </tr>
                     </tbody>
                  </table>
                  <paragraph/>
               </text>
               <effectiveTime value="20260101"/>
            </section>
         </component>
         <component>
            <section ID="id_link_28ed332e-2d2d-caa9-e063-6294a90adfa0">
               <id root="552ce687-b274-6668-e063-6394a90a347b"/>
               <code code="60561-8" codeSystem="2.16.840.1.113883.6.1" displayName="OTHER SAFETY INFORMATION"/>
               <title>
                  <content styleCode="italics">
                     <content styleCode="bold">Other information</content>
                  </content>
               </title>
               <text>
                  <list listType="unordered">
                     <item>each 10 mL vial contains:
  
   <content styleCode="bold">sodium 4mg</content>
                     </item>
                     <item>store between 68-77°F (20-25°C)</item>
                     <item>do not use if pouch has been torn open or vial is punctured or open</item>
                  </list>
               </text>
               <effectiveTime value="20260101"/>
            </section>
         </component>
