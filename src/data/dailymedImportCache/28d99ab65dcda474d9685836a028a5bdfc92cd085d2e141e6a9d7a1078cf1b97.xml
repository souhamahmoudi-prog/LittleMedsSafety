            <section ID="L717973ca-ceef-4e2b-8f94-953cce1e603e">
               <id root="cdbfbf05-d242-4942-a242-b4687b0c10db"/>
               <code code="55106-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ACTIVE INGREDIENT SECTION"/>
               <title>
                  <content styleCode="italics">Active ingredients (in each caplet)</content>
               </title>
               <text>
                  <paragraph>Acetaminophen 500 mg<br/>Diphenhydramine HCl 25 mg</paragraph>
               </text>
