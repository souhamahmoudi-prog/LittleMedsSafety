         <component>
            <section>
               <id root="2203733e-76a2-4a4a-9197-d0bd48bf75e5"/>
               <code code="34068-7" codeSystem="2.16.840.1.113883.6.1" displayName="DOSAGE &amp; ADMINISTRATION SECTION"/>
               <title>Directions</title>
               <text>
                  <list listType="unordered" styleCode="Square">
                     <item>may be taken with or without water</item>
                     <item>chew or crush tablets completely before swallowing</item>
                  </list>
                  <table width="50%" styleCode="Noautorules">
                     <col width="30%" align="left" valign="top"/>
                     <col width="70%" align="left" valign="top"/>
                     <tbody>
                        <tr styleCode="Botrule">
                           <td styleCode="Rrule Toprule">adults and children 6 years and over</td>
                           <td styleCode="Toprule">Chew and swallow 1 tablet (10 mg) once daily; do not take more than 1 tablet (10 mg) in 24 hours. A 5 mg product may be appropriate for less severe symptoms.</td>
                        </tr>
                        <tr styleCode="Botrule">
                           <td styleCode="Rrule">adults 65 years and over</td>
                           <td>ask a doctor</td>
                        </tr>
                        <tr styleCode="Botrule">
                           <td styleCode="Rrule">children under 6 years of age</td>
                           <td>ask a doctor</td>
                        </tr>
                        <tr>
                           <td styleCode="Rrule">consumers with liver or kidney disease</td>
                           <td>ask a doctor</td>
                        </tr>
                     </tbody>
                  </table>
               </text>
               <effectiveTime value="20210208"/>
            </section>
         </component>
         <component>
            <section>
               <id root="95c956ba-44e6-4e31-8b0d-6c48453a7150"/>
               <code code="44425-7" codeSystem="2.16.840.1.113883.6.1" displayName="STORAGE AND HANDLING SECTION"/>
               <title>Other information</title>
               <text>
                  <list listType="unordered" styleCode="Square">
                     <item>store between 20° to 25°C (68° to 77°F)</item>
                     <item>
                        <content styleCode="bold">do not use if blister unit is torn or broken</content>
                     </item>
                  </list>
               </text>
               <effectiveTime value="20210208"/>
            </section>
         </component>
