            <section ID="ID_8c7d1e74-4aee-4d12-a604-f9b161865b08">
               <id root="8c7d1e74-4aee-4d12-a604-f9b161865b08"/>
               <code code="55106-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ACTIVE INGREDIENT SECTION"/>
               <title>Active ingredients (in each 30 mL)</title>
               <text>
                  <paragraph>Acetaminophen 650 mg</paragraph>
                  <paragraph>Dextromethorphan HBr 20 mg</paragraph>
                  <paragraph>Doxylamine succinate 12.5 mg</paragraph>
                  <paragraph>Phenylephrine HCl 10 mg</paragraph>
               </text>
               <effectiveTime value="20200218"/>
            </section>
