               <code code="69718-5" codeSystem="2.16.840.1.113883.6.1" displayName="STATEMENT OF IDENTITY SECTION"/>
               <title>
                  <content styleCode="bold">Supplement Facts</content>
               </title>
               <text>
                  <paragraph>Serving size: 1 Tablet</paragraph>
                  <paragraph>Servings Per Container: 100 and 1,000</paragraph>
                  <table width="100%">
                     <caption/>
                     <tbody>
                        <tr>
                           <td/>
                           <td>
                              <content styleCode="bold">Amount Per Serving  </content>
                           </td>
                           <td>
                              <content styleCode="bold"> % Daily Value</content>
                           </td>
                        </tr>
                        <tr>
                           <td> Iron (as dried ferrous sulfate)</td>
                           <td> 65 mg</td>
                           <td>361%</td>
                        </tr>
                     </tbody>
                  </table>
                  <paragraph>
                     <content styleCode="bold">Other Ingredients: </content>Croscarmellose sodium, dibasic calcium phosphate dihydrate, FD&amp;C Red No. 40, hypromellose, magnesium stearate, methacrylic acid, microcrystalline cellulose, polyethylene glycol, silicon dioxide, stearic acid, titanium dioxide, triacetin.</paragraph>
               </text>
               <effectiveTime value="20251209"/>
            </section>
