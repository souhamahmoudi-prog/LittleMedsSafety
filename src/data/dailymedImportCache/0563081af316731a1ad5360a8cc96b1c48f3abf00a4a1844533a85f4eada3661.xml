                     <content styleCode="italics">Active ingredient (in each chewable tablet)</content>
                  </content>
               </title>
               <text>
                  <paragraph>Acetaminophen 160 mg</paragraph>
               </text>
               <effectiveTime value="20200420"/>
            </section>
