               <title>
                  <content styleCode="italics">
                     <content styleCode="bold">Warnings</content>
                  </content>
               </title>
               <text>
                  <paragraph>________</paragraph>
               </text>
               <effectiveTime value="20260626"/>
               <component>
                  <section ID="id_link_0c547d25-bae3-c9b2-e063-6394a90a300b">
                     <id root="5531a0b1-38b8-d300-e063-6294a90a21db"/>
                     <code code="50570-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - DO NOT USE SECTION"/>
                     <title>
                        <content styleCode="bold">Do not use </content>
                     </title>
                     <text>
                        <paragraph>■ with any other product containing diphenhydramine, even one used on skin</paragraph>
                        <paragraph>■ in children under 12 years of age</paragraph>
                     </text>
                     <effectiveTime value="20260626"/>
                  </section>
               </component>
               <component>
                  <section ID="id_link_0c5488ec-3c1b-c91f-e063-6394a90aec0f">
                     <id root="5531a5f7-873e-6909-e063-6394a90a20af"/>
                     <code code="50569-3" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ASK DOCTOR SECTION"/>
                     <title>
                        <content styleCode="bold">Ask a doctor before use if you have</content>
                     </title>
                     <text>
                        <paragraph>■ have a breathing problem such as emphysema or chronic bronchitis</paragraph>
                        <paragraph>■ have glaucoma</paragraph>
                        <paragraph>■ have trouble urinating due to an enlarged prostate gland</paragraph>
                        <paragraph>■ are taking sedatives or tranquilizers</paragraph>
                     </text>
                     <effectiveTime value="20260626"/>
                  </section>
               </component>
               <component>
                  <section ID="id_link_0c5488ec-3c20-c91f-e063-6394a90aec0f">
                     <id root="5531a5f7-873f-6909-e063-6394a90a20af"/>
                     <code code="50567-7" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - WHEN USING SECTION"/>
                     <title>
                        <content styleCode="bold">When using this product</content>
                     </title>
                     <text>
                        <paragraph>■ avoid alcohol beverages</paragraph>
                     </text>
                     <effectiveTime value="20231212"/>
                  </section>
               </component>
               <component>
                  <section ID="id_link_0c5488ec-3c22-c91f-e063-6394a90aec0f">
                     <id root="5531abd6-23fc-7341-e063-6394a90afa3a"/>
                     <code code="50566-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - STOP USE SECTION"/>
                     <title>
                        <content styleCode="bold">Stop use and ask a doctor if</content>
                     </title>
                     <text>
                        <paragraph>■ sleeplessness persists continuously for more than 2 weeks. Insomnia may be a symptom of serious underlying medical illness.</paragraph>
                     </text>
                     <effectiveTime value="20260626"/>
                  </section>
               </component>
