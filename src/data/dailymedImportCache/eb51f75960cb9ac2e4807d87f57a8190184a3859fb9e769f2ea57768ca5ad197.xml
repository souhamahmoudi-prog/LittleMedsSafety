            <section ID="id_link_0fe0715c-12f8-a652-e063-6394a90ad418">
               <id root="56c0b7ae-521c-2855-e063-6394a90aab48"/>
               <code code="42229-5" codeSystem="2.16.840.1.113883.6.1" displayName="SPL UNCLASSIFIED SECTION"/>
               <text>
                  <paragraph>curistrelief.com</paragraph>
                  <paragraph>
                     <content styleCode="bold">Tips For Managing Heartburn</content>
                  </paragraph>
                  <list listType="unordered">
                     <item>Do not lie flat or ben dover after eating</item>
                     <item>Do not wear tight fitting clothing around the abdomen</item>
                     <item>Do not eat before bedtime</item>
                     <item>Raise the head of your bed</item>
                     <item>Avoid heartburn causing foods such as rivh, sp[icy, fatty or fried food, chocolate, caffeine, alcohol, and certain fruits and vegetables</item>
                     <item>Eat slowly and avoid big meals</item>
                     <item>If overweight, lose weight</item>
                     <item>Quit smoking</item>
                  </list>
                  <paragraph/>
                  <paragraph>
                     <content styleCode="bold">Important: Read all directions and warnings before use.</content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">Tamper Evident:</content>
                     <content styleCode="bold">Do not use if imprinted inner safety seal is torn or missing</content>
                  </paragraph>
               </text>
               <effectiveTime value="20240126"/>
            </section>
         </component>
