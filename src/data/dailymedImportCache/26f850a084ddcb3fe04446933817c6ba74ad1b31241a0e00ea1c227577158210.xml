                     <content styleCode="italics">Active ingredient (in each 30 mL)</content>
                  </content>
               </title>
               <text>
                  <paragraph>Acetaminophen 1,000 mg<br/>
                  </paragraph>
               </text>
               <effectiveTime value="20260701"/>
            </section>
