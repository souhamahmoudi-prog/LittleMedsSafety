---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  carbohydrateBases,
  medicationCarbohydrateReferenceRecords,
  sourceTypes,
  unknownQuantityMessage,
  verificationStatuses,
} from '../../data/medicationCarbohydrateReference';

const manufacturers = [...new Set(medicationCarbohydrateReferenceRecords.map((record) => record.manufacturer))].sort();
const dosageForms = [...new Set(medicationCarbohydrateReferenceRecords.map((record) => record.dosageForm))].sort();
---

<BaseLayout
  title="Pediatric Medication Carbohydrate Reference | LittleMeds Safety"
  description="Look up published manufacturer-specific carbohydrate content for medication products used in children receiving ketogenic dietary therapy."
>
  <main class="reference-page">
    <section class="reference-hero">
      <div class="reference-container">
        <a class="reference-brand" href="/" aria-label="LittleMeds Safety home">
          <span class="reference-brand__mark" aria-hidden="true">LMS</span>
          <span>LittleMeds Safety</span>
        </a>
        <p class="reference-eyebrow">Medication Reference</p>
        <h1>Pediatric Medication Carbohydrate Reference</h1>
        <p class="reference-lede">
          Search for published carbohydrate content of an exact medication product.
        </p>
        <div class="reference-notice">
          This reference does not calculate dose exposure, assess ketogenic-diet
          compatibility, classify medications as safe or unsafe, estimate missing
          values, or apply one manufacturer's value to another product.
        </div>
      </div>
    </section>

    <section class="reference-workspace">
      <div class="reference-container reference-grid">
        <section class="lookup-panel" aria-labelledby="searchTitle">
          <div class="section-title">
            <p class="reference-eyebrow">Search</p>
            <h2 id="searchTitle">Find an exact product</h2>
            <p>Search by generic name, brand name, manufacturer, strength, dosage form, or NDC. Select the exact product before using a record.</p>
          </div>

          <label class="search-field">
            Product search
            <input
              id="productSearch"
              type="search"
              autocomplete="off"
              placeholder="Example: acetaminophen, labeler, 160 mg/5 mL, NDC"
            />
          </label>

          <div class="filter-grid" aria-label="Product filters">
            <label>
              Dosage form
              <select id="dosageFormFilter">
                <option value="">All dosage forms</option>
                {dosageForms.map((form) => <option value={form}>{form}</option>)}
              </select>
            </label>
            <label>
              Manufacturer
              <select id="manufacturerFilter">
                <option value="">All manufacturers</option>
                {manufacturers.map((manufacturer) => <option value={manufacturer}>{manufacturer}</option>)}
              </select>
            </label>
            <label>
              Quantitative value available
              <select id="quantitativeFilter">
                <option value="">All records</option>
                <option value="yes">Published value available</option>
                <option value="no">No published quantity</option>
              </select>
            </label>
            <label>
              Source type
              <select id="sourceTypeFilter">
                <option value="">All source types</option>
                {sourceTypes.map((sourceType) => <option value={sourceType}>{sourceType}</option>)}
              </select>
            </label>
          </div>

          <div class="result-meta" id="resultMeta" aria-live="polite"></div>
          <div class="result-list" id="resultList"></div>
        </section>

        <aside class="detail-panel" aria-labelledby="detailTitle">
          <div class="section-title">
            <p class="reference-eyebrow">Exact Product Detail</p>
            <h2 id="detailTitle">Select a product record</h2>
          </div>
          <div id="detailContent" class="detail-content">
            <p class="empty-message">No product selected.</p>
          </div>
          <div class="detail-actions">
            <button class="button button-primary" type="button" id="printRecord" disabled>Print Selected Record</button>
          </div>
        </aside>
      </div>
    </section>
  </main>
</BaseLayout>

<script define:vars={{ medicationCarbohydrateReferenceRecords, unknownQuantityMessage }}>
  const state = {
    selectedRecordId: '',
  };

  const resultList = document.querySelector('#resultList');
  const resultMeta = document.querySelector('#resultMeta');
  const detailContent = document.querySelector('#detailContent');
  const printButton = document.querySelector('#printRecord');
  const searchInput = document.querySelector('#productSearch');
  const dosageFormFilter = document.querySelector('#dosageFormFilter');
  const manufacturerFilter = document.querySelector('#manufacturerFilter');
  const quantitativeFilter = document.querySelector('#quantitativeFilter');
  const sourceTypeFilter = document.querySelector('#sourceTypeFilter');

  function escapeHtml(value) {
    return String(value ?? '').replace(/[&<>"']/g, (char) => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#39;',
    }[char]));
  }

  function displayAmount(record) {
    if (record.carbohydrateAmount === null) return unknownQuantityMessage;
    return `${Number(record.carbohydrateAmount.toFixed(6)).toString()} ${record.carbohydrateBasis}`;
  }

  function hasPublishedQuantity(record) {
    return record.carbohydrateAmount !== null && record.verificationStatus === 'Published quantitative value';
  }

  function matchesRecord(record) {
    const query = searchInput.value.trim().toLowerCase();
    const searchable = [
      record.genericName,
      record.brandName,
      record.manufacturer,
      record.strength,
      record.dosageForm,
      record.ndc,
      record.packageDescription,
    ].join(' ').toLowerCase();
    if (query && !searchable.includes(query)) return false;
    if (dosageFormFilter.value && record.dosageForm !== dosageFormFilter.value) return false;
    if (manufacturerFilter.value && record.manufacturer !== manufacturerFilter.value) return false;
    if (sourceTypeFilter.value && record.sourceType !== sourceTypeFilter.value) return false;
    if (quantitativeFilter.value === 'yes' && !hasPublishedQuantity(record)) return false;
    if (quantitativeFilter.value === 'no' && hasPublishedQuantity(record)) return false;
    return true;
  }

  function filteredRecords() {
    return medicationCarbohydrateReferenceRecords.filter(matchesRecord);
  }

  function selectRecord(recordId) {
    state.selectedRecordId = recordId;
    renderResults();
    renderDetail();
  }

  function renderResults() {
    const matches = filteredRecords();
    resultMeta.textContent = `${matches.length} product-specific record${matches.length === 1 ? '' : 's'} found.`;

    if (!matches.length) {
      resultList.innerHTML = `
        <div class="empty-state">
          <strong>No verified product-specific carbohydrate record is currently available.</strong>
          <span>Verify the exact manufacturer, formulation, and NDC using product labeling, manufacturer medical information, or an approved ketogenic medication reference.</span>
        </div>
      `;
      return;
    }

    resultList.innerHTML = matches.map((record) => `
      <button class="result-card ${state.selectedRecordId === record.id ? 'is-selected' : ''}" type="button" data-record-id="${escapeHtml(record.id)}">
        <span class="record-flags">
          ${record.isDemonstration ? '<b>Not for clinical use</b>' : ''}
          <b>${escapeHtml(record.verificationStatus)}</b>
        </span>
        <strong>${escapeHtml(record.genericName)} ${escapeHtml(record.strength)}</strong>
        <span>${escapeHtml(record.brandName)} | ${escapeHtml(record.manufacturer)} | ${escapeHtml(record.dosageForm)}</span>
        <span>NDC ${escapeHtml(record.ndc)} | ${escapeHtml(record.packageDescription)}</span>
        <small>${escapeHtml(displayAmount(record))}</small>
      </button>
    `).join('');
  }

  function detailRows(record) {
    return [
      ['Generic name', record.genericName],
      ['Brand name', record.brandName],
      ['Manufacturer or labeler', record.manufacturer],
      ['Strength', record.strength],
      ['Dosage form', record.dosageForm],
      ['NDC', record.ndc],
      ['Package description', record.packageDescription],
      ['Published carbohydrate amount', displayAmount(record)],
      ['Unit or basis', record.carbohydrateAmount === null ? record.carbohydrateBasis : record.carbohydrateBasis],
      ['Quantified carbohydrate ingredient', record.carbohydrateIngredient || 'Not stated'],
      ['Source name', record.sourceName],
      ['Source type', record.sourceType],
      ['Source reference', record.sourceReference],
      ['Source publication or review date', record.sourceDate],
      ['Record verification date', record.verifiedDate],
      ['Verification status', record.verificationStatus],
      ['Notes', record.notes],
    ];
  }

  function renderDetail() {
    const record = medicationCarbohydrateReferenceRecords.find((item) => item.id === state.selectedRecordId);
    printButton.disabled = !record;

    if (!record) {
      detailContent.innerHTML = '<p class="empty-message">No product selected.</p>';
      return;
    }

    detailContent.innerHTML = `
      ${record.isDemonstration ? '<div class="demo-banner">Not for clinical use. Demonstration record only.</div>' : ''}
      <dl class="record-detail">
        ${detailRows(record).map(([label, value]) => `<div><dt>${escapeHtml(label)}</dt><dd>${escapeHtml(value)}</dd></div>`).join('')}
      </dl>
      <div class="reference-disclaimer">
        Verify the exact manufacturer, strength, formulation, and NDC before use.
        Do not estimate missing values or apply one manufacturer's value to a
        different product. This reference does not determine ketogenic-diet
        compatibility or classify a medication as safe or unsafe.
      </div>
    `;
  }

  resultList.addEventListener('click', (event) => {
    const card = event.target.closest('[data-record-id]');
    if (!card) return;
    selectRecord(card.dataset.recordId);
  });

  [searchInput, dosageFormFilter, manufacturerFilter, quantitativeFilter, sourceTypeFilter].forEach((input) => {
    input.addEventListener('input', renderResults);
    input.addEventListener('change', renderResults);
  });

  printButton.addEventListener('click', () => {
    if (!state.selectedRecordId) return;
    window.print();
  });

  renderResults();
</script>

<style is:global>
  .reference-page {
    background: #f7f9fb;
    color: #24313a;
  }

  .reference-container {
    width: min(100% - 40px, 1180px);
    margin-inline: auto;
  }

  .reference-hero {
    border-bottom: 1px solid #dbe4ea;
    background: linear-gradient(135deg, #eef5f8 0%, #f7f9fb 76%);
    padding: 30px 0 42px;
  }

  .reference-brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 34px;
    color: #123b5d;
    font-weight: 800;
  }

  .reference-brand__mark {
    display: inline-grid;
    width: 42px;
    height: 42px;
    place-items: center;
    border-radius: 8px;
    background: #123b5d;
    color: #fff;
    font-size: 0.78rem;
  }

  .reference-eyebrow {
    margin: 0 0 10px;
    color: #2e7d68;
    font-size: 0.78rem;
    font-weight: 850;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .reference-hero h1 {
    max-width: 920px;
    margin-bottom: 18px;
    color: #123b5d;
    font-size: clamp(2.3rem, 5vw, 4rem);
    line-height: 1.04;
  }

  .reference-lede {
    max-width: 820px;
    color: #40515d;
    font-size: 1.12rem;
  }

  .reference-notice,
  .reference-disclaimer {
    max-width: 980px;
    border: 1px solid rgba(46, 125, 104, 0.22);
    border-left: 5px solid #2e7d68;
    border-radius: 8px;
    background: #f5fbf8;
    padding: 18px 20px;
    font-weight: 720;
  }

  .reference-workspace {
    padding: 34px 0 64px;
  }

  .reference-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(360px, 0.9fr);
    gap: 24px;
    align-items: start;
  }

  .lookup-panel,
  .detail-panel {
    border: 1px solid #d6e2e9;
    border-radius: 8px;
    background: #fff;
    padding: 28px;
    box-shadow: 0 14px 34px rgba(18, 59, 93, 0.07);
  }

  .detail-panel {
    position: sticky;
    top: 24px;
  }

  .section-title h2,
  .section-title h3 {
    margin-bottom: 10px;
    color: #123b5d;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  .section-title h2 {
    font-size: clamp(1.7rem, 3vw, 2.3rem);
  }

  .search-field,
  .filter-grid label {
    display: grid;
    gap: 7px;
    color: #123b5d;
    font-weight: 800;
  }

  .search-field {
    margin: 20px 0;
  }

  .filter-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  input,
  select {
    width: 100%;
    min-height: 46px;
    border: 1px solid #cbd9e2;
    border-radius: 8px;
    background: #fff;
    color: #24313a;
    font: inherit;
    padding: 10px 12px;
  }

  input:focus-visible,
  select:focus-visible,
  button:focus-visible {
    outline: 3px solid rgba(46, 125, 104, 0.34);
    outline-offset: 3px;
  }

  .result-meta {
    margin: 20px 0 12px;
    color: #60717d;
    font-weight: 800;
  }

  .result-list {
    display: grid;
    gap: 12px;
  }

  .result-card {
    display: grid;
    gap: 6px;
    cursor: pointer;
    border: 1px solid #d6e2e9;
    border-radius: 8px;
    background: #fff;
    color: #123b5d;
    padding: 16px;
    text-align: left;
  }

  .result-card.is-selected {
    border-color: #2b6f9f;
    background: #eef5f8;
  }

  .record-flags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .record-flags b,
  .demo-banner {
    width: fit-content;
    border-radius: 999px;
    background: #fff0d8;
    color: #7a4c00;
    padding: 4px 9px;
    font-size: 0.78rem;
    font-weight: 850;
    text-transform: uppercase;
  }

  .result-card strong {
    font-size: 1.1rem;
  }

  .result-card small {
    color: #2e7d68;
    font-weight: 850;
  }

  .empty-state,
  .empty-message {
    border: 1px dashed #bfd2dd;
    border-radius: 8px;
    background: #f8fbfd;
    padding: 18px;
    color: #60717d;
    font-weight: 750;
  }

  .empty-state {
    display: grid;
    gap: 8px;
  }

  .empty-state strong {
    color: #123b5d;
  }

  .record-detail {
    display: grid;
    gap: 12px;
    margin: 0;
  }

  .record-detail div {
    min-width: 0;
    overflow-wrap: anywhere;
    border-bottom: 1px solid #e6eef3;
    padding-bottom: 10px;
  }

  .record-detail dt {
    color: #60717d;
    font-size: 0.78rem;
    font-weight: 850;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .record-detail dd {
    margin: 3px 0 0;
    color: #123b5d;
    font-weight: 820;
  }

  .demo-banner,
  .reference-disclaimer {
    margin-bottom: 16px;
  }

  .detail-actions {
    display: flex;
    gap: 12px;
    margin-top: 22px;
  }

  .button {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 8px;
    cursor: pointer;
    padding: 0 18px;
    font: inherit;
    font-weight: 850;
  }

  .button-primary {
    background: #123b5d;
    color: #fff;
  }

  .button:disabled {
    cursor: not-allowed;
    opacity: 0.55;
  }

  @media (max-width: 980px) {
    .reference-grid,
    .filter-grid {
      grid-template-columns: 1fr;
    }

    .detail-panel {
      position: static;
    }
  }

  @media (max-width: 680px) {
    .reference-container {
      width: min(100% - 28px, 1180px);
    }

    .lookup-panel,
    .detail-panel {
      padding: 22px;
    }

    .detail-actions .button {
      width: 100%;
    }
  }

  @media print {
    .reference-hero,
    .lookup-panel,
    .detail-actions {
      display: none !important;
    }

    .reference-workspace {
      padding: 0;
    }

    .reference-grid {
      display: block;
      width: 100%;
    }

    .detail-panel {
      border: 0;
      box-shadow: none;
      padding: 0;
    }
  }
</style>
