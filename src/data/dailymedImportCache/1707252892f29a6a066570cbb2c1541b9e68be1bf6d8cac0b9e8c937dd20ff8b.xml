            <section ID="id_link_32e3536a-46ce-7468-e063-6394a90a9fe8">
               <id root="32e3536a-46cd-7468-e063-6394a90a9fe8"/>
               <code code="55106-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ACTIVE INGREDIENT SECTION"/>
