               <text>
                  <paragraph>anhydrous citric acid, flavors, glycerin, microcrystalline cellulose and carboxymethylcellulose sodium, potassium sorbate, purified water, sorbitol solution, sucralose, sucrose, xanthan gum</paragraph>
               </text>
               <effectiveTime value="20210414"/>
            </section>
         </component>
