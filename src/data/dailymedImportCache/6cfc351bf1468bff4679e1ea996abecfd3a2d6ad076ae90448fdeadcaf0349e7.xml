            <section ID="ID_20977471-5e60-4ded-b460-aa148294a941">
               <id root="49f4f1c8-3071-45b2-8a14-eb4ac03a72ca"/>
               <code code="51945-4" codeSystem="2.16.840.1.113883.6.1" displayName="PACKAGE LABEL.PRINCIPAL DISPLAY PANEL"/>
               <title>Package/Label Principal Display Panel</title>
               <text>
                  <paragraph>3 PACK</paragraph>
                  <paragraph>THREE 14-DAY COURSES OF TREATMENT</paragraph>
                  <paragraph>equate<sup>TM</sup>
                  </paragraph>
                  <paragraph>Compare to Zegerid OTC<sup>®</sup> active ingredients</paragraph>
                  <paragraph>Omeprazole and Sodium Bicarbonate Capsules, 20 mg/1100 mg</paragraph>
                  <paragraph>24 HOUR</paragraph>
                  <paragraph>Acid Reducer</paragraph>
                  <paragraph>Allows Absorption of this Omeprazole Product</paragraph>
                  <paragraph>Clinically Proven To Treat Frequent Heartburn</paragraph>
                  <paragraph>Actual Size</paragraph>
                  <paragraph>42 CAPSULES</paragraph>
