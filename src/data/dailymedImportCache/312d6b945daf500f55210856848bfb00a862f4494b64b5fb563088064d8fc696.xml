         <component>
            <section ID="id_link_e921a5c1-d0fd-0004-e053-2995a90af6e5">
               <id root="1970305f-0062-fa4e-e063-6394a90af144"/>
               <code code="59845-8" codeSystem="2.16.840.1.113883.6.1" displayName="INSTRUCTIONS FOR USE SECTION"/>
               <title>Directions</title>
               <text>
                  <list listType="unordered">
                     <item>This product does not contain directions or complete warnings for adult use.</item>
                     <item>Do not give more than directed (see overdose warning)</item>
                     <item>Shake well before using,  ml= milliliter</item>
                     <item>Find the right dose on chart below. If possible, use weight to confirm, otherwise use age</item>
                     <item>Remove the child protective cap and squeeze your child's dose in to the dosing cup</item>
                     <item>Repeat dose every 4 hours while symptoms last</item>
                     <item>Do not give more than 5 times in 24 hours or as directed by a doctor</item>
                  </list>
                  <paragraph>
                     <content styleCode="bold">Attention</content>: Use only enclosed dosing cup specifically designed for use with this product. Do not use any other dosing device.

 </paragraph>
               </text>
               <effectiveTime value="20240527"/>
               <component>
                  <section ID="id_link_e921b28d-7770-1cdc-e053-2995a90aeb07">
                     <id root="1970305f-0063-fa4e-e063-6394a90af144"/>
                     <code code="34068-7" codeSystem="2.16.840.1.113883.6.1" displayName="DOSAGE &amp; ADMINISTRATION SECTION"/>
                     <title>Dosing Chart</title>
                     <text>
                        <table width="100%">
                           <tbody>
                              <tr>
                                 <td>
                                    <content styleCode="bold">Weight (lbs)</content>
                                 </td>
                                 <td>
                                    <content styleCode="bold">Age (Years)</content>
                                 </td>
                                 <td>
                                    <content styleCode="bold">Dose (mL)</content>
                                 </td>
                              </tr>
                              <tr>
                                 <td>under 24 lbs</td>
                                 <td>under 2 years</td>
                                 <td>Ask a doctor</td>
                              </tr>
                              <tr>
                                 <td>24 -35 lbs</td>
                                 <td>2 - 3 years</td>
                                 <td>5 mL</td>
                              </tr>
                              <tr>
                                 <td>36 - 47 lbs</td>
                                 <td>4 - 5 years</td>
                                 <td>7.5 mL</td>
                              </tr>
                              <tr>
                                 <td>48 - 59 lbs</td>
                                 <td>6 - 8 years</td>
                                 <td>10 mL</td>
                              </tr>
                              <tr>
                                 <td>60 - 71 lbs</td>
                                 <td>9 -10 years</td>
                                 <td>12.5 mL</td>
                              </tr>
                              <tr>
                                 <td>72 - 95 lbs</td>
                                 <td>11 years</td>
                                 <td>15 mL</td>
                              </tr>
                           </tbody>
                        </table>
                        <paragraph/>
                     </text>
                     <effectiveTime value="20240527"/>
                  </section>
               </component>
            </section>
