               <code code="60561-8" codeSystem="2.16.840.1.113883.6.1" displayName="OTHER SAFETY INFORMATION"/>
               <title>
                  <content styleCode="italics">Other information</content>
               </title>
               <text>
                  <list listType="unordered">
                     <item>
                        <content styleCode="bold">each 30 mL contains</content>: potassium 35 mg, sodium 17 mg
 
  </item>
                     <item>store at controlled room temperature 20-25°C (68-77°F)</item>
                  </list>
               </text>
               <effectiveTime value="20190327"/>
            </section>
