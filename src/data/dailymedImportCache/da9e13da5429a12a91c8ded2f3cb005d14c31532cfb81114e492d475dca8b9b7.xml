                              <paragraph> ask a doctor</paragraph>
                           </td>
                           <td styleCode="Rrule Botrule Lrule " valign="top">
                              <paragraph> 1 tablet</paragraph>
                           </td>
                           <td styleCode="Rrule Botrule Lrule " valign="top">
                              <paragraph>1 ½  tablets</paragraph>
                           </td>
                           <td styleCode="Rrule Botrule Lrule " valign="top">
                              <paragraph>2 tablets</paragraph>
