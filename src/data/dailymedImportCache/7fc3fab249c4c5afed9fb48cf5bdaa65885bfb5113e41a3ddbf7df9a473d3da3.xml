         <component>
            <section ID="id_link_31539b1d-df16-ccb6-e063-6394a90a92ec">
               <id root="31539b1d-df15-ccb6-e063-6394a90a92ec"/>
               <code code="34067-9" codeSystem="2.16.840.1.113883.6.1" displayName="INDICATIONS &amp; USAGE SECTION"/>
               <text>
                  <paragraph>
                     <content styleCode="bold">Uses</content>
                     <br/>
• temporarily relieves these symptoms due to hay fever or other upper respiratory allergies:
 </paragraph>
                  <paragraph>• runny nose • sneezing • itchy, watery eyes • itching of the nose or throat</paragraph>
               </text>
               <effectiveTime value="20250212"/>
            </section>
         </component>
