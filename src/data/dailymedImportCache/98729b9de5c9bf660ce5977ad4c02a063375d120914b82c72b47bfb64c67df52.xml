         <component>
            <section ID="id_link_d243907c-78ff-3f37-e053-2a95a90a119c">
               <id root="e11ff2a0-bb99-3c31-e053-2a95a90ade76"/>
               <code code="34068-7" codeSystem="2.16.840.1.113883.6.1" displayName="DOSAGE &amp; ADMINISTRATION SECTION"/>
               <title>Directions</title>
               <text>
                  <list listType="unordered">
                     <item>Take only as directed</item>
                     <item>Do not exceed 4 doses per 24 hrs</item>
                  </list>
                  <table width="75%">
                     <colgroup>
                        <col align="left" valign="top" width="50%"/>
                        <col align="left" valign="top" width="50%"/>
                     </colgroup>
                     <tbody>
                        <tr styleCode="Botrule">
                           <td styleCode="Rrule">Adults &amp; children 12 yrs &amp; over</td>
                           <td>2 softgels with water every 6 hrs</td>
                        </tr>
                        <tr styleCode="Botrule">
                           <td styleCode="Rrule">Children 4 to under 12 yrs</td>
                           <td>Ask a doctor</td>
                        </tr>
                        <tr>
                           <td styleCode="Rrule">Children under 4 yrs</td>
                           <td>Do not use</td>
                        </tr>
                     </tbody>
                  </table>
               </text>
               <effectiveTime value="20220610"/>
            </section>
         </component>
