               <code code="42229-5" codeSystem="2.16.840.1.113883.6.1" displayName="SPL UNCLASSIFIED SECTION"/>
               <title>
                  <content styleCode="bold">Polyethylene Glycol 3350 increases frequency of bowel movements and softens stools</content>
               </title>
               <text>
                  <paragraph>
                     <content styleCode="bold">
                        <content styleCode="italics">Drug Facts</content>
                     </content>
                  </paragraph>
               </text>
               <effectiveTime value="20250609"/>
            </section>
