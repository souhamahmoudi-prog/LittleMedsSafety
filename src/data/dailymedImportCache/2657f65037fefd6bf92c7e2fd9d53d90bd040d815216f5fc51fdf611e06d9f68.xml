                  <section ID="LINK_d8ba2a7a-596a-4c13-8bf1-e391279b422f">
                     <id root="a5c5a9fc-f3d6-4dee-821f-0218afe53f8d"/>
                     <code code="50565-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - KEEP OUT OF REACH OF CHILDREN SECTION"/>
                     <title>
                        <content styleCode="bold">Keep out of reach of children.</content>
                     </title>
                     <text>
                        <paragraph>In case of overdose, get medical help or contact a Poison Control Center right away. Prompt medical attention is critical for adults as well as for children even if you do not notice any signs or symptoms.</paragraph>
                     </text>
                     <effectiveTime value="20260709"/>
                  </section>
               </component>
            </section>
