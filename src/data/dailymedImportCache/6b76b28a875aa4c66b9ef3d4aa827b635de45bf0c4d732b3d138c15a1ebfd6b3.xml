               <text>
                  <paragraph>
                     <content styleCode="italics">
                        <content styleCode="bold">Warnings</content>
                     </content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">For external use only.</content>
                  </paragraph>
               </text>
               <effectiveTime value="20251101"/>
            </section>
         </component>
         <component>
            <section ID="id_link_49f0a798-1c5a-6731-e063-6394a90a6252">
               <id root="5461ef92-61c4-d8de-e063-6294a90a2b21"/>
               <code code="50570-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - DO NOT USE SECTION"/>
               <title>
                  <content styleCode="bold">Do not use</content>
               </title>
               <text>
                  <paragraph>
                     <content styleCode="bold">Do not use </content>
                  </paragraph>
                  <list listType="unordered">
                     <item>on large areas of the body</item>
                     <item>with any other product containing diphenhydramine, even one taken by mouth</item>
                  </list>
               </text>
               <effectiveTime value="20251101"/>
            </section>
         </component>
