         <component>
            <section ID="Section_16">
               <id root="8d229dc6-28ef-41eb-a3bd-3e4f7ad692fb"/>
               <code code="51945-4" codeSystem="2.16.840.1.113883.6.1" displayName="PACKAGE LABEL.PRINCIPAL DISPLAY PANEL"/>
               <title>PACKAGE LABEL-PRINCIPAL DISPLAY PANEL -10 mg (24 Orally Disintegrating Tablets) Blister Carton</title>
               <text>
                  <paragraph>
                     <content styleCode="bold">ORIGINAL PRESCRIPTION STRENGTH</content>
                  </paragraph>
                  <paragraph>equate<sup>TM</sup>
                  </paragraph>
                  <br/>
                  <paragraph>NDC 79903-406-10<br/>
                     <content styleCode="bold"/>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold"> Compare to<br/> Children's<br/> Zyrtec<sup>®</sup>
                        <br/> Allergy active<br/> Ingredient<sup>*</sup>
                     </content>
                  </paragraph>
                  <br/>
                  <paragraph>children's</paragraph>
                  <paragraph>
                     <content styleCode="bold">ALLERGY RELIEF</content>
                     <br/> Cetirizine Hydrochloride Orally<br/> Disintegrating Tablets, USP 10 mg<br/> Antihistamine</paragraph>
                  <paragraph>
                     <content styleCode="bold">Sugar-Free    Dye-Free</content>
                  </paragraph>
