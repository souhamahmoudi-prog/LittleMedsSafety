               <code code="60561-8" codeSystem="2.16.840.1.113883.6.1" displayName="OTHER SAFETY INFORMATION"/>
               <title>Other information </title>
               <text>
                  <list listType="unordered">
                     <item>
                        <caption>•</caption>
                        <content styleCode="bold">each tablet contains:</content> calcium 25 mg</item>
                     <item>
                        <caption>•</caption>do not use if blister unit is broken or torn</item>
                     <item>
                        <caption>•</caption>store between 20° to 25°C (68° to 77°F)</item>
                     <item>
                        <caption>•</caption>keep in a dry place</item>
                  </list>
               </text>
               <effectiveTime value="20260409"/>
            </section>
         </component>
