               </title>
               <text>
                  <paragraph>NDC 0363-4810-09</paragraph>
                  <paragraph>
                     <content styleCode="bold">
                        <content styleCode="italics">Walgreens</content>
                     </content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">
                        <content styleCode="italics"> </content>
                     </content>• <content styleCode="italics">
                        <content styleCode="bold">WALGREENS</content> •<br/>
