                     <title>
                        <content styleCode="bold">Ask a doctor or pharmacist before use if you </content>
                        <content styleCode="bold">are</content>
                     </title>
                     <text>
                        <paragraph> taking a prescription drug</paragraph>
                     </text>
                     <effectiveTime value="20240117"/>
