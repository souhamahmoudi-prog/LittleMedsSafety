</content>
               </title>
               <text>
                  <paragraph>
                     <content styleCode="bold">EACH TABLET CONTAINS:                  % </content>U.S. RDA*</paragraph>
                  <paragraph>Elemental Iron 65 mg     360</paragraph>
                  <paragraph>(Equivalent to 325 mg of Ferrous Sulfate)</paragraph>
                  <paragraph>* U.S. Recommended Daily Allowance  </paragraph>
               </text>
               <effectiveTime value="20140303"/>
