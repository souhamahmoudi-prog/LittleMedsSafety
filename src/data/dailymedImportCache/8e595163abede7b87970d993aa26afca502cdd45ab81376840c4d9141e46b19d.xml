               <code code="51727-6" codeSystem="2.16.840.1.113883.6.1" displayName="INACTIVE INGREDIENT SECTION"/>
               <title>
                  <content styleCode="italics">Inactive Ingredients:</content>
               </title>
               <text>
                  <paragraph>acesulfame K, butylparaben, citric acid, flavoring, glycerin, high fructose corn syrup, polysorbate 80, propylene glycol, purified water, sodium benzoate, sorbitol solution, veegum and xanthan gum.</paragraph>
