               <title>
                  <content styleCode="bold">
                     <content styleCode="italics">Other information</content>
                  </content>
               </title>
               <text>
                  <list listType="unordered" styleCode="Square">
                     <item>
                        <content styleCode="bold">each 5 mL contains:</content> sodium 4 mg<br/>
                     </item>
                     <item>store at 25°C (77°F); excursions permitted between 15°-30°C (59°-86°F)<br/>
                     </item>
                     <item>see end flap for expiration date and lot number<br/>
                     </item>
                  </list>
               </text>
               <effectiveTime value="20260112"/>
            </section>
