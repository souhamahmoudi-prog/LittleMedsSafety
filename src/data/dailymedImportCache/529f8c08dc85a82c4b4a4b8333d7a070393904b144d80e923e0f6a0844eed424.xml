               <code code="34068-7" codeSystem="2.16.840.1.113883.6.1" displayName="DOSAGE &amp; ADMINISTRATION SECTION"/>
               <title>Directions</title>
               <text>
                  <list>
                     <item>
                        <content styleCode="bold">this product does not contain directions or complete warnings for adult use</content>
                     </item>
                     <item>
                        <content styleCode="bold">do not give more than directed (see <linkHtml href="#ow">Overdose warning</linkHtml>)</content>
                     </item>
                     <item>if needed, repeat dose every 4 hours while symptoms last</item>
                     <item>do not give more than 5 days unless directed by a doctor</item>
                     <item>measure only with dosing cup provided</item>
                     <item>do not use dosing cup with other products</item>
                     <item>dose as follows or as directed by a doctor</item>
                     <item>mL = milliliter </item>
                     <item>children 6 to under 12 years of age: 10 mL in dosing cup provided every 4 hours; do not give more than 5 doses in any 24-hour period</item>
                     <item>children under 6 years of age: do not use</item>
                  </list>
               </text>
               <effectiveTime value="20160129"/>
            </section>
         </component>
