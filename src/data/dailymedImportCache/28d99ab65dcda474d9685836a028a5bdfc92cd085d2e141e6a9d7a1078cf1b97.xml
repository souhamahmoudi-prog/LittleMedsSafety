               <code code="44425-7" codeSystem="2.16.840.1.113883.6.1" displayName="STORAGE AND HANDLING SECTION"/>
               <title>
                  <content styleCode="italics">Other information</content>
               </title>
               <text>
                  <paragraph>• store at room temperature between 20°-25°C (68°-77°F) • protect from light, heat and moisture</paragraph>
               </text>
               <effectiveTime value="20250317"/>
            </section>
