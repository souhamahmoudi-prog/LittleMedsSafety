            <section ID="Lbb5e462e-37b9-4027-b2a2-5a8aafebeea5">
               <id root="692f8282-84e2-4097-88c7-6236d43e9a9d"/>
               <code code="55106-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ACTIVE INGREDIENT SECTION"/>
               <title>INGREDIENTS</title>
               <text>
                  <paragraph>Each tablet contains equal parts of Calcarea fluorica 6X, Calcarea phosphorica 6X, Calcarea sulphurica 6X, Ferrum phoshporicum 6X, Kali muriatcum 6X, Kali phosphoricum 6X, Kali sulphuricum 6X, Magnesia phosphorica 6X, Natrum muriaticum 6X, Natrum phosphoricum 6X, Natrum sulphuricum 6X, Silicea 6X.</paragraph>
               </text>
               <effectiveTime value="20181016"/>
            </section>
         </component>
