         <component>
            <section ID="i4i_OTC_Purpose_id_16f9e2ad-69e0-4b47-9c5c-54b545fb2acb">
               <id root="7ae2a84e-c5c8-4f90-a397-12a6af5706a1"/>
               <code code="55105-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - PURPOSE SECTION"/>
               <title>Purpose</title>
               <text>
                  <paragraph>Osmotic Laxative</paragraph>
               </text>
               <effectiveTime value="20231005"/>
            </section>
