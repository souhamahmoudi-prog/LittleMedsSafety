                     </content>
                  </paragraph>
                  <paragraph/>
                  <paragraph>
                     <content styleCode="italics">
                        <content styleCode="bold">Active ingredients </content>
                     </content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="italics">
                        <content styleCode="bold">(in each 5 mL teaspoonful)</content>
                     </content>
                     <br/>
                     <br/>Diphenhydramine HCl 12.5 mg</paragraph>
