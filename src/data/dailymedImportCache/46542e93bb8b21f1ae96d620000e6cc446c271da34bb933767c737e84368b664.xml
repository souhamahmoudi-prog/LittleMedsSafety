            <section ID="ID_9c702798-8ca6-4488-bb86-0345865cf90d">
               <id root="35339df5-9ed7-6a29-e063-6294a90acbb9"/>
               <code code="42229-5" codeSystem="2.16.840.1.113883.6.1" displayName="SPL UNCLASSIFIED SECTION"/>
               <title>Additional Information</title>
               <text>
                  <paragraph>
                     <content styleCode="bold">READ ALL WARNINGS AND DIRECTIONS ON CARTON BEFORE USE. KEEP CARTON FOR REFERENCE. DO NOT DISCARD.</content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">
                        <content styleCode="italics">HOT LIQUID THERAPY</content>that relieves:
 
  </content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">
                        <content styleCode="italics">Fever</content>
                     </content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">
                        <content styleCode="italics">Body ache</content>
                     </content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">
                        <content styleCode="italics">Headache</content>
                     </content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">
                        <content styleCode="italics">Sore throat pain</content>
                     </content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">
                        <content styleCode="italics">Cough</content>
                     </content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">*Maximum Strength per 6 hour dose</content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">PARENTS:</content>Learn about teen medicine abuse

