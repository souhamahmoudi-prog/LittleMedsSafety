                           <td align="center" styleCode="Rrule Lrule Botrule " valign="top">
                              <list listType="ordered">
                                 <item>
                                    <caption> </caption>adults and children 12 years of age and over</item>
                              </list>
                           </td>
                           <td align="center" styleCode="Rrule Lrule Botrule " valign="top">
                              <list listType="ordered">
                                 <item>
                                    <caption> </caption>30 mL</item>
                              </list>
                           </td>
                        </tr>
                        <tr>
                           <td align="center" styleCode="Rrule Botrule Lrule " valign="top">
                              <list listType="ordered">
                                 <item>
                                    <caption> </caption>children under 12 years of age</item>
                              </list>
                           </td>
                           <td align="center" styleCode="Rrule Botrule Lrule " valign="top">
                              <list listType="ordered">
                                 <item>
                                    <caption> </caption>do not use</item>
                              </list>
                           </td>
                        </tr>
                     </tbody>
                  </table>
               </text>
               <effectiveTime value="20241212"/>
            </section>
