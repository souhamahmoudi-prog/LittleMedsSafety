               <code code="44425-7" codeSystem="2.16.840.1.113883.6.1" displayName="STORAGE AND HANDLING SECTION"/>
               <title>Other Information</title>
               <text>
                  <list listType="unordered">
                     <item>
                        <content styleCode="bold">TAMPER EVIDENT: Do not use if imprinted seal under cap is missing or broken.</content>
                     </item>
                     <item>store at 20⁰C-25⁰C (68⁰F-77⁰F)</item>
                  </list>
               </text>
               <effectiveTime value="20110413"/>
            </section>
