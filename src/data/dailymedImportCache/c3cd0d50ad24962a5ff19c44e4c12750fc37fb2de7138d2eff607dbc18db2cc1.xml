               <text>
                  <paragraph>Compare to Claritin® 24 Hour active ingredient†</paragraph>
                  <paragraph>NON-DROWSY*</paragraph>
                  <paragraph>
                     <content styleCode="bold">All Day Allergy Relief<br/>
                     </content>
                  </paragraph>
