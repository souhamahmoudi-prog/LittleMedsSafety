               <title>
                  <content styleCode="bold">
                     <content styleCode="italics">Directions</content>
                  </content>
               </title>
               <text>
                  <list listType="unordered" styleCode="Square">
                     <item>
                        <content styleCode="bold">do not take more than directed</content>
                     </item>
                     <item>take every 4 to 6 hours, or as directed by a doctor</item>
                     <item>do not take more than 6 times in 24 hours</item>
                  </list>
                  <table width="375px">
                     <col/>
                     <col/>
                     <tbody>
                        <tr>
                           <td styleCode=" Botrule Toprule Lrule Rrule">adults and children 12 years and over</td>
                           <td styleCode=" Botrule Toprule Lrule Rrule">1 to 2 tablets</td>
                        </tr>
                        <tr>
                           <td styleCode=" Botrule Toprule Lrule Rrule">children 6 to under 12 years<br/>
                           </td>
                           <td styleCode=" Botrule Toprule Lrule Rrule">1 tablet<br/>
                           </td>
                        </tr>
                        <tr>
                           <td styleCode=" Botrule Toprule Lrule Rrule">children under 6 years<br/>
                           </td>
                           <td styleCode=" Botrule Toprule Lrule Rrule">do not use</td>
                        </tr>
                     </tbody>
                  </table>
               </text>
               <effectiveTime value="20260720"/>
            </section>
