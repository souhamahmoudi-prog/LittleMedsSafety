               <code code="44425-7" codeSystem="2.16.840.1.113883.6.1" displayName="STORAGE AND HANDLING SECTION"/>
               <title>Other information</title>
               <text>
                  <list listType="unordered">
                     <item>
                        <caption>•</caption>
                        <content styleCode="bold">do not use if bottle wrap imprinted with "SEALED FOR SAFETY" is broken or missing.</content>
                     </item>
                     <item>
                        <caption>•</caption>see bottom panel for lot number and expiration date</item>
                     <item>
                        <caption>•</caption>store between 20° and 25°C (68° and 77°F)</item>
                  </list>
               </text>
               <effectiveTime value="20260115"/>
            </section>
         </component>
