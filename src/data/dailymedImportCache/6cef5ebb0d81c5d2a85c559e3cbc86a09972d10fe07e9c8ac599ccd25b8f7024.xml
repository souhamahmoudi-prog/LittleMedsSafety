            <section ID="ID_CC460DAC-2EC5-494F-BD86-9BF1CE6E9C14">
               <id root="6e5a3c2c-70b4-4ae2-8760-bcda433bcdc3"/>
               <code code="55106-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ACTIVE INGREDIENT SECTION"/>
               <title>
                  <content styleCode="bold">Active ingredients (in each 15 mL)</content>
               </title>
               <text>
                  <paragraph>Acetaminophen 325 mg</paragraph>
                  <paragraph>Dextromethorphan HBr 10 mg</paragraph>
               </text>
               <effectiveTime value="20260214"/>
            </section>
