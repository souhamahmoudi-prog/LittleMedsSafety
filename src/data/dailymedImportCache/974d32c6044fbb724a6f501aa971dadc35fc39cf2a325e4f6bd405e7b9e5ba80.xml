               <code code="55106-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ACTIVE INGREDIENT SECTION"/>
               <title>ACTIVE INGREDIENT(S)</title>
               <text>
                  <paragraph>EACH TABLET CONTAINS:</paragraph>
                  <br/>
                  <br/>
                  <table cellspacing="0" cellpadding="0" border="0" width="468">
                     <tfoot>
                        <tr>
                           <td colspan="2">Dried Ferrous Sulfate, equivalent to 325 mg Ferrous Sulfate per tablet.</td>
                        </tr>
                     </tfoot>
                     <tbody>
                        <tr styleCode="Botrule">
                           <td valign="top" styleCode="Lrule Rrule">
                              <content styleCode="bold">Amount per tablet</content> </td>
                           <td valign="top" styleCode="Rrule"> <content styleCode="bold">% Daily Value</content>
                           </td>
                        </tr>
                        <tr>
                           <td valign="top" styleCode="Lrule Rrule"> Iron 65 mg</td>
                           <td valign="top" styleCode="Rrule"> 361%</td>
                        </tr>
                     </tbody>
                  </table>
               </text>
               <effectiveTime value="20160322"/>
            </section>
