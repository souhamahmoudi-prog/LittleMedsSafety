         <component>
            <section ID="Le6a470ec-90d2-4943-8322-8584cfff2bca">
               <id root="23f63052-1359-4a18-86be-6e7bfc06fbb8"/>
               <code code="34071-1" codeSystem="2.16.840.1.113883.6.1" displayName="WARNINGS SECTION"/>
               <text>
                  <paragraph>
                     <content styleCode="bold">WARNING:</content> Folic acid alone is improper therapy in the treatment of pernicious anemia and other megaloblastic anemias where Vitamin B<sub>12</sub> is deficient.</paragraph>
               </text>
               <effectiveTime value="20220607"/>
            </section>
         </component>
         <component>
            <section ID="Lf798dab3-eabc-487b-b8f0-308d6f33e0d7">
               <id root="349eb06c-2644-4425-a20e-9c35dcfdd8de"/>
               <code code="42232-9" codeSystem="2.16.840.1.113883.6.1" displayName="PRECAUTIONS SECTION"/>
               <text>
                  <paragraph>
                     <content styleCode="bold">PRECAUTIONS:</content> Folic acid alone in doses above 0.1 mg - 0.4 mg daily may obscure pernicious anemia, in that hematological remission can occur while neurological manifestations remain progressive.</paragraph>
               </text>
               <effectiveTime value="20220608"/>
            </section>
         </component>
