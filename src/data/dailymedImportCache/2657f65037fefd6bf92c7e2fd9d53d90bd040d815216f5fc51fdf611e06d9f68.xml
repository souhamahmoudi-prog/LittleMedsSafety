         <component>
            <section ID="LINK_1d3412c9-1149-42d9-a6b4-3bb4b4c73b13">
               <id root="863a3aab-3911-4be7-84cf-90ceb227b79d"/>
               <code code="34068-7" codeSystem="2.16.840.1.113883.6.1" displayName="DOSAGE &amp; ADMINISTRATION SECTION"/>
               <title>
                  <content styleCode="bold">
                     <content styleCode="italics">Directions</content>
                  </content>
               </title>
               <text>
                  <list listType="unordered" styleCode="Square">
                     <item>
                        <content styleCode="bold">do not take more than directed</content>
                     </item>
                     <item>adults and children 12 years and over<list listType="unordered" styleCode="Square">
                           <item>take 2 caplets every 4 hours</item>
                           <item>swallow whole - do not crush, chew, or dissolve</item>
                           <item>do not take more than 10 caplets in 24 hours</item>
                        </list>
                     </item>
                     <item>children under 12 years: ask a doctor</item>
                  </list>
               </text>
               <effectiveTime value="20260709"/>
            </section>
         </component>
