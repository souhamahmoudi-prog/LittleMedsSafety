         <component>
            <section ID="LINK_bc519aee-9ff1-446b-aa83-e553a864dcf4">
               <id root="b94eaaae-91f2-441a-87b3-9cae1240f66e"/>
               <code code="34067-9" codeSystem="2.16.840.1.113883.6.1" displayName="INDICATIONS &amp; USAGE SECTION"/>
               <title>
                  <content styleCode="italics">
                     <content styleCode="bold">Uses</content>
                  </content>
               </title>
               <text>
                  <list listType="unordered" styleCode="Square">
                     <item>temporarily relieves these symptoms due to hay fever or other upper respiratory allergies:<list listType="unordered" styleCode="Square">
                           <item>itchy, watery eyes</item>
                           <item>runny nose</item>
                           <item>sneezing</item>
                           <item>itching of the nose or throat</item>
                        </list>
                     </item>
                  </list>
               </text>
               <effectiveTime value="20250916"/>
            </section>
         </component>
         <component>
