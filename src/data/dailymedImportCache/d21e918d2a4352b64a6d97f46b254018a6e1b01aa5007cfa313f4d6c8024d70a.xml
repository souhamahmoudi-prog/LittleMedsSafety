                     <item>store between 20-25ºC (68-77ºF) </item>
                     <item>do not refrigerate </item>
                     <item>see bottom panel for lot number and expiration date</item>
                  </list>
               </text>
               <effectiveTime value="20240205"/>
            </section>
         </component>
