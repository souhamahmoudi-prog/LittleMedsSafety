               <id root="706e64a3-316b-4e53-990f-f1d398bc19d6"/>
               <code code="51945-4" codeSystem="2.16.840.1.113883.6.1" displayName="PACKAGE LABEL.PRINCIPAL DISPLAY PANEL"/>
               <title>
                  <content styleCode="bold">
                     <content styleCode="italics">Principal display panel</content>
                  </content>
               </title>
               <text>
                  <paragraph>NDC 0904-6931-26</paragraph>
                  <paragraph>
                     <content styleCode="bold">Compare to MiraLAX®<br/>
                     </content>active ingredient*</paragraph>
                  <paragraph>
                     <content styleCode="bold">MAJOR®</content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="italics">PEG<content styleCode="bold">3350</content>
                     </content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">
                        <content styleCode="italics">Polyethylene Glycol 3350<br/>Powder for Oral Solution<br/>Osmotic Laxative</content>
                     </content>
                  </paragraph>
                  <paragraph>• Relieves Occasional Constipation (Irregularity)<br/>• Softens Stool</paragraph>
                  <paragraph>Dissolves in Any Beverage<br/>Sugar Free<br/>Unflavored</paragraph>
