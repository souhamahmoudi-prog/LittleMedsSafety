                           </td>
                           <td>
                              <content styleCode="bold">Age (yr)</content>
                           </td>
                           <td>
                              <content styleCode="bold">Dose (mL)*</content>
                           </td>
                        </tr>
                        <tr>
                           <td> under 24</td>
                           <td> under 2 years</td>
                           <td> ask a doctor</td>
                        </tr>
                        <tr>
                           <td> 24-35 lbs</td>
                           <td> 2-3 years</td>
                           <td> 5 mL</td>
                        </tr>
                        <tr>
                           <td> 36-47 lbs</td>
                           <td> 4-5 years</td>
                           <td> 7.5 mL</td>
                        </tr>
                        <tr>
                           <td> 48-59 lbs</td>
                           <td> 6-8 years</td>
                           <td> 10 mL</td>
                        </tr>
                        <tr>
                           <td> 60-71 lbs</td>
                           <td> 9-10 years</td>
                           <td> 12.5 mL</td>
                        </tr>
                        <tr>
