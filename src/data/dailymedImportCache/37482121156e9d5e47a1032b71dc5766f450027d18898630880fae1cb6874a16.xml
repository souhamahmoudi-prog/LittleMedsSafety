                     <code codeSystem="2.16.840.1.113883.6.1" code="50567-7" displayName="OTC - WHEN USING SECTION"/>
                     <title>
                        <content styleCode="bold">When using this product </content>
                     </title>
                     <text>
                        <paragraph>you may have loose, watery, more frequent stools</paragraph>
                     </text>
                     <effectiveTime value="20240117"/>
                  </section>
               </component>
               <component>
                  <section>
                     <id root="49bb5565-562d-4c31-8bc1-752ed2797127"/>
                     <code codeSystem="2.16.840.1.113883.6.1" code="50566-9" displayName="OTC - STOP USE SECTION"/>
                     <title>
                        <content styleCode="bold">Stop use and ask a doctor if:</content>
                     </title>
                     <text>
                        <list>
                           <item>you have rectal bleeding, or your nausea, bloating, cramping or abdominal pain gets worse. These may be signs of a serious condition.<br/>
                           </item>
                           <item>you get diarrhea<br/>
                           </item>
                           <item>you need to use a laxative for longer than 1 week</item>
                        </list>
                     </text>
                     <effectiveTime value="20240117"/>
                  </section>
               </component>
