            <section ID="LINK_e6bf208f-fac1-4ddb-be83-bb074e4b6b51">
               <id root="c5b6dbe1-2737-4f6c-8b34-76c76d847a78"/>
               <code code="34068-7" codeSystem="2.16.840.1.113883.6.1" displayName="DOSAGE &amp; ADMINISTRATION SECTION"/>
               <title>DIRECTIONS FOR USE</title>
               <text>
                  <paragraph>Take one softgel capsule by mouth daily or as directed by a physician.</paragraph>
               </text>
               <effectiveTime value="20220107"/>
            </section>
