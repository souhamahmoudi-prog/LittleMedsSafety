            <section ID="LINK_b47d7c18-a9a4-4974-a922-7f66e8aa9e93">
               <id root="fda88083-ddd0-4e6b-941c-03b5cebf6c14"/>
               <code code="55106-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ACTIVE INGREDIENT SECTION"/>
               <title>
                  <content styleCode="bold">
                     <content styleCode="italics">Active ingredients (in each caplet)<br/>
                     </content>
                  </content>
               </title>
               <text>
                  <paragraph>Acetaminophen 500 mg<br/>Diphenhydramine HCl 25 mg</paragraph>
               </text>
               <effectiveTime value="20260602"/>
            </section>
