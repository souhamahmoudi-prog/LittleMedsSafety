         <component>
            <section ID="LINK_4aa2f92e-23d0-4e2a-a1dc-9a2d93ebb5b3">
               <id root="1312c8b7-3dd2-4690-a19f-a14479f40538"/>
               <code code="34067-9" codeSystem="2.16.840.1.113883.6.1" displayName="INDICATIONS &amp; USAGE SECTION"/>
               <title>
                  <content styleCode="bold">Uses</content>
               </title>
               <text>
                  <list listType="unordered" styleCode="Disk">
                     <item>temporarily relieves these symptoms due to hay fever or other upper respiratory allergies:<list listType="unordered" styleCode="Circle">
                           <item> runny nose
</item>
                           <item> sneezing</item>
                           <item> itchy, watery eyes</item>
                           <item> itching of the nose or throat </item>
                        </list>
                     </item>
                  </list>
               </text>
               <effectiveTime value="20231207"/>
            </section>
         </component>
