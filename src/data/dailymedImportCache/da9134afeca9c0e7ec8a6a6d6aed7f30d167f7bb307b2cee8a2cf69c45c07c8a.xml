            <section ID="id_link_178c55de-3f17-66c1-e063-6294a90af83f">
               <id root="178c642c-9cea-9084-e063-6294a90ad31b"/>
               <code code="34071-1" codeSystem="2.16.840.1.113883.6.1" displayName="WARNINGS SECTION"/>
