               <title>
                  <content styleCode="bold">
                     <content styleCode="italics">Other information</content>
                  </content>
               </title>
               <text>
                  <list listType="unordered" styleCode="Square">
                     <item>
                        <content styleCode="bold">each caplet contains:</content> sodium 3 mg</item>
                     <item>
                        <content styleCode="bold">TAMPER EVIDENT: DO NOT USE IF OUTER PACKAGE IS OPENED OR BLISTER IS TORN OR BROKEN</content>
                     </item>
                     <item>store at 25°C (77°F); excursions permitted between 15°-30°C (59°-86°F)</item>
                     <item>see end flap for expiration date and lot number</item>
                  </list>
               </text>
               <effectiveTime value="20260709"/>
            </section>
