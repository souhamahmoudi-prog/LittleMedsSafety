               <title>Inactive ingredients</title>
               <text>
                  <paragraph>citric acid, FD&amp;C red # 40, FD&amp;C blue # 1, flavor, glycerin. PEG 400, sodium benzoate, sodium citrate, sodium saccharin, sorbitol, water.</paragraph>
               </text>
               <effectiveTime value="20130403"/>
            </section>
         </component>
