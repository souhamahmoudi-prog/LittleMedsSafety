               <code code="55106-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ACTIVE INGREDIENT SECTION"/>
               <title>
                  <content styleCode="italics">
                     <content styleCode="bold">Drug Facts</content>
                  </content>
               </title>
               <text>
                  <paragraph>
                     <content styleCode="italics">
                        <content styleCode="bold">Active Ingredients (in each 5 mL)</content>
                     </content>
                  </paragraph>
                  <paragraph>Diphenhydramine HCl, USP 12.5 mg</paragraph>
               </text>
               <effectiveTime value="20250304"/>
