               <title>Inactive ingredients</title>
               <text>
                  <paragraph>carnauba wax, hydroxypropyl cellulose, hypromellose, magnesium stearate, microcrystalline cellulose, pregelatinized starch, red iron oxide, talc, titanium dioxide</paragraph>
               </text>
               <effectiveTime value="20210513"/>
            </section>
         </component>
