               <code code="51945-4" codeSystem="2.16.840.1.113883.6.1" displayName="PACKAGE LABEL.PRINCIPAL DISPLAY PANEL"/>
               <title>PRINCIPAL DISPLAY PANEL</title>
               <text>
                  <paragraph>NDC 0363-5101-18</paragraph>
                  <paragraph>
                     <content styleCode="bold">Children's</content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">Dye-Free</content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">Pain &amp; Fever Dissolve Packs</content>
                  </paragraph>
                  <paragraph>ACETAMINOPHEN 160 mg 
  <br/>  PAIN RELIEVER/FEVER REDUCER
 </paragraph>
                  <paragraph>
                     <content styleCode="bold">DYE FREE, ASPIRIN FREE, IBUPROFEN FREE</content>
                  </paragraph>
                  <list listType="unordered">
                     <item>No water needed</item>
                     <item>Dissolves in seconds</item>
                  </list>
                  <paragraph>
                     <content styleCode="bold">AGES 6-11 YEARS</content>
                  </paragraph>
                  <paragraph>18 PACKETS* 
  <br/>  160 mg EACH PACKET
 </paragraph>
                  <paragraph>WILD BERRY FLAVOR</paragraph>
                  <paragraph>NATURALLY AND ARTIFICIALLY FLAVORED</paragraph>
                  <paragraph>*PACKETS OF POWDER</paragraph>
                  <paragraph>Pour powder on your child’s tongue</paragraph>
                  <table width="100%" styleCode="Noautorules">
                     <col width="100%"/>
                     <tbody>
                        <tr>
                           <td styleCode="Rrule Botrule Lrule Toprule " valign="top">
                              <paragraph>
                                 <content styleCode="bold">IMPORTANT:</content>Keep this carton for future reference on full labeling.
    
     </paragraph>
                           </td>
                        </tr>
                     </tbody>
                  </table>
                  <paragraph>Walgreens Pharmacist Recommended</paragraph>
