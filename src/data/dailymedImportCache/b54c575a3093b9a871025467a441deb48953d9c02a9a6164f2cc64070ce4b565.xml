               <title>Other information</title>
               <text>
                  <list listType="unordered">
                     <item>eash 5mL (1 tsp) contains sodium 3mg</item>
                     <item>store between 20-25</item>
                  </list>
               </text>
               <effectiveTime value="20170404"/>
            </section>
         </component>
