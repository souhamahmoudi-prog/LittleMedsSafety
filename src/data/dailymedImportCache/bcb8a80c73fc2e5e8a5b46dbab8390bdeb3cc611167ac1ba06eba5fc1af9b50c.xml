            <section ID="L2e8a735d-002a-4ce9-b1d3-c3c1dacec8d7">
               <id root="8cdedef1-cbad-469e-8617-b3e15cd49ff6"/>
               <code code="34071-1" codeSystem="2.16.840.1.113883.6.1" displayName="WARNINGS SECTION"/>
               <title>Warnings:</title>
               <text>
                  <paragraph> If pregnant or breast-feeding, ask<br/>a health professional before use. Keep out of<br/>reach of children. If symptoms persist or worsen,<br/>a health professional should be consulted. Do not<br/>use if known sensitivity to Lymphomyosot® or any<br/>of its ingredients exists.</paragraph>
               </text>
               <effectiveTime value="20230510"/>
            </section>
         </component>
