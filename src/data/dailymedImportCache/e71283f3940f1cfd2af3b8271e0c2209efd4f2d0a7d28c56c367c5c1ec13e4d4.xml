            <section ID="id_link_291a2d95-499d-cbd6-e063-6394a90a5151">
               <id root="291a2d95-499c-cbd6-e063-6394a90a5151"/>
               <code code="34068-7" codeSystem="2.16.840.1.113883.6.1" displayName="DOSAGE &amp; ADMINISTRATION SECTION"/>
               <title>
                  <content styleCode="italics">
                     <content styleCode="bold">Directions</content>
                  </content>
               </title>
               <text>
                  <list listType="unordered">
                     <item>
                        <content styleCode="bold">this product does not contain directions or complete warnings for adult use</content>
                     </item>
                     <item>
                        <content styleCode="bold">do not give more than directed (see overdose warning)</content>
                     </item>
                     <item>find right dose on the chart below. If possible, use weight to dose; otherwise, use age</item>
                     <item>
                        <content styleCode="bold">chocking hazard:</content> instruct child to chew each piece thoroughly before swallowing
  </item>
                     <item>repeat dose every 4 hours while symptoms last</item>
                     <item>do not give more than 5 times in 24 hours</item>
                  </list>
                  <paragraph>
                     <content styleCode="bold">Dosing Chart</content>
                  </paragraph>
                  <table border="0" width="100%">
                     <tbody>
                        <tr>
                           <td>
                              <paragraph>
                                 <content styleCode="bold">Weight (lbs)</content>
                              </paragraph>
                           </td>
                           <td>
                              <content styleCode="bold"> Age (Years)</content>
                           </td>
                           <td>
                              <content styleCode="bold">Dose (per piece)*</content>
                           </td>
                        </tr>
                        <tr>
                           <td>under 24</td>
                           <td>under 2 years</td>
                           <td>ask a doctor</td>
                        </tr>
                        <tr>
                           <td>24-35</td>
                           <td>2-3</td>
                           <td>2</td>
