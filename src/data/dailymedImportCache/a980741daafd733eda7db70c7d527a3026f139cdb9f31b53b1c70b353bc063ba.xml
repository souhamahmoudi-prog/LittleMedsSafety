         <component>
            <section ID="La26f60de-631f-42e6-8595-b69eb95e4753">
               <id root="498adc5b-0e64-f64c-e063-6394a90a62ea"/>
               <code code="34067-9" codeSystem="2.16.840.1.113883.6.1" displayName="INDICATIONS &amp; USAGE SECTION"/>
               <title>
                  <content styleCode="bold">
                     <content styleCode="bold">Uses</content>
                  </content>● temporarily relieves these symptoms due to hay fever or other upper respiratory allergies: 
 <br/>  ● runny nose 
 <br/>  ● sneezing 
 <br/>  ● itchy, watery eyes 
 <br/>  ● itching of the nose or throat

 <content styleCode="bold"/>
               </title>
               <text>
                  <paragraph/>
               </text>
               <effectiveTime value="20240124"/>
            </section>
         </component>
         <component>
            <section ID="Led10ae52-207f-476d-82b6-3232bd1d051b">
               <id root="498adc5b-0e65-f64c-e063-6394a90a62ea"/>
               <code code="34071-1" codeSystem="2.16.840.1.113883.6.1" displayName="WARNINGS SECTION"/>
               <title>
                  <content styleCode="bold">Warnings</content>
               </title>
               <text>
                  <paragraph>
                     <content styleCode="bold">Do not use</content>if you have ever had an allergic reaction to this product or any of its ingredients or to an antihistamine containing hydroxyzine.

 </paragraph>
               </text>
               <effectiveTime value="20240124"/>
            </section>
         </component>
         <component>
            <section ID="L656af5e3-e51f-4b35-b3aa-295d37637292">
               <id root="498adc5b-0e66-f64c-e063-6394a90a62ea"/>
               <code code="50569-3" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ASK DOCTOR SECTION"/>
               <title>
                  <content styleCode="bold">Ask a doctor before use if you have</content>liver or kidney disease. Your doctor should determine if you need a different dose.
</title>
               <text>
                  <paragraph/>
               </text>
               <effectiveTime value="20240124"/>
            </section>
         </component>
