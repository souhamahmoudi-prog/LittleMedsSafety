            <section ID="id_link_4612d14c-4a87-bfb8-e063-6394a90a1d22">
               <id root="46b80b4f-9c5a-195f-e063-6394a90a928f"/>
               <code code="55106-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ACTIVE INGREDIENT SECTION"/>
               <title>Active Ingredients</title>
               <text>
                  <paragraph>Active Ingredients (in each caplet) Purpose</paragraph>
                  <paragraph>Acetaminophen 250 mg Pain reliever</paragraph>
                  <paragraph>Ibuprofen 125 mg (NSAID**) Pain reliever</paragraph>
                  <paragraph>**nonsteroidal anti-inflammatory drug</paragraph>
               </text>
               <effectiveTime value="20251201"/>
            </section>
