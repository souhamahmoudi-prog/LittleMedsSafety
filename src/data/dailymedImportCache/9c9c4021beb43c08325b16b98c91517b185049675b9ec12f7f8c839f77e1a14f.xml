               <code code="44425-7" codeSystem="2.16.840.1.113883.6.1" displayName="STORAGE AND HANDLING SECTION"/>
               <text>
                  <paragraph>
                     <content styleCode="bold">Other information:</content>
                  </paragraph>
                  <list listType="unordered">
                     <item>Store at room temperature between 20-25°C (68-77ºF): excursions permitted between 15°C-30°C (59°F-86°F)</item>
                     <item>Avoid excessive heat and humidity</item>
                     <item>Tamper Evident: do not use if package or blister unit is open or shows any sing of tampering</item>
                  </list>
               </text>
               <effectiveTime value="20201230"/>
            </section>
