         <component>
            <section ID="LINK_f9e6b486-e6bc-410e-a544-15713934d7c9">
               <id root="a597bf64-edfa-486e-b38d-f6045a2556b6"/>
               <code code="34068-7" codeSystem="2.16.840.1.113883.6.1" displayName="DOSAGE &amp; ADMINISTRATION SECTION"/>
               <title>
                  <content styleCode="italics">Directions</content>
               </title>
               <text>
                  <list listType="unordered">
                     <item>
                        <caption>▪</caption>find right dose on chart below</item>
                     <item>
                        <caption>▪</caption>take every 4 to 6 hours, or as directed by a doctor</item>
                     <item>
                        <caption>▪</caption>do not take more than 6 doses in 24 hours </item>
                     <item>
                        <caption>▪</caption>mL = milliliter</item>
                  </list>
                  <table width="100%">
                     <col width="50%"/>
                     <col width="50%"/>
                     <tbody>
                        <tr>
                           <td styleCode="Botrule Toprule " valign="top">
                              <paragraph>
                                 <content styleCode="bold">Age (yr)</content>
                              </paragraph>
                           </td>
                           <td styleCode="Botrule Lrule Toprule " valign="top">
                              <paragraph>
                                 <content styleCode="bold"> Dose (mL)</content>
                              </paragraph>
                           </td>
                        </tr>
                        <tr>
                           <td styleCode="Botrule " valign="top">
                              <paragraph>children under 2 years</paragraph>
                           </td>
                           <td styleCode="Lrule Botrule " valign="top">
                              <paragraph>do not use</paragraph>
                           </td>
                        </tr>
                        <tr>
                           <td styleCode="Botrule " valign="top">
                              <paragraph>children 2 to 5 years</paragraph>
                           </td>
                           <td styleCode="Lrule Botrule " valign="top">
                              <paragraph>do not use unless<br/>directed by a doctor</paragraph>
                           </td>
                        </tr>
                        <tr>
                           <td styleCode="Botrule " valign="top">
                              <paragraph>children 6 to 11 years</paragraph>
                           </td>
                           <td styleCode="Botrule Lrule " valign="top">
                              <paragraph>5 mL to 10 mL</paragraph>
                           </td>
                        </tr>
                     </tbody>
                  </table>
                  <paragraph>
                     <content styleCode="bold">Attention:</content> use only enclosed dosing cup designed for use with this product. Do not use any other dosing device.</paragraph>
               </text>
               <effectiveTime value="20210615"/>
            </section>
         </component>
