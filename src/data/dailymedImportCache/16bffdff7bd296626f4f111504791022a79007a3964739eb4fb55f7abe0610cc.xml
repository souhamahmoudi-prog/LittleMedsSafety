         <component>
            <section ID="i4i_OTC_Purpose_id_1c4e7e0b-7e19-433a-ad13-89530312585a">
               <id root="446a3d6e-8f83-4689-e063-6394a90ac2cf"/>
               <code code="55105-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - PURPOSE SECTION"/>
               <title>
                  <content styleCode="italics">Purposes</content>
               </title>
               <text>
                  <paragraph>Pain reliever / fever reducer</paragraph>
                  <paragraph>Cough Suppressant</paragraph>
                  <paragraph>Nasal Decongestant</paragraph>
               </text>
               <effectiveTime value="20180502"/>
            </section>
