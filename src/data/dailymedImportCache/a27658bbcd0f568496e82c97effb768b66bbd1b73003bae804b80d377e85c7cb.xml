         <component>
            <section ID="id_link_52215224-77c3-e49e-e063-6294a90a94cb">
               <id root="52215224-77c2-e49e-e063-6294a90a94cb"/>
               <code code="55106-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ACTIVE INGREDIENT SECTION"/>
               <text>
                  <paragraph>
                     <content styleCode="italics">
                        <content styleCode="bold">Active ingredient</content>
                     </content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">(in each 5 mL)</content>
                  </paragraph>
