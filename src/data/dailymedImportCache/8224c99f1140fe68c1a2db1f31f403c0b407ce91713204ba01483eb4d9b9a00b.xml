         <component>
            <section ID="ID_2b0a6a53-526a-4da3-8741-7ea7095e0d02">
               <id root="635196de-ae18-480e-85f0-3efe94e7d1af"/>
               <code code="55105-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - PURPOSE SECTION"/>
               <title>Purpose </title>
               <text>
                  <paragraph>Antihistamine</paragraph>
               </text>
