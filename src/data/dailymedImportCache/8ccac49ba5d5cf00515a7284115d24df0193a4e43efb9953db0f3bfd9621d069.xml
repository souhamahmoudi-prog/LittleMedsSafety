               <code code="34091-9" codeSystem="2.16.840.1.113883.6.1" displayName="ANIMAL PHARMACOLOGY &amp; OR TOXICOLOGY SECTION"/>
               <title>INGREDIENTS</title>
               <text>
                  <paragraph>
                     <content styleCode="bold">GUARANTEED ANALYSIS EACH POUND CONTAINS NOT LESS THAN:</content>
                  </paragraph>
                  <paragraph/>
                  <paragraph>Calcium (Ca)                Min. 2.8%                   Max.    3.30%</paragraph>
                  <paragraph>Phosphorus                  Min.                                       1.40%</paragraph>
                  <paragraph>Salt (NaCl)                   Min. 9.0%                   Max.   10.80%</paragraph>
                  <paragraph>Iron (Fe)                      Min.                                     0.353%</paragraph>
                  <paragraph>Iodine (I)                     Min.                                   0.0035%</paragraph>
                  <paragraph>Vitamin A                     Min.                             350,000IU/lb</paragraph>
                  <paragraph>Vitamin D3                   Min.                               35,000IU/lb</paragraph>
                  <paragraph>Vitamin B12                 Min.                                     1 mg/lb</paragraph>
                  <paragraph>Riboflavin                    Min.                                     80 mg/lb</paragraph>
                  <paragraph>d-Pantothenic Acid        Min.                                   460 mg/lb</paragraph>
                  <paragraph>Niacin                          Min.                                   800 mg/lb</paragraph>
                  <paragraph>Thiamine                      Min.                                    71 mg/lb</paragraph>
                  <paragraph>Vitamin B6                   Min.                                     65 mg/lb</paragraph>
                  <paragraph/>
                  <paragraph>
                     <content styleCode="bold">INGREDIENTS</content>
                  </paragraph>
                  <paragraph>Roughage Products, Salt Dicalcium Phosphate, Calcium Carbonate, Mineral Oil, Ferrous Sulfate, Natural and Artificial Flavors Added, Thiamine Mononitrate, Niacin Supplement, d-Calcium Pantothenate, Vitamin A Acetate in Gelatin, Vitamin B12 Supplement, Riboflavin Supplement, Vitamin D3 Supplement, Pyridoxine Hydrochloride and Potassium Iodide.</paragraph>
               </text>
               <effectiveTime value="20150707"/>
            </section>
