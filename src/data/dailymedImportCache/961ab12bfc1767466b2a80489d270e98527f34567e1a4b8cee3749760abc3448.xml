               <code code="44425-7" codeSystem="2.16.840.1.113883.6.1" displayName="STORAGE AND HANDLING SECTION"/>
               <title>Other information</title>
               <text>
                  <list listType="unordered" styleCode="disc">
                     <item>
                        <content styleCode="bold">each 5 mL contains:</content> sodium 4 mg</item>
                     <item>
                        <content styleCode="bold">do not use if carton is opened or if imprinted safety seal is broken or missing</content>
                     </item>
                     <item>see bottom panel for lot number and expiration date</item>
                     <item>store between 20° to 25°C (68° to 77°F)</item>
                  </list>
               </text>
               <effectiveTime value="20220726"/>
            </section>
