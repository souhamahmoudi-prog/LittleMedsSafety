               <text>
                  <list listType="unordered">
                     <item>
                        <content styleCode="bold">each teaspoon (5 mL) contains: </content>sodium 1 mg
  </item>
                     <item>Store between 15°-30°C (59°-86°F)</item>
                     <item>Protect from Freezing and light</item>
                  </list>
               </text>
               <effectiveTime value="20260616"/>
            </section>
