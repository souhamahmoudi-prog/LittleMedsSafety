               <code code="34069-5" codeSystem="2.16.840.1.113883.6.1" displayName="HOW SUPPLIED SECTION"/>
               <title>HOW SUPPLIED</title>
               <text>
                  <paragraph>Clindamycin Phosphate Topical Solution USP, 1% is available as follows:</paragraph>
                  <paragraph>A jar containing 60 single-use pledget applicators (NDC 45802-<content styleCode="bold">263</content>-37)</paragraph>
                  <paragraph>A jar containing 69 single-use pledget applicators (NDC 45802-<content styleCode="bold">263</content>-93)</paragraph>
               </text>
               <effectiveTime value="20180316"/>
            </section>
         </component>
