         <component>
            <section ID="LINK_b20b2cca-7345-4ecd-8a8d-1d72aa03912e">
               <id root="db8b5ef8-b254-4fbd-893d-074f8174865e"/>
               <code code="34068-7" codeSystem="2.16.840.1.113883.6.1" displayName="DOSAGE &amp; ADMINISTRATION SECTION"/>
               <title>
                  <content styleCode="italics">Directions</content>
               </title>
               <text>
                  <list listType="unordered">
                     <item>
                        <caption>▪</caption>find right dose on chart below</item>
                     <item>
                        <caption>▪</caption>Chew one tablet completely at the onset of symptoms. Do not swallow tablets whole.</item>
                     <item>
                        <caption>▪</caption>take every 4 to 6 hours or as directed by a doctor</item>
                     <item>
                        <caption>▪</caption>do not take more than 6 times in 24 hours</item>
                  </list>
                  <table width="100%">
                     <col width="50%"/>
                     <col width="50%"/>
                     <tbody>
                        <tr>
                           <td styleCode="Rrule Botrule Lrule Toprule " valign="top">
                              <paragraph>
                                 <content styleCode="bold">Age (Yr)</content>
                              </paragraph>
                           </td>
                           <td styleCode="Rrule Botrule Lrule Toprule " valign="top">
                              <paragraph>
                                 <content styleCode="bold">Dose (Chewable tablets)</content>
                              </paragraph>
                           </td>
                        </tr>
                        <tr>
                           <td styleCode="Rrule Lrule Toprule Botrule " valign="top">
                              <paragraph>children under 2 years</paragraph>
                           </td>
                           <td styleCode="Rrule Lrule Toprule Botrule " valign="top">
                              <paragraph>do not use </paragraph>
                           </td>
                        </tr>
                        <tr>
                           <td styleCode="Rrule Lrule Botrule " valign="top">
                              <paragraph>children 2 to 5 years</paragraph>
                           </td>
                           <td styleCode="Rrule Lrule Botrule " valign="top">
                              <paragraph>do not use unless directed by a doctor </paragraph>
                           </td>
                        </tr>
                        <tr>
                           <td styleCode="Rrule Lrule Botrule " valign="top">
                              <paragraph>children 6 to 11 years of age </paragraph>
                           </td>
                           <td styleCode="Rrule Lrule Botrule " valign="top">
                              <paragraph>1 to 2 chewable tablets (12.5 mg to 25 mg)</paragraph>
                           </td>
                        </tr>
                        <tr>
                           <td styleCode="Rrule Botrule Lrule " valign="top">
                              <paragraph>adults and children 12 years of age and over <br/>
                              </paragraph>
                           </td>
                           <td styleCode="Rrule Botrule Lrule " valign="top">
                              <paragraph>2 to 4 tablets (25 mg to 50 mg)</paragraph>
                           </td>
                        </tr>
                     </tbody>
                  </table>
               </text>
               <effectiveTime value="20260226"/>
            </section>
         </component>
         <component>
            <section ID="LINK_53f1fdf6-2acb-4458-b587-1df7f6fea963">
