         <component>
            <section ID="ID_0fd3ded3-9f7a-482f-a892-7814c54eb50e">
               <id root="f0d88391-bb5e-49d6-a660-86d25fc46014"/>
               <code code="34068-7" codeSystem="2.16.840.1.113883.6.1" displayName="DOSAGE &amp; ADMINISTRATION SECTION"/>
               <title>Directions</title>
               <text>
                  <list listType="unordered">
                     <item>
                        <caption>•</caption>use only with enclosed dosing cup</item>
                     <item>
                        <caption>•</caption>find right dose on chart below</item>
                     <item>
                        <caption>•</caption>mL = milliliter</item>
                  </list>
                  <table width="504pt">
                     <col width="37%"/>
                     <col width="63%"/>
                     <tbody>
                        <tr>
                           <td styleCode="Rrule Botrule " valign="top">
                              <paragraph>adults and children 6 years and over</paragraph>
                           </td>
                           <td styleCode="Botrule Lrule " valign="top">
                              <paragraph>5 mL or 10 mL once daily depending upon severity of symptoms; do not take more than 10 mL in 24 hours.</paragraph>
                           </td>
                        </tr>
                        <tr>
                           <td styleCode="Rrule Botrule " valign="top">
                              <paragraph>adults 65 years and over</paragraph>
                           </td>
                           <td styleCode="Lrule Toprule Botrule " valign="top">
                              <paragraph>5 mL once daily; do not take more than 5 mL in 24 hours.</paragraph>
                           </td>
                        </tr>
                        <tr>
                           <td styleCode="Rrule Botrule " valign="top">
                              <paragraph>children 2 to under 6 years of age</paragraph>
                           </td>
                           <td styleCode="Lrule Toprule Botrule " valign="top">
                              <paragraph>2.5 mL once daily. If needed, dose can be increased to a maximum of 5 mL once daily or 2.5 mL every 12 hours. Do not give more than 5 mL in 24 hours.</paragraph>
                           </td>
                        </tr>
                        <tr>
                           <td styleCode="Rrule Botrule " valign="top">
                              <paragraph>children under 2 years of age</paragraph>
                           </td>
                           <td styleCode="Lrule Toprule Botrule " valign="top">
                              <paragraph>ask a doctor</paragraph>
                           </td>
                        </tr>
                        <tr>
                           <td styleCode="Rrule Toprule " valign="top">
                              <paragraph>consumers with liver or kidney disease</paragraph>
                           </td>
                           <td styleCode="Lrule Toprule " valign="top">
                              <paragraph>ask a doctor</paragraph>
                           </td>
                        </tr>
                     </tbody>
                  </table>
               </text>
               <effectiveTime value="20260213"/>
            </section>
         </component>
         <component>
            <section ID="ID_e82ad3aa-0ba2-4d49-adc2-c8bea3cb8593">
