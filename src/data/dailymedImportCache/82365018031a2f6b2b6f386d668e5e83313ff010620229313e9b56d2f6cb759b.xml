         <component>
            <section ID="ID_d748e65c-eab2-4451-a604-d7a6150bbcd7">
               <id root="447fd2a6-f956-cc50-e063-6394a90a84ed"/>
               <code code="34068-7" codeSystem="2.16.840.1.113883.6.1" displayName="DOSAGE &amp; ADMINISTRATION SECTION"/>
               <title>Directions</title>
               <text>
                  <list listType="unordered">
                     <item>
                        <content styleCode="bold">this product does not contain directions or complete warnings for adult use</content>
                     </item>
                     <item>
                        <content styleCode="bold">do not give more than directed (see
   
    <content styleCode="underline">
                              <linkHtml href="#overdose">overdose warning</linkHtml>
                           </content>)
  
   </content>
                     </item>
                     <item>
                        <content styleCode="bold">shake well before using</content>
                     </item>
                     <item>mL = milliliter</item>
                     <item>find right dose on chart below. If possible, use weight to dose; otherwise, use age.</item>
                     <item>remove the child protective cap and squeeze your child's dose into the dosing cup</item>
                     <item>repeat dose every 4 hours, while symptoms last</item>
                     <item>do not give more than 5 times in 24 hours</item>
                  </list>
                  <table width="60%">
                     <col width="19%"/>
                     <col width="19%"/>
                     <col width="23%"/>
                     <thead>
                        <tr>
                           <th align="left" styleCode="Rrule Botrule Lrule Toprule " valign="top">
