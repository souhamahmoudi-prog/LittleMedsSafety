               <code code="51945-4" codeSystem="2.16.840.1.113883.6.1" displayName="PACKAGE LABEL.PRINCIPAL DISPLAY PANEL"/>
               <title>Package/Label Principal Display Panel </title>
               <text>
                  <paragraph>MAJOR<sup>®</sup>
                  </paragraph>
                  <paragraph>compare to the active ingredient in Children’s Claritin<sup>®</sup>
                  </paragraph>
                  <paragraph>children’s loratadine oral solution </paragraph>
                  <paragraph>loratadine oral solution USP, 5 mg/5 mL</paragraph>
                  <paragraph>antihistamine</paragraph>
                  <paragraph>allergy</paragraph>
                  <paragraph>indoor &amp; outdoor allergies</paragraph>
                  <paragraph>non-drowsy<sup>*</sup>
                  </paragraph>
                  <paragraph>24-hour relief of:</paragraph>
                  <paragraph>• sneezing</paragraph>
                  <paragraph>• runny nose</paragraph>
                  <paragraph>• itchy, watery eyes</paragraph>
                  <paragraph>• itchy throat or nose</paragraph>
                  <paragraph>dye-free</paragraph>
                  <paragraph>sugar-free</paragraph>
                  <paragraph>ages 2 years and older</paragraph>
                  <paragraph>*when taken as directed. See drug facts panel.</paragraph>
                  <paragraph>grape flavor</paragraph>
                  <paragraph>dosing cup included</paragraph>
                  <paragraph>4 fl oz (120 mL)</paragraph>
                  <renderMultiMedia ID="id2090034502" referencedObject="C34D646A-8313-4ABB-89A3-5B8013D48EB2"/>
               </text>
