               <code code="51945-4" codeSystem="2.16.840.1.113883.6.1" displayName="PACKAGE LABEL.PRINCIPAL DISPLAY PANEL"/>
               <text>
                  <paragraph>
                     <content styleCode="bold">Pediatrician Preferred #1 INGREDIENTS*</content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">Genexa
   <sup>®</sup>
                     </content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">CLEAN MEDICINE</content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">Infants' Pain Reliever &amp; Fever Reducer</content>
                  </paragraph>
                  <paragraph>
