               <code code="55106-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ACTIVE INGREDIENT SECTION"/>
               <title>Active ingredient (in each 5 mL)</title>
               <text>
                  <paragraph>
                     <content styleCode="bold">Acetaminophen 160 mg</content>
                  </paragraph>
               </text>
               <effectiveTime value="20240415"/>
            </section>
