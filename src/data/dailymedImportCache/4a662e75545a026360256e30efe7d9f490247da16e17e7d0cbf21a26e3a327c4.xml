               <code code="53413-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - QUESTIONS SECTION"/>
               <text>
                  <paragraph>
                     <content styleCode="italics">
                        <content styleCode="bold">Questions?</content>
                     </content> Call weekdays from 9:30 AM to 4:30 </paragraph>
                  <paragraph>PM EST at <content styleCode="bold">1-877-798-5944</content>
                  </paragraph>
               </text>
               <effectiveTime value="20201001"/>
