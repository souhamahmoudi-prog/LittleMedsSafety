         <component>
            <section ID="Overdose">
               <id root="04c4d960-a572-9d51-e063-6394a90a6666"/>
               <code code="34088-5" codeSystem="2.16.840.1.113883.6.1" displayName="OVERDOSAGE SECTION"/>
               <text>
                  <paragraph>In case of overdose, get medical help or contact a Poison Control Center right away.</paragraph>
               </text>
               <effectiveTime value="20230712"/>
            </section>
