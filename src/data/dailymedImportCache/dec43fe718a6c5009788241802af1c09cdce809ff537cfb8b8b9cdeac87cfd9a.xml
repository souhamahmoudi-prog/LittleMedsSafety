               <code code="34067-9" codeSystem="2.16.840.1.113883.6.1" displayName="INDICATIONS &amp; USAGE SECTION"/>
               <text>
                  <paragraph/>
                  <paragraph>
                     <content styleCode="italics">
                        <content styleCode="bold">Uses:</content>
                     </content>Temporarily relieves minor aches and pains due to: ■ headache

 </paragraph>
                  <paragraph>■ backache ■ muscular aches ■ minor pain of arthritis ■ the common cold</paragraph>
                  <paragraph>■ toothache ■ premenstrual and menstrual cramps</paragraph>
                  <paragraph>Temporarily reduces fever.</paragraph>
               </text>
               <effectiveTime value="20231201"/>
            </section>
