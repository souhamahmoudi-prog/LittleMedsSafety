               <code code="53413-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - QUESTIONS SECTION"/>
               <title>Questions or comments?</title>
               <text>
                  <paragraph>Call <content styleCode="bold">1-800-910-6874</content>
                  </paragraph>
               </text>
               <effectiveTime value="20260721"/>
            </section>
         </component>
