               <code code="60561-8" codeSystem="2.16.840.1.113883.6.1" displayName="OTHER SAFETY INFORMATION"/>
               <text>
                  <paragraph>
                     <content styleCode="italics">
                        <content styleCode="bold">Other information</content>
                     </content>
                     <br/>
                     <content styleCode="bold">■ each 5 ml contains:</content> sodium 3 mg<br/>■ store between 20-25°C (68-7TF)<br/>■ do not refrigerate</paragraph>
               </text>
               <effectiveTime value="20181007"/>
            </section>
         </component>
