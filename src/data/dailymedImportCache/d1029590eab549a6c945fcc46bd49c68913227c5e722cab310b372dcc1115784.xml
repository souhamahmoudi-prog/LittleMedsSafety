               <text>
                  <paragraph>
                     <content styleCode="italics">
                        <content styleCode="bold">Other information</content>
                     </content>
                     <br/>■ <content styleCode="bold">each 5 mL contains:</content> sodium 2 mg<br/>■ store between 20-2S° C (68-77° F)<br/>■ <content styleCode="bold">do not use if printad </content>
                     <content styleCode="bold">neckband is broken or missing</content>
                  </paragraph>
