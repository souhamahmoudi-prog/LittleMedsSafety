               <text>
                  <paragraph>
                     <content styleCode="bold">KEEP THIS PRODUCT OUT OF REACH OF CHILDREN.</content>
                  </paragraph>
               </text>
               <effectiveTime value="20250709"/>
            </section>
         </component>
         <component>
