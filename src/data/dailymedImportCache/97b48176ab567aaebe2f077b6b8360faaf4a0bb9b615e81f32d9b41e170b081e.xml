         <component>
            <section ID="id_link_49d34900-31f6-c9be-e063-6394a90ae29b">
               <id root="49d34900-31f5-c9be-e063-6394a90ae29b"/>
               <code code="55105-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - PURPOSE SECTION"/>
               <text>
                  <paragraph>
                     <content styleCode="italics">
                        <content styleCode="bold">Purpose</content>
                     </content>
                  </paragraph>
                  <paragraph>Antihistamine</paragraph>
               </text>
               <effectiveTime value="20260202"/>
            </section>
