                  <section ID="id_link_54789a34-7ecd-8902-e063-6294a90a5b04">
                     <id root="54789bf5-11c2-6a20-e063-6394a90a88e3"/>
                     <code code="50568-5" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ASK DOCTOR/PHARMACIST SECTION"/>
                     <title>
                        <content styleCode="bold">Ask a doctor or pharmacist before use if your child is</content>
                     </title>
                     <text>
                        <paragraph>taking the blood thinning drug warfarin
  <br/>
                           <br/>
                        </paragraph>
                     </text>
                     <effectiveTime value="20260617"/>
                  </section>
               </component>
               <component>
                  <section ID="id_link_547888b7-e32f-7906-e063-6294a90a2cd8">
                     <id root="5478859e-6ef6-74f7-e063-6294a90a21df"/>
                     <code code="50567-7" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - WHEN USING SECTION"/>
                     <title>
                        <content styleCode="bold">When using this product</content>
                     </title>
                     <text>
                        <paragraph>
                           <content styleCode="bold">do not exceed recomended dose (see overdose warning)</content>
                        </paragraph>
                     </text>
                     <effectiveTime value="20260617"/>
                  </section>
               </component>
               <component>
                  <section ID="id_link_5478ae3a-add3-7626-e063-6394a90ae17b">
                     <id root="5478ae8b-3b06-7a72-e063-6294a90a2e01"/>
                     <code code="50566-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - STOP USE SECTION"/>
                     <title>
                        <content styleCode="bold">Stop use and ask a dctor if</content>
                     </title>
                     <text>
                        <list listType="unordered">
                           <item>new symptoms occur   </item>
                           <item>redness or swelling is present</item>
                           <item>pain gets worse or lasts more than 5 days</item>
                           <item>fever gets worse or lasts more than 3 days
   <br/>
	These could be signs of a serious condition.
   <br/>
                           </item>
                        </list>
                     </text>
                     <effectiveTime value="20260617"/>
                  </section>
               </component>
               <component>
                  <section ID="id_link_5478b52e-ce2f-11a7-e063-6294a90aabcc">
                     <id root="5478b209-b57a-899c-e063-6394a90a96c5"/>
                     <code code="50565-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - KEEP OUT OF REACH OF CHILDREN SECTION"/>
                     <title>
                        <content styleCode="bold">Keep out of reach of children</content>
                     </title>
                     <text>
                        <paragraph>Keep out of reach of children</paragraph>
                     </text>
                     <effectiveTime value="20260617"/>
                  </section>
               </component>
               <component>
                  <section ID="id_link_5478b8fb-e3d4-a111-e063-6294a90a955d">
                     <id root="5478b951-6d18-913c-e063-6394a90aa815"/>
                     <code code="34088-5" codeSystem="2.16.840.1.113883.6.1" displayName="OVERDOSAGE SECTION"/>
                     <title>
                        <content styleCode="bold">Overdose warning</content>
                     </title>
                     <text>
                        <paragraph>Taking more than the recommended dose (overdose) may cause liver damage. In case of overdose, get medical help or contact a Poison Control Center right away 1-800-222-1222. Quick medical attention is critical for adults as well as for children even if you do not notice any signs or symptoms
  <br/>
                        </paragraph>
                     </text>
                     <effectiveTime value="20260617"/>
                  </section>
               </component>
            </section>
