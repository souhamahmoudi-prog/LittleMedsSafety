               <code code="44425-7" codeSystem="2.16.840.1.113883.6.1" displayName="STORAGE AND HANDLING SECTION"/>
               <title>
                  <content styleCode="italics">Other information</content>
               </title>
               <text>
                  <paragraph>■
 
  <content styleCode="bold">each capsule contains:</content>
                     <content styleCode="bold">potassium 20 mg</content>
                  </paragraph>
                  <paragraph>■ read all warnings and directions before use. Keep carton.</paragraph>
                  <paragraph>■ store at 20° to 25°C (68° to 77°F)</paragraph>
                  <paragraph>■ avoid excessive heat above 40°C (104°F)</paragraph>
                  <paragraph>■ protect from light</paragraph>
               </text>
               <effectiveTime value="20211015"/>
            </section>
         </component>
