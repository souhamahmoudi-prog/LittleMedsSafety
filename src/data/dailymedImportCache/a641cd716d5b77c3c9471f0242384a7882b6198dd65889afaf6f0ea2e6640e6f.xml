               <code code="60561-8" codeSystem="2.16.840.1.113883.6.1" displayName="OTHER SAFETY INFORMATION"/>
               <title>Additional Information </title>
               <text>
                  <paragraph>
                     <content styleCode="bold">PEEL BACK HERE</content>
