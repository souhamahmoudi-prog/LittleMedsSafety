               <code code="34068-7" codeSystem="2.16.840.1.113883.6.1" displayName="DOSAGE &amp; ADMINISTRATION SECTION"/>
               <title>Directions </title>
               <text>
                  <list listType="unordered">
                     <item>
                        <caption>•</caption>
                        <content styleCode="bold">do not use more than directed</content>
                     </item>
                     <item>
                        <caption>•</caption>adults: take 2 geltabs with a glass of water</item>
                     <item>
                        <caption>•</caption>if symptoms persist or worsen, ask your doctor</item>
                     <item>
                        <caption>•</caption>do not take more than 2 geltabs in 24 hours, unless directed by a doctor</item>
                     <item>
                        <caption>•</caption>under 18 years of age: as a doctor</item>
                  </list>
               </text>
               <effectiveTime value="20220728"/>
            </section>
         </component>
