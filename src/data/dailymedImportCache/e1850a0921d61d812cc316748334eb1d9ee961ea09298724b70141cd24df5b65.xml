               <title>Inactive ingredients</title>
               <text>
                  <paragraph>candelilla wax, croscarmellose sodium, crospovidone, FD&amp;C yellow no. 6 aluminum lake, hypromellose, microcrystalline cellulose,
  <br/>
polyethylene glycol, povidone, pregelatinized starch, titanium dioxide, zinc stearate
 </paragraph>
               </text>
               <effectiveTime value="20260605"/>
            </section>
         </component>
         <component>
            <section ID="id_link_538089eb-e316-7071-e063-6394a90a23ee">
               <id root="538089eb-e315-7071-e063-6394a90a23ee"/>
               <code code="53413-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - QUESTIONS SECTION"/>
               <text>
