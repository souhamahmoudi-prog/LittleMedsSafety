               <code code="44425-7" codeSystem="2.16.840.1.113883.6.1" displayName="STORAGE AND HANDLING SECTION"/>
               <title>
                  <content styleCode="italics">Other information</content>
               </title>
               <text>
                  <list listType="unordered" styleCode="Square">
                     <item>
                        <content styleCode="bold">Store between 20° to 25°C (68° to 77°F). </content>
                        <content styleCode="italics">Excursions permitted to 15°–30°C (59°–86°F) [see USP Controlled Room Temperature].</content>
                     </item>
                     <item>
                        <content styleCode="bold">Tamper Evident </content>
                     </item>
                     <item>
                        <content styleCode="bold">Do not use if foil seal over mouth of the bottle is torn, broken or missing</content>
                     </item>
                     <item>
                        <content styleCode="bold">Dosing cup should be washed and left to air dry after each use.</content>
                     </item>
                  </list>
               </text>
               <effectiveTime value="20260518"/>
            </section>
         </component>
