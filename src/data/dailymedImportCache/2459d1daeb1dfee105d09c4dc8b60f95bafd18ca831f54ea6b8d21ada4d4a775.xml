         <component>
            <section ID="_6885c173-997b-4d80-eaee-feb1c72aedae">
               <id root="503ffc2e-6e99-4e3b-98dd-089dacc05e9a"/>
               <code code="34068-7" codeSystem="2.16.840.1.113883.6.1" displayName="DOSAGE &amp; ADMINISTRATION SECTION"/>
               <title>Directions</title>
               <text>
                  <table width="100%">
                     <col width="50%"/>
                     <col width="50%"/>
                     <tbody>
                        <tr>
                           <td styleCode="Rrule Botrule Toprule " valign="top">
                              <paragraph>adults and children 6 years and over</paragraph>
                           </td>
                           <td styleCode="Botrule Toprule " valign="top">
                              <paragraph>one 10 mg tablet once daily; do not take more than one 10 mg tablet in 24 hours. A 5 mg product may be appropriate for less severe symptoms.</paragraph>
                           </td>
                        </tr>
                        <tr>
                           <td styleCode="Rrule Botrule " valign="top">
                              <paragraph>adults 65 years and over</paragraph>
                           </td>
                           <td styleCode="Botrule " valign="top">
                              <paragraph>ask a doctor</paragraph>
                           </td>
                        </tr>
                        <tr>
                           <td styleCode="Rrule Botrule " valign="top">
                              <paragraph>children under 6 years of age</paragraph>
                           </td>
                           <td styleCode="Botrule " valign="top">
                              <paragraph>ask a doctor</paragraph>
                           </td>
                        </tr>
                        <tr>
                           <td styleCode="Rrule Botrule " valign="top">
                              <paragraph>consumers with liver or kidney disease</paragraph>
                           </td>
                           <td styleCode="Botrule " valign="top">
                              <paragraph>ask a doctor</paragraph>
                           </td>
                        </tr>
                     </tbody>
                  </table>
               </text>
               <effectiveTime value="20260325"/>
            </section>
         </component>
         <component>
