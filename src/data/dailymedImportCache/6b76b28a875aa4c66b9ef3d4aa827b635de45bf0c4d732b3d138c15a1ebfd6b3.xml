               <code code="50565-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - KEEP OUT OF REACH OF CHILDREN SECTION"/>
               <title>
                  <content styleCode="bold">Keep our of reach of children</content>
               </title>
               <text>
                  <paragraph>
                     <content styleCode="bold">Keep out of reach of children.</content>
                  </paragraph>
                  <paragraph>If swallowed, get medical help or contact a Poison Control Center immediately.</paragraph>
               </text>
