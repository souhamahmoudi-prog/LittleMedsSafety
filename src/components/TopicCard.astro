---
interface Props {
  title: string;
  description: string;
  href: string;
  icon: 'intro' | 'culture' | 'quality' | 'human';
}

const { title, description, href, icon } = Astro.props;
---

<a class="topic-card" href={href}>
  <span class="topic-card__icon" aria-hidden="true">
    {
      icon === 'intro' && (
        <svg viewBox="0 0 24 24">
          <path d="M6 4h9a3 3 0 0 1 3 3v13H8a2 2 0 0 0-2 2z" />
          <path d="M6 4v18" />
          <path d="M9 8h5" />
          <path d="M9 12h6" />
        </svg>
      )
    }
    {
      icon === 'culture' && (
        <svg viewBox="0 0 24 24">
          <circle cx="8" cy="8" r="3" />
          <circle cx="16" cy="8" r="3" />
          <path d="M3.5 20c.7-4 2.4-6 4.5-6s3.8 2 4.5 6" />
          <path d="M11.5 20c.7-4 2.4-6 4.5-6s3.8 2 4.5 6" />
        </svg>
      )
    }
    {
      icon === 'quality' && (
        <svg viewBox="0 0 24 24">
          <path d="M4 19V5" />
          <path d="M4 19h16" />
          <path d="m7 15 3-3 3 2 5-7" />
          <path d="M18 7h-4" />
          <path d="M18 7v4" />
        </svg>
      )
    }
    {
      icon === 'human' && (
        <svg viewBox="0 0 24 24">
          <circle cx="12" cy="6" r="3" />
          <path d="M5 21c.8-5.2 3.1-8 7-8s6.2 2.8 7 8" />
          <path d="M8 16h8" />
          <path d="M9.5 19h5" />
        </svg>
      )
    }
  </span>
  <span class="topic-card__body">
    <strong>{title}</strong>
    <span>{description}</span>
    <em>Explore topic</em>
  </span>
  <span class="topic-card__arrow" aria-hidden="true">→</span>
</a>
