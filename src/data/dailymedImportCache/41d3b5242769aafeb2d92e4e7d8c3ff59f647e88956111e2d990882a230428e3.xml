         <component>
            <section>
               <id root="29a12559-c0d0-2b55-e063-6394a90a9255"/>
               <code code="34068-7" codeSystem="2.16.840.1.113883.6.1" displayName="DOSAGE &amp; ADMINISTRATION SECTION"/>
               <text>
                  <table width="75%">
                     <col width="40%" align="left" valign="top"/>
                     <col width="60%" align="left" valign="top"/>
                     <tbody>
                        <tr styleCode="Botrule">
                           <td colspan="2" align="left" styleCode="Lrule Rrule" valign="top">
                              <content styleCode="bold">
                                 <content styleCode="italics">Directions</content>
                              </content>
                              <list listType="unordered" styleCode="Disc">
                                 <item>use only with enclosed dosing cup</item>
                                 <item>find right dose on chart below</item>
                                 <item>mL = milliliter</item>
                              </list>
                           </td>
                        </tr>
                        <tr styleCode="Botrule">
                           <td styleCode="Lrule Rrule">adults and children 6 years and over</td>
                           <td styleCode="Rrule">5 mL or 10 mL once daily depending upon severity of symptoms; do not take more than 10 mL in 24 hours.</td>
                        </tr>
                        <tr styleCode="Botrule">
                           <td styleCode="Lrule Rrule">adults 65 years and over</td>
                           <td styleCode="Rrule">5 mL once daily; do not take more than 5 mL in 24 hours.</td>
                        </tr>
                        <tr styleCode="Botrule">
                           <td styleCode="Lrule Rrule">children 2 to under 6 years of age</td>
                           <td styleCode="Rrule">2.5 mL once daily. If needed, dose can be increased to a maximum of 5 mL once daily or 2.5 mL every 12 hours. Do not give more than 5 mL in 24 hours.</td>
                        </tr>
                        <tr styleCode="Botrule">
                           <td styleCode="Lrule Rrule">children under 2 years of age</td>
                           <td styleCode="Rrule">ask a doctor</td>
                        </tr>
                        <tr>
                           <td styleCode="Lrule Rrule">consumers with liver or kidney disease</td>
                           <td styleCode="Rrule">ask a doctor</td>
                        </tr>
                     </tbody>
                  </table>
               </text>
               <effectiveTime value="20200206"/>
            </section>
         </component>
