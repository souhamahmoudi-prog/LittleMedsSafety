         <component>
            <section ID="LINK_f3631299-5e0c-4618-88aa-22fb4bb0e598">
               <id root="4f79a122-c8c2-4699-b8da-d0190ee27959"/>
               <code code="51945-4" codeSystem="2.16.840.1.113883.6.1" displayName="PACKAGE LABEL.PRINCIPAL DISPLAY PANEL"/>
               <title>Prinicipal display panel</title>
               <text>
                  <paragraph>†Compare to the active ingredient in Children's Motrin®</paragraph>
                  <paragraph>For ages 2-11 Years<br/>
                  </paragraph>
                  <paragraph>Children's</paragraph>
                  <paragraph>Ibuprofen</paragraph>
                  <paragraph>100 mg per 5 mL<br/>
                  </paragraph>
                  <paragraph>Oral Suspension, USP (NSAID)<br/>
