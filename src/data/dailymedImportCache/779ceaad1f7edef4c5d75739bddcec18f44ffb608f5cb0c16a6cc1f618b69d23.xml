               <code code="44425-7" codeSystem="2.16.840.1.113883.6.1" displayName="STORAGE AND HANDLING SECTION"/>
               <title>
                  <content styleCode="italics">
                     <content styleCode="bold">Other information</content>
                  </content>
               </title>
               <text>
                  <list listType="unordered" styleCode="Square">
                     <item>
                        <content styleCode="bold">each 5 mL contains: </content>sodium 4 mg<br/>
                     </item>
                     <item>store at 25ºC (77ºF); excursions permitted between 15º-30ºC (59º-86ºF)</item>
                     <item>see end flap for expiration date and lot number</item>
                  </list>
               </text>
               <effectiveTime value="20250428"/>
            </section>
