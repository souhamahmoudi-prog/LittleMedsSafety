            <section ID="ID35">
               <id root="0a429548-61c7-46f0-8422-e1d1a96b9284"/>
               <code code="34088-5" codeSystem="2.16.840.1.113883.6.1" displayName="OVERDOSAGE SECTION"/>
               <title>OVERDOSAGE</title>
               <text>
                  <paragraph ID="ID36">Topically applied clindamycin phosphate gel can be absorbed in sufficient amounts to produce systemic effects (see <content styleCode="bold">
                        <linkHtml href="#ID16">WARNINGS</linkHtml>
                     </content>).</paragraph>
               </text>
               <effectiveTime value="20230920"/>
            </section>
         </component>
         <component>
            <section ID="ID37">
               <id root="0c552d39-e121-4559-b44f-09909a954654"/>
               <code code="34068-7" codeSystem="2.16.840.1.113883.6.1" displayName="DOSAGE &amp; ADMINISTRATION SECTION"/>
               <title>DOSAGE AND ADMINISTRATION</title>
               <text>
                  <paragraph ID="ID38">Apply a thin film of clindamycin phosphate gel twice daily to affected area. </paragraph>
                  <paragraph>Keep containers tightly closed.</paragraph>
               </text>
               <effectiveTime value="20230920"/>
            </section>
         </component>
         <component>
