                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">SUGAR FREE</content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">
                        <content styleCode="italics">24</content>
                     </content>
                     <br/>
                     <content styleCode="italics">Hour</content>
                  </paragraph>
                  <paragraph>Relief of:</paragraph>
                  <list listType="unordered">
                     <item>
                        <caption>•</caption>Sneezing</item>
                     <item>
                        <caption>•</caption>Runny Nose</item>
                     <item>
                        <caption>•</caption>Itchy, Watery Eyes</item>
                     <item>
                        <caption>•</caption>Itchy Throat or Nose</item>
                  </list>
                  <paragraph>
                     <content styleCode="bold">
                        <content styleCode="italics">Ages 2 years and older</content>
                     </content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="italics">Dosing Cup</content>
