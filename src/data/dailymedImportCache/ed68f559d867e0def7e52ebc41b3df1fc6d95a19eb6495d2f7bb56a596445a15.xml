               <code code="51945-4" codeSystem="2.16.840.1.113883.6.1" displayName="PACKAGE LABEL.PRINCIPAL DISPLAY PANEL"/>
               <title>Principal Display Panel</title>
               <text>
                  <paragraph>Compare to MiraLAX<sup>®</sup> active ingredient</paragraph>
                  <paragraph>H-E-B<sub>®</sub>
                  </paragraph>
                  <paragraph>Clearlax<sup>®</sup>
                  </paragraph>
                  <paragraph>Polyethylene Glycol 3350</paragraph>
                  <paragraph>Powder for Solution</paragraph>
                  <paragraph>Osmotic Laxative</paragraph>
                  <paragraph>• Relieves Occasional Constipation/Irregularity</paragraph>
                  <paragraph>• Softens Stool</paragraph>
                  <paragraph>Unflavored Powder</paragraph>
                  <paragraph>Grit Free</paragraph>
