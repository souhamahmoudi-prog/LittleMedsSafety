            <section ID="i4i_OTC_Questions_id_3649b3af-7f29-4ee5-a6f0-a8cadcb63ac1">
               <id root="4aff60aa-052e-4b49-91c7-ba2cf41072e7"/>
               <code code="53413-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - QUESTIONS SECTION"/>
               <title>Questions or comments?</title>
               <text>
                  <paragraph>
