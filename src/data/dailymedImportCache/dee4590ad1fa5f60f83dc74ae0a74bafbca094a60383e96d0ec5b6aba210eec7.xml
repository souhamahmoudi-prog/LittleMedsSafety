               <id root="8e5a0018-a609-4364-8a77-c5d1f555e0d0"/>
               <code code="55106-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ACTIVE INGREDIENT SECTION"/>
               <title>
                  <content styleCode="italics">Active ingredients</content>
               </title>
               <text>
                  <paragraph>(in each powder):<br/>Acetaminophen 260 mg<br/>Aspirin (NSAID*) 520 mg<br/>Caffeine 32.5 mg<br/>*nonsteroidal anti-inflammatory drug</paragraph>
               </text>
