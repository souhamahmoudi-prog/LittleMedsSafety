         <component>
            <section ID="LINK_0b99dd47-c4da-4b53-aa08-b0d41b071ce5">
               <id root="68935a93-b17c-45d6-a706-14b57547b093"/>
               <code code="55105-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - PURPOSE SECTION"/>
               <title>
                  <content styleCode="bold">
                     <content styleCode="italics">Purpose</content>
                  </content>
               </title>
               <text>
                  <paragraph>Pain reliever<br/>Pain reliever<br/>Pain reliever aid</paragraph>
               </text>
               <effectiveTime value="20260701"/>
            </section>
