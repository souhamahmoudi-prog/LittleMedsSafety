               <title>Inactive ingredients</title>
               <text>
                  <paragraph>FD&amp;C blue #1, gelatin, glycerin, lecithin, light mineral oil, mannitol, polyethylene glycol, purified water, sorbitol, sorbitan, white ink</paragraph>
                  <paragraph>
                     <br/>
                  </paragraph>
               </text>
               <effectiveTime value="20260723"/>
            </section>
         </component>
