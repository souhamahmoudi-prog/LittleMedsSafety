         <component>
            <section ID="LINK_dd4fde5c-1dab-4620-9941-3b9b76d86d77">
               <id root="dd4fde5c-1dab-4620-9941-3b9b76d86d77"/>
               <code code="55105-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - PURPOSE SECTION"/>
               <title>Purpose</title>
               <text>
                  <paragraph>Antihistamine </paragraph>
               </text>
