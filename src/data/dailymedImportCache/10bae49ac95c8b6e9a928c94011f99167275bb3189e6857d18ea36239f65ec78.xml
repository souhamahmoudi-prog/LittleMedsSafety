               <title>Supplement Facts</title>
               <text>
                  <table width="50%">
                     <colgroup>
                        <col width="50%" align="left" valign="top"/>
                        <col width="25%" align="right" valign="top"/>
                        <col width="25%" align="right" valign="top"/>
                     </colgroup>
                     <thead>
                        <tr styleCode="Botrule First">
                           <th styleCode="Lrule Rrule" colspan="3" align="left">Serving Size 1 Tablet</th>
