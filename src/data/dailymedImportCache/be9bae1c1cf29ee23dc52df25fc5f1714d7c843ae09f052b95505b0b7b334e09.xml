               <code code="55106-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ACTIVE INGREDIENT SECTION"/>
               <title>Drug Facts 
 <br/>  Active ingredient
</title>
               <text>
                  <paragraph>
                     <content styleCode="bold">Active ingredient</content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">(in each 5 mL teaspoonful)</content>
                  </paragraph>
                  <paragraph>Diphenhydramine HCL 12.5 mg</paragraph>
               </text>
               <effectiveTime value="20150817"/>
            </section>
