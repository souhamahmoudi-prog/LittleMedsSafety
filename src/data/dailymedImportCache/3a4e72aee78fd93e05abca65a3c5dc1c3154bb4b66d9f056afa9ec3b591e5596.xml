               <code code="51945-4" codeSystem="2.16.840.1.113883.6.1" displayName="PACKAGE LABEL.PRINCIPAL DISPLAY PANEL"/>
               <title>PRINCIPAL DISPLAY PANEL - 354 ml bottle</title>
               <text>
                  <paragraph>
                     <content styleCode="bold">VICKS
  
   <sup>®</sup>
                     </content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">FORMULA 44</content>™
 
  <content styleCode="bold">DM</content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">PAINFUL COUGH</content>
