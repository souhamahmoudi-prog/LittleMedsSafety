               <text>
                  <paragraph>
                     <content styleCode="bold">Inactive ingredients</content>
                  </paragraph>
                  <paragraph/>
                  <paragraph>acacia gum
  <sup>‡</sup>, calcium carbonate
  <sup>‡</sup>, carnauba wax (organic), cellulose
  <sup>‡</sup>, citric acid
  <sup>‡</sup>, dextrose
