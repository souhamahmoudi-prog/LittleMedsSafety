         </component>
         <component>
            <section ID="id_link_15b762dc-caf0-36b7-e063-6394a90ab15d">
               <id root="164976a1-8147-9a09-e063-6394a90ad063"/>
               <code code="51945-4" codeSystem="2.16.840.1.113883.6.1" displayName="PACKAGE LABEL.PRINCIPAL DISPLAY PANEL"/>
