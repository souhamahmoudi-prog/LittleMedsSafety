               <id root="2e5acebc-7669-ac91-e063-6294a90af2f3"/>
               <code code="55106-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ACTIVE INGREDIENT SECTION"/>
               <title>
                  <content styleCode="bold">Active</content>
                  <content styleCode="bold">I</content>
                  <content styleCode="bold">ngredient (in each dose)</content>
               </title>
               <text>
                  <paragraph>Polyethylene Glycol 3350, 17 g (cap filled to the top)</paragraph>
               </text>
