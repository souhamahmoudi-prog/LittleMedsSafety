               <text>
                  <paragraph>
                     <content styleCode="bold">Austin/Travis Co. Health &amp; Human Services Dept.<br/>1000 Toyath St Austin, TX 78702 512-972-6206</content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">MAPAP<br/>160 mg/5<br/>ML<br/>#118ML</content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">Date:</content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">Name:<br/>Dr.</content>
