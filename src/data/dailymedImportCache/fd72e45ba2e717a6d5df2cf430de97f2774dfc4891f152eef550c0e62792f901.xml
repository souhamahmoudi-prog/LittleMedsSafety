               <code code="55106-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ACTIVE INGREDIENT SECTION"/>
               <title>Active Ingredients</title>
               <text>
                  <paragraph>Acetaminophen...................325.00mg</paragraph>
                  <paragraph>Guaifenesin........................200.00mg</paragraph>
                  <paragraph>Phenylephrine HCl..................10.00mg</paragraph>
               </text>
