         <component>
            <section ID="id_link_34fdb1ad-dc5f-9cf4-e063-6294a90a6e10">
               <id root="4cc59e3b-458f-4f56-e063-6294a90ae398"/>
               <code code="50565-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - KEEP OUT OF REACH OF CHILDREN SECTION"/>
               <text>
                  <paragraph>If pregnant or breast-feeding, ask a health
  <br/>
professional before use.
 </paragraph>
                  <paragraph>
                     <br/>
                     <content styleCode="bold">Keep out of reach of children.</content>
                  </paragraph>
                  <paragraph>
                     <br/>
                     <content styleCode="bold">Overdose warning:</content> Taking more than the
  <br/>
recommended dose (overdose) may cause
  <br/>
liver damage. In case of overdose, get
  <br/>
medical help or contact a Poison Control
  <br/>
Center right away. Quick medical attention is
  <br/>
critical for adults as well as for children even
  <br/>
if you do not notice any signs or symptoms.
 </paragraph>
               </text>
               <effectiveTime value="20250402"/>
            </section>
