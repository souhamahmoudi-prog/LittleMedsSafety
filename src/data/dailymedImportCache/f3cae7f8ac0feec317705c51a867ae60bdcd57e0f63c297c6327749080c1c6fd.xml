               <title>Inactive ingredients </title>
               <text>
                  <paragraph>artificial grape flavor, aspartame, colloidal silicon dioxide, D&amp;C red #27 aluminum lake, FD&amp;C blue #2 aluminum lake, magnesium stearate, mannitol, microcrystalline cellulose, sodium starch glycolate, stearic acid</paragraph>
               </text>
               <effectiveTime value="20200127"/>
            </section>
         </component>
