            <section ID="i4i_Principal_display_panel_id_b510c3c1-5818-4d5c-af52-0b9708cad24c">
               <id root="446a3d6e-8f91-4689-e063-6394a90ac2cf"/>
               <code code="51945-4" codeSystem="2.16.840.1.113883.6.1" displayName="PACKAGE LABEL.PRINCIPAL DISPLAY PANEL"/>
               <title>Principal Display</title>
               <text>
                  <renderMultiMedia ID="id331352978" referencedObject="EFCF2465-7FD2-4FA9-A3B1-7EE2ABE04199"/>
                  <paragraph>Walgreens</paragraph>
                  <paragraph>Compare to Theraflu
 
  <sup>®</sup>Multi-Symptom Severe Cold active ingredients††

 </paragraph>
                  <paragraph>MULTI-SYMPTOM</paragraph>
                  <paragraph>
                     <content styleCode="bold">Wal-Flu</content>
                     <sup>®</sup>
                     <content styleCode="bold">Severe</content>
                  </paragraph>
                  <paragraph>COLD</paragraph>
                  <paragraph>
                     <content styleCode="bold">ACETAMINOPHEN</content>
                  </paragraph>
                  <paragraph>PAIN RELIEVER/ FEVER REDUCER</paragraph>
                  <paragraph>DEXTROMETHORPHAN HBr</paragraph>
                  <paragraph>COUGH SUPPRESSANT</paragraph>
                  <paragraph>PHENYLEPHRINE HCl</paragraph>
                  <paragraph>NASAL DECONGESTANT</paragraph>
                  <paragraph>ASPARTAME FREE</paragraph>
                  <paragraph>SODIUM FREE</paragraph>
                  <list listType="unordered">
                     <item>Relieves nasal congestion, sore throat pain, cough, headache, body ache &amp; fever</item>
                  </list>
                  <paragraph>GREEN TEA &amp; HONEY LEMON FLAVORS</paragraph>
                  <paragraph>6 PACKETS</paragraph>
                  <paragraph>
                     <content styleCode="bold">READ ALL WARNINGS AND DIRECTIONS ON CARTON BEFORE USE, KEEP CARTON FOR REFERENCE, DO NOT DISCARD,</content>
                  </paragraph>
