               <component>
                  <section ID="overdose">
                     <id root="e11e00ee-07e2-23f5-e053-2995a90ab2f3"/>
                     <code code="42229-5" codeSystem="2.16.840.1.113883.6.1" displayName="SPL UNCLASSIFIED SECTION"/>
                     <title>Overdose warning</title>
                     <text>
                        <paragraph>In case of overdose, get medical help or contact a Poison Control Center right away. Quick medical attention is critical for adults &amp; for children even if you do not notice any signs or symptoms.</paragraph>
                     </text>
                     <effectiveTime value="20220523"/>
                  </section>
               </component>
            </section>
