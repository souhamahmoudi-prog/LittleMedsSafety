         <component>
            <section ID="dir">
               <id root="49e3a099-4622-d038-e063-6394a90a90a6"/>
               <code code="34068-7" codeSystem="2.16.840.1.113883.6.1" displayName="DOSAGE &amp; ADMINISTRATION SECTION"/>
               <title>Directions</title>
               <text>
                  <list listType="unordered" styleCode="Disc">
                     <item>
                        <content styleCode="bold">this product does not contain directions or warnings for adult use</content>
                     </item>
                     <item>
                        <content styleCode="bold">do not use more than directed</content>
                     </item>
                     <item>remove wrapper</item>
                     <item>carefully insert suppository well up into the rectum</item>
                  </list>
                  <table width="50%">
                     <caption>Dosing Chart</caption>
                     <col width="40%" align="left" valign="top"/>
                     <col width="60%" align="left" valign="top"/>
                     <thead>
                        <tr>
                           <th styleCode="Lrule Rrule">Age</th>
                           <th styleCode="Rrule">Dose</th>
                        </tr>
                     </thead>
                     <tbody>
                        <tr styleCode="Botrule">
                           <td styleCode="Lrule Rrule">under 3 years</td>
                           <td styleCode="Rrule">Do not use unless directed by a doctor</td>
                        </tr>
                        <tr>
                           <td styleCode="Lrule Rrule">3 to 6 years</td>
                           <td styleCode="Rrule">Use 1 suppository every 4 to 6 hours (maximum of 5 doses in 24 hours)</td>
                        </tr>
                     </tbody>
                  </table>
               </text>
               <effectiveTime value="20190726"/>
            </section>
         </component>
         <component>
            <section>
               <id root="49e3a099-4623-d038-e063-6394a90a90a6"/>
               <code code="44425-7" codeSystem="2.16.840.1.113883.6.1" displayName="STORAGE AND HANDLING SECTION"/>
               <title>Other information</title>
               <text>
                  <list listType="unordered" styleCode="Disc">
                     <item>store at 2°-27°C (35°-80°F)</item>
                     <item>do not use if imprinted suppository wrapper is opened or damaged</item>
                  </list>
               </text>
               <effectiveTime value="20190726"/>
            </section>
         </component>
