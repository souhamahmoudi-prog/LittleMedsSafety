---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
---

<BaseLayout
  title="LittleMeds Safety | Pediatric Medication Safety"
  description="Clinical pediatric medication safety resources, dosing guidance, process improvement tools, and code cart audit support."
>
  <header class="site-header">
    <div class="container header-inner">
      <a class="logo" href="/" aria-label="LittleMeds Safety home">
        <span class="logo-mark" aria-hidden="true">LMS</span>
        <span>LittleMeds Safety</span>
      </a>
      <div class="header-links">
        <nav class="primary-nav" aria-label="Primary navigation">
          <a href="/topics">Topics</a>
          <a href="#tools">Tools</a>
          <a href="#resources">Resources</a>
          <a href="#about">About</a>
        </nav>
        <a class="search-link" href="#resources">Search</a>
      </div>
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">Pediatric Medication Safety</p>
          <h1>
            <span>Pediatric</span>
            <span>Medication Safety</span>
            <span>Tools &amp; Resources</span>
          </h1>
          <p class="hero-description">
            LittleMeds Safety brings together practical dosing guidance, workflow
            improvement resources, and audit tools designed for pediatric
            medication use in clinical settings.
          </p>
          <div class="hero-actions" aria-label="Primary actions">
            <a class="button button-primary" href="#resources">Explore Resources</a>
            <a class="button button-secondary" href="#tools">View Safety Tools</a>
          </div>
        </div>
        <div class="hero-image">
          <img
            src="/assets/images/hero-pediatric-medication.png"
            alt="Pediatric medication safety supplies prepared for clinical care"
          />
        </div>
      </div>
    </section>

    <section class="section workflow-section" id="topics">
      <div class="container workflow-panel">
        <div class="workflow-intro">
          <p class="eyebrow">Safer Pediatric Workflows</p>
          <h2>Build a safer pediatric medication-use process</h2>
          <p>
            A practical framework for reducing risk across prescribing,
            verification, preparation, dispensing, administration, monitoring,
            and follow-up.
          </p>
        </div>

        <div class="workflow-steps" aria-label="Pediatric medication-use workflow">
          <a class="workflow-card" href="/workflow/prescribe">
            <span class="workflow-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <path d="M7 4h7l3 3v13H7z" />
                <path d="M14 4v4h4" />
                <path d="M9.5 12h5" />
                <path d="M9.5 15.5h4" />
              </svg>
            </span>
            <h3>Prescribe Safely</h3>
            <p>
              Use accurate weights, standardized order sets, dose-range checks,
              and clear indications.
            </p>
            <span class="workflow-card__arrow" aria-hidden="true">→</span>
          </a>

          <a class="workflow-card workflow-card--accent" href="/workflow/verify">
            <span class="workflow-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <circle cx="11" cy="11" r="6" />
                <path d="m16 16 4 4" />
                <path d="m8.5 11 1.7 1.7 3.4-3.8" />
              </svg>
            </span>
            <h3>Verify the Order</h3>
            <p>
              Confirm patient, weight, dose, concentration, route, frequency,
              and clinical appropriateness.
            </p>
            <span class="workflow-card__arrow" aria-hidden="true">→</span>
          </a>

          <a class="workflow-card" href="/workflow/prepare">
            <span class="workflow-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <path d="M10 3h4" />
                <path d="M11 3v5l-5.3 8.8A2.8 2.8 0 0 0 8.1 21h7.8a2.8 2.8 0 0 0 2.4-4.2L13 8V3" />
                <path d="M8.2 16h7.6" />
              </svg>
            </span>
            <h3>Prepare Consistently</h3>
            <p>
              Use standardized concentrations, clear labeling, and reduced
              unnecessary manipulation.
            </p>
            <span class="workflow-card__arrow" aria-hidden="true">→</span>
          </a>

          <a class="workflow-card" href="/workflow/dispense">
            <span class="workflow-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <path d="M4 8h16v10a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2z" />
                <path d="M7 8V6a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v2" />
                <path d="M8 13h8" />
                <path d="M8 16h5" />
              </svg>
            </span>
            <h3>Dispense Reliably</h3>
            <p>
              Apply barcode checks, independent verification, and organized
              medication storage.
            </p>
            <span class="workflow-card__arrow" aria-hidden="true">→</span>
          </a>

          <a class="workflow-card workflow-card--accent" href="/workflow/administer">
            <span class="workflow-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="m18.5 5.5-13 13" />
                <path d="m15.5 2.5 6 6" />
                <path d="m13.5 7.5 3 3" />
                <path d="m10.5 10.5 3 3" />
                <path d="M5.5 18.5 3 21" />
                <path d="m6.8 12.2 5 5" />
                <path d="M8.2 16.8 5 20" />
              </svg>
            </span>
            <h3>Administer Safely</h3>
            <p>
              Confirm the right patient, medication, dose, route, time, and
              delivery device.
            </p>
            <span class="workflow-card__arrow" aria-hidden="true">→</span>
          </a>

          <a class="workflow-card" href="/workflow/monitor">
            <span class="workflow-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <path d="M4 19V5" />
                <path d="M4 19h16" />
                <path d="m7 15 3-3 3 2 5-6" />
                <path d="M18 8h-3" />
                <path d="M18 8v3" />
              </svg>
            </span>
            <h3>Monitor and Follow Up</h3>
            <p>
              Track response, adverse effects, laboratory results, and follow-up
              needs.
            </p>
            <span class="workflow-card__arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>

    <section class="section" id="resources">
      <div class="container">
        <div class="section-heading section-heading--split">
          <div>
            <p class="eyebrow">Latest Resources</p>
            <h2>Recent pediatric safety articles</h2>
          </div>
          <a class="text-link" href="#">View all resources</a>
        </div>
        <div class="article-grid">
          <ArticleCard
            label="Dosing"
            title="Reducing pediatric dose variability"
            text="Key process checks that support accurate weight-based dosing across care transitions."
          />
          <ArticleCard
            label="Medication Use"
            title="Standardizing preparation workflows"
            text="How clinical teams can reduce handoff risk during medication preparation and verification."
          />
          <ArticleCard
            label="Emergency Care"
            title="Readiness checks for pediatric emergencies"
            text="A focused look at medication access, labeling, and review practices for urgent pediatric care."
          />
        </div>
      </div>
    </section>

    <section class="section tool-feature" id="tools">
      <div class="container">
        <div class="tool-grid">
          <div class="tool-image">
            <img
              src="/assets/images/code-cart.png"
              alt="Pediatric code cart medication safety audit tool preview"
            />
          </div>
          <div class="tool-copy">
            <p class="eyebrow">Featured Tool</p>
            <h2>Pediatric Code Cart Audit Tool</h2>
            <p>
              Support consistent review of pediatric emergency medication readiness,
              cart organization, labeling, and documentation with a focused audit
              workflow for clinical teams.
            </p>
            <a class="button button-primary" href="/tools/pediatric-code-tray-audit">Open Audit Tool</a>
          </div>
        </div>

        <div class="tools-list">
          <div class="section-heading">
            <p class="eyebrow">Medication Safety Assessment Tools</p>
            <h2>Structured reviews for pediatric medication safeguards</h2>
          </div>
          <div class="tools-card-grid">
            <a class="tools-card" href="/tools/pediatric-high-alert-medication-review">
              <strong>Pediatric High-Alert Medication Review</strong>
              <span>
                Review system safeguards for pediatric high-alert medications
                across prescribing, preparation, administration, monitoring,
                technology, and organizational learning.
              </span>
            </a>
            <a class="tools-card" href="/tools/pediatric-code-tray-audit">
              <strong>Pediatric Code Tray Audit Tool</strong>
              <span>
                Audit pediatric emergency medication tray readiness,
                organization, labeling, expiration control, and documentation.
              </span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="section trust-section" id="about">
      <div class="container trust-grid">
        <div>
          <strong>Clinically focused</strong>
          <span>Built around pediatric medication-use risk points.</span>
        </div>
        <div>
          <strong>Practical by design</strong>
          <span>Concise resources for real care-team workflows.</span>
        </div>
        <div>
          <strong>Safety-system oriented</strong>
          <span>Emphasizes process reliability and verification.</span>
        </div>
        <div>
          <strong>Child-centered</strong>
          <span>Prioritizes safer medication care for infants, children, and adolescents.</span>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container footer-inner">
      <div>
        <a class="logo" href="/" aria-label="LittleMeds Safety home">
          <span class="logo-mark" aria-hidden="true">LMS</span>
          <span>LittleMeds Safety</span>
        </a>
        <p>Pediatric medication safety resources for clinical teams.</p>
      </div>
      <nav aria-label="Footer navigation">
        <a href="/topics">Topics</a>
        <a href="#tools">Tools</a>
        <a href="#resources">Resources</a>
        <a href="#about">About</a>
      </nav>
    </div>
  </footer>
</BaseLayout>
