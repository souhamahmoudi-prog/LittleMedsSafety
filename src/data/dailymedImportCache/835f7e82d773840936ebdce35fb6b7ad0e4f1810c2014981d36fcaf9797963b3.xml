               <title>
                  <content styleCode="bold">
                     <content styleCode="italics">Principal display panel</content>
                  </content>
               </title>
               <text>
                  <paragraph>
                     <content styleCode="bold">
                        <content styleCode="italics">Walgreens</content>
                     </content>
                  </paragraph>
                  <paragraph>Compare to the active ingredients<br/>
in Vicks® ZzzQuil® Night Pain<sup>††</sup>
                  </paragraph>
                  <paragraph>WALGREENS<br/>
PHARMACIST RECOMMENDED<sup>†</sup>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">Sleep Aid <br/>
+ Pain <br/>
