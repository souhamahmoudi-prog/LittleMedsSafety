            <section>
               <id root="24fd90bc-bb85-4862-e063-6394a90a54c6"/>
               <code code="55106-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ACTIVE INGREDIENT SECTION"/>
               <effectiveTime value="20240111"/>
               <component>
                  <section>
                     <id root="24fd90bc-bb86-4862-e063-6394a90a54c6"/>
                     <code code="55105-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - PURPOSE SECTION"/>
                     <text>
                        <table width="65%">
                           <col width="50%" align="left" valign="top"/>
                           <col width="50%" align="right" valign="top"/>
                           <thead>
                              <tr styleCode="First Last">
                                 <th align="left">Active Ingredients (in each 30 mL)</th>
                                 <th align="right">Purpose</th>
                              </tr>
                           </thead>
                           <tbody>
                              <tr>
                                 <td align="left">
                                    <content styleCode="bold">Acetaminophen 650 mg</content>
                                 </td>
                                 <td align="right">Pain reliever/Fever reducer</td>
                              </tr>
                              <tr>
                                 <td align="left">Dextromethorphan HBr 20 mg</td>
                                 <td align="right">Cough suppressant</td>
                              </tr>
                              <tr>
                                 <td align="left">Phenylephrine HCl 10 mg</td>
                                 <td align="right">Nasal Decongestant</td>
                              </tr>
                           </tbody>
                        </table>
                        <paragraph/>
                     </text>
                     <effectiveTime value="20240111"/>
                  </section>
               </component>
            </section>
