            <section ID="L0def3955-cfe9-47b5-b282-8e4d90e4d78f">
               <id root="bd7e9627-7be9-4dbf-9072-439d7d66ae9c"/>
               <code code="34067-9" codeSystem="2.16.840.1.113883.6.1" displayName="INDICATIONS &amp; USAGE SECTION"/>
               <title>USES</title>
               <text>
                  <paragraph>To help restore mental alertness when experiencing fatigue.</paragraph>
               </text>
               <effectiveTime value="20150309"/>
            </section>
