               <title>
                  <content styleCode="bold">
                     <content styleCode="italics">Inactive ingredients</content>
                  </content>
               </title>
               <text>
                  <paragraph>colloidal silicon dioxide, croscarmellose sodium, lactose monohydrate, magnesium stearate, microcrystalline cellulose, opadry white OY-58900, purified water</paragraph>
               </text>
               <effectiveTime value="20200501"/>
            </section>
         </component>
