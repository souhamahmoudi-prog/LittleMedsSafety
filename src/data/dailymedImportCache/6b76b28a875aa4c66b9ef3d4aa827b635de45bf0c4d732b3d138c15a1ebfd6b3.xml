         <component>
            <section ID="id_link_49ec4f00-3275-a14b-e063-6294a90a751f">
               <id root="5461d2d4-d5fd-ba6a-e063-6294a90a2740"/>
               <code code="34067-9" codeSystem="2.16.840.1.113883.6.1" displayName="INDICATIONS &amp; USAGE SECTION"/>
               <title>
                  <content styleCode="italics">
                     <content styleCode="bold">Uses</content>
                  </content>
               </title>
               <text>
                  <paragraph>
                     <content styleCode="italics">
                        <content styleCode="bold">Uses</content>
                     </content>
                  </paragraph>
                  <list listType="unordered">
                     <item>Temporary relievies pain and itching associated with:</item>
                     <item>insect bites</item>
                     <item>minor burns</item>
                     <item>sunburn</item>
                     <item>minor skin irritations</item>
                     <item>minor cuts</item>
                     <item>scrapes</item>
                     <item>rashes due to poison ivy, poison oak and poison sumac</item>
                     <item>Dries the oozing and weeping of poison ivy, poison oak, and poison sumac</item>
                     <item/>
                  </list>
               </text>
               <effectiveTime value="20251101"/>
            </section>
         </component>
         <component>
            <section ID="id_link_49ec4f00-3277-a14b-e063-6294a90a751f">
