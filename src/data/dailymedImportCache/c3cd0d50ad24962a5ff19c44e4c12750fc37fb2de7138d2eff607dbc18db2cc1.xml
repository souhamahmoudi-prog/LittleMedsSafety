            <section ID="LINK_dcad23c9-e369-4357-b920-a1937ba89bd6">
               <id root="f8314b35-76b1-4d30-9e2f-4295f1aa9939"/>
               <code code="55105-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - PURPOSE SECTION"/>
               <title>Purpose</title>
               <text>
                  <paragraph>Antihistamine </paragraph>
               </text>
