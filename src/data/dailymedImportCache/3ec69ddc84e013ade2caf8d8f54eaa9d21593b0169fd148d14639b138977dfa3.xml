         <component>
            <section>
               <id root="28dbd7bd-8c33-ba2c-e063-6294a90a97fc"/>
               <code code="34068-7" codeSystem="2.16.840.1.113883.6.1" displayName="DOSAGE &amp; ADMINISTRATION SECTION"/>
               <title>Directions</title>
               <text>
                  <list listType="unordered" styleCode="Disc">
                     <item>use only with enclosed dosing cup</item>
                     <item>find right dose on chart below</item>
                     <item>mL = milliliter</item>
                  </list>
                  <table width="75%" styleCode="Noautorules">
                     <col width="40%" align="left" valign="top"/>
                     <col width="60%" align="left" valign="top"/>
                     <tbody>
                        <tr styleCode="Botrule">
                           <td styleCode="Rrule Toprule">adults and children 6 years and over</td>
                           <td styleCode="Toprule">5 mL or 10 mL once daily depending upon severity of symptoms; do not take more than 10 mL in 24 hours.</td>
                        </tr>
                        <tr styleCode="Botrule">
                           <td styleCode="Rrule">adults 65 years and over</td>
                           <td>5 mL once daily; do not take more than 5 mL in 24 hours.</td>
                        </tr>
                        <tr styleCode="Botrule">
                           <td styleCode="Rrule">children 2 to under 6 years of age</td>
                           <td>2.5 mL once daily. If needed, dose can be increased to a maximum of 5 mL once daily or 2.5 mL every 12 hours. Do not give more than 5 mL in 24 hours.</td>
                        </tr>
                        <tr styleCode="Botrule">
                           <td styleCode="Rrule">children under 2 years of age</td>
                           <td>ask a doctor</td>
                        </tr>
                        <tr>
                           <td styleCode="Rrule">consumers with liver or kidney disease</td>
                           <td>ask a doctor</td>
                        </tr>
                     </tbody>
                  </table>
               </text>
               <effectiveTime value="20191030"/>
            </section>
         </component>
         <component>
