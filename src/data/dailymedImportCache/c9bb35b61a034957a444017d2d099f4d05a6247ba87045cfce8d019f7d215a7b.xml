         <component>
            <section ID="LINK_b20b2cca-7345-4ecd-8a8d-1d72aa03912e">
               <id root="40030844-3c91-d02c-e063-6394a90ade7d"/>
               <code code="34068-7" codeSystem="2.16.840.1.113883.6.1" displayName="DOSAGE &amp; ADMINISTRATION SECTION"/>
               <title>
                  <content styleCode="italics">Directions</content>
               </title>
               <text>
                  <list listType="unordered">
                     <item>chew one tablet completely at the onset of symptoms. Do not swallow tablets whole.</item>
                     <item>Find right dose on chart below</item>
                     <item>take every 4 to 6 hours, or as directed by a doctor</item>
                     <item>do not take more than 6 doses in 24 hours</item>
                  </list>
                  <table width="100%" styleCode="Noautorules">
                     <col width="50%"/>
                     <col width="44%"/>
                     <tbody>
                        <tr>
                           <td styleCode="Rrule Botrule Lrule Toprule " valign="top">
                              <paragraph>
                                 <content styleCode="bold">Age (Yr)</content>
                              </paragraph>
                           </td>
                           <td styleCode="Rrule Botrule Lrule Toprule " valign="top">
                              <paragraph>
                                 <content styleCode="bold">Dose (chewable tablets)</content>
                              </paragraph>
                           </td>
                        </tr>
                        <tr>
                           <td styleCode="Rrule Lrule Botrule " valign="top">
                              <paragraph>children under 2 years of age</paragraph>
                           </td>
                           <td styleCode="Rrule Lrule Toprule Botrule " valign="top">
                              <paragraph>do not use </paragraph>
                           </td>
                        </tr>
                        <tr>
                           <td styleCode="Rrule Lrule Botrule " valign="top">
                              <paragraph>children 2 to under 5 years of age</paragraph>
                           </td>
                           <td styleCode="Rrule Lrule Toprule Botrule " valign="top">
                              <paragraph>do not use unless directed by a doctor </paragraph>
                           </td>
                        </tr>
                        <tr>
                           <td styleCode="Rrule Lrule Botrule " valign="top">
                              <paragraph>children 6 to under 12 years of age </paragraph>
                           </td>
                           <td styleCode="Rrule Lrule Toprule Botrule " valign="top">
                              <paragraph>1 to 2 tablets </paragraph>
                           </td>
                        </tr>
                        <tr>
                           <td styleCode="Rrule Botrule Lrule Toprule " valign="top">
                              <paragraph>adults and children 12 years of age and over</paragraph>
                           </td>
                           <td styleCode="Rrule Botrule Lrule Toprule " valign="top">
                              <paragraph>2 to 4 tablets</paragraph>
                           </td>
                        </tr>
                     </tbody>
                  </table>
               </text>
               <effectiveTime value="20250930"/>
            </section>
         </component>
         <component>
            <section ID="LINK_53f1fdf6-2acb-4458-b587-1df7f6fea963">
               <id root="40030844-3c92-d02c-e063-6394a90ade7d"/>
               <code code="44425-7" codeSystem="2.16.840.1.113883.6.1" displayName="STORAGE AND HANDLING SECTION"/>
               <title>
                  <content styleCode="italics">Other information</content>
               </title>
               <text>
                  <list listType="unordered">
                     <item>store below at room temperature. Avoid high humidity. Protect from light.</item>
                  </list>
               </text>
               <effectiveTime value="20220719"/>
            </section>
         </component>
