         <component>
            <section ID="Section_13">
               <id root="0b359af6-5508-cb9e-e063-6394a90a0bd0"/>
               <code code="44425-7" codeSystem="2.16.840.1.113883.6.1" displayName="STORAGE AND HANDLING SECTION"/>
               <title>Other information</title>
               <text>
                  <list listType="unordered" styleCode="Disc">
                     <item>store between 20° to 25°C (68° to 77°F). Avoid high humidity. Protect from light.</item>
                     <item>
                        <content styleCode="bold">do not use if carton is open or if printed seal on blister is broken or missing.</content>
                     </item>
                  </list>
               </text>
               <effectiveTime value="20231122"/>
            </section>
         </component>
         <component>
            <section ID="Section_18">
               <id root="0b359af6-5509-cb9e-e063-6394a90a0bd0"/>
               <code code="51727-6" codeSystem="2.16.840.1.113883.6.1" displayName="INACTIVE INGREDIENT SECTION"/>
               <title>Inactive ingredients</title>
               <text>
                  <paragraph>citric acid anhydrous, colloidal silicon dioxide, copovidone, crospovidone, D&amp;C red No. 27 lake, D&amp;C red 30 aluminum lake, dextrose monohydrate, ethylcellulose, flavor, magnesium stearate, mannitol, sodium starch glycolate, stearic acid, sucralose.</paragraph>
               </text>
               <effectiveTime value="20231122"/>
            </section>
         </component>
         <component>
            <section ID="Section_19">
               <id root="0b359af6-550a-cb9e-e063-6394a90a0bd0"/>
