               <code code="60561-8" codeSystem="2.16.840.1.113883.6.1" displayName="OTHER SAFETY INFORMATION"/>
               <title>Other information</title>
               <text>
                  <list listType="unordered">
                     <item>each 5 mL (1 tsp) contains: sodium 3 mg</item>
                     <item>store between 20-25°C (68-77°F )</item>
                     <item>do not refrigerate</item>
                     <item>keep carton for complete Drug facts</item>
                  </list>
               </text>
               <effectiveTime value="20170415"/>
            </section>
         </component>
