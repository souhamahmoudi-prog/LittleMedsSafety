               <title>
                  <content styleCode="italics">Inactive ingredients</content>
               </title>
               <text>
                  <paragraph>citric acid, crospovidone, D&amp;C Red No. 30 Lake, dextrose, FD&amp;C Blue No. 1 Lake, flavors, hydroxypropylcellulose, magnesium stearate, maltodextrin, silicon dioxide, sodium carboxymethyl cellulose, starch, sucralose</paragraph>
               </text>
               <effectiveTime value="20200226"/>
               <component>
                  <section ID="ID_ed739d7a-97cb-4e62-9174-723b4c678106">
                     <id root="41e61014-cd86-22b5-e063-6394a90a1c48"/>
                     <code code="53413-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - QUESTIONS SECTION"/>
                     <title>Questions or comments?</title>
                     <text>
                        <paragraph>
                           <content styleCode="bold">1-866-467-2748</content>
