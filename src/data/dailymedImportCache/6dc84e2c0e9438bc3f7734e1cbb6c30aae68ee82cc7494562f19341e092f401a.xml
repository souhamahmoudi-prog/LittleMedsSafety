               <code code="51727-6" codeSystem="2.16.840.1.113883.6.1" displayName="INACTIVE INGREDIENT SECTION"/>
               <title>
                  <content styleCode="italics">Inactive ingredients</content>
               </title>
               <text>
                  <paragraph>colloidal silicon dioxide, croscarmellose sodium, hypromellose, lactose monohydrate, magnesium stearate, microcrystalline cellulose, polyethylene glycol, titanium dioxide</paragraph>
               </text>
               <effectiveTime value="20260715"/>
            </section>
         </component>
