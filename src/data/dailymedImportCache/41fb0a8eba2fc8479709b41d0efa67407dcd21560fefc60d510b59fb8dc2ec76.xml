               <code code="55106-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ACTIVE INGREDIENT SECTION"/>
               <title>
                  <content styleCode="bold">
                     <content styleCode="italics">Active ingredients (in each tablet)</content>
                  </content>
               </title>
               <text>
                  <paragraph>Acetaminophen 325 mg<br/>Chlorpheniramine maleate 2 mg<br/>
                  </paragraph>
               </text>
