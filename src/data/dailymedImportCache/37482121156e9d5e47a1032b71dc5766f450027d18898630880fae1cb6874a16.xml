                     <code codeSystem="2.16.840.1.113883.6.1" code="50569-3" displayName="OTC - ASK DOCTOR SECTION"/>
                     <title>
                        <content styleCode="bold">Ask a doctor before use if you have:</content>
                     </title>
                     <text>
                        <list>
                           <item>nausea, vomiting or abdominal pain<br/>
                           </item>
                           <item>a sudden change in bowel habits that lasts over 2 weeks<br/>
                           </item>
                           <item>irritable bowel syndrome</item>
                        </list>
                     </text>
                     <effectiveTime value="20240117"/>
                  </section>
