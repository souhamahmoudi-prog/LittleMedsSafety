            <section>
               <id root="93c7801d-3488-4538-b788-bf0380a65960"/>
               <code codeSystem="2.16.840.1.113883.6.1" code="34067-9" displayName="INDICATIONS &amp; USAGE SECTION"/>
               <title>
                  <content styleCode="bold">Use</content>
               </title>
               <text>
                  <list>
                     <item>relieves occasional constipation (irregularity)<br/>
                     </item>
                     <item>generally produces a bowel movement in 1 to 3 days</item>
                  </list>
               </text>
               <effectiveTime value="20240117"/>
            </section>
