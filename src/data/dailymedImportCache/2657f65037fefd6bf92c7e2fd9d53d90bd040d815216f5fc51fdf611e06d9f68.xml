               <id root="7d2ee470-6a7a-490e-95f8-507738538c80"/>
               <code code="55106-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ACTIVE INGREDIENT SECTION"/>
               <title>
                  <content styleCode="bold">
                     <content styleCode="italics">Active ingredients (in each caplet)</content>
                  </content>
               </title>
               <text>
                  <paragraph>Acetaminophen 325 mg<br/>Guaifenesin 200 mg<br/>Phenylephrine HCl 5 mg</paragraph>
               </text>
               <effectiveTime value="20260709"/>
            </section>
