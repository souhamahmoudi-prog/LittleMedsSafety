            <section ID="ID_935640bd-1bbb-45d2-8d7c-6d9db00f8141">
               <id root="2750c21b-47d1-4195-88ed-3bee4dc60367"/>
               <code code="34088-5" codeSystem="2.16.840.1.113883.6.1" displayName="OVERDOSAGE SECTION"/>
               <title>OVERDOSAGE </title>
               <text>
                  <paragraph>Topically applied clindamycin phosphate can be absorbed in sufficient amounts to produce systemic effects (see <linkHtml href="#ID_772248e1-a3d7-4217-8d4c-822c982e65ce">WARNINGS</linkHtml>).</paragraph>
               </text>
               <effectiveTime value="20260609"/>
            </section>
         </component>
         <component>
            <section ID="ID_8b6fdb94-cbeb-4321-9ac4-15e2e34a771d">
               <id root="3a1305d9-5c03-43f4-9344-1d94b47e4b49"/>
               <code code="34068-7" codeSystem="2.16.840.1.113883.6.1" displayName="DOSAGE &amp; ADMINISTRATION SECTION"/>
               <title>DOSAGE AND ADMINISTRATION </title>
               <text>
                  <paragraph>Apply a thin film of clindamycin phosphate gel USP 1% twice daily to affected area.</paragraph>
                  <paragraph>Preserve in tightly closed containers.</paragraph>
               </text>
               <effectiveTime value="20260609"/>
            </section>
         </component>
         <component>
