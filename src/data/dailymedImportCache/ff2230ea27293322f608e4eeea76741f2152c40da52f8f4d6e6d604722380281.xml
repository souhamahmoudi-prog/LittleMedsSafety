               <title>Other information</title>
               <text>
                  <list listType="unordered" styleCode="Square">
                     <item>each 5 mL contains: 								
        
  
   <content styleCode="bold"> sodium 10 mg</content>
                     </item>
                     <item>store between 20-25°C (68-77°F)</item>
                     <item>
                        <content styleCode="bold">do not use if carton tape or bottle wrap imprinted with "Sealed For Your Safety" is broken or missing</content>
                     </item>
                  </list>
               </text>
               <effectiveTime value="20210225"/>
