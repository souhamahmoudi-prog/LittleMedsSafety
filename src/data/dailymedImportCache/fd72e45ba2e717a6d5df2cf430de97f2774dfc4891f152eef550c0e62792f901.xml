         <component>
            <section ID="L279b4c8a-2c3b-43cf-bd0a-3a03bb58a1d0">
               <id root="22346ba5-8d1e-410a-b252-72a739fbf9c7"/>
               <code code="34088-5" codeSystem="2.16.840.1.113883.6.1" displayName="OVERDOSAGE SECTION"/>
               <title>Overdose warning</title>
               <text>
                  <paragraph>In case of accidental overdose. seek professional assistance or contact a poison control center inmediately</paragraph>
               </text>
               <effectiveTime value="20170410"/>
            </section>
         </component>
         <component>
            <section ID="Lbe46e9fb-6a86-42c7-9605-656869228c42">
               <id root="0a25f289-a582-47fb-aae9-8f2049e149d2"/>
               <code code="34068-7" codeSystem="2.16.840.1.113883.6.1" displayName="DOSAGE &amp; ADMINISTRATION SECTION"/>
               <title>Directions</title>
               <text>
                  <paragraph>Take only as directed, for your convenience a dosage spoon is provided. Do not exceed 6 doses in a 24 hour period</paragraph>
                  <paragraph>Children from 6 to 12 years-----10mL or cc every 4 hours</paragraph>
                  <paragraph>
                     <content>Children under 6 years, ask your doctor</content>
                  </paragraph>
               </text>
               <effectiveTime value="20250325"/>
            </section>
         </component>
