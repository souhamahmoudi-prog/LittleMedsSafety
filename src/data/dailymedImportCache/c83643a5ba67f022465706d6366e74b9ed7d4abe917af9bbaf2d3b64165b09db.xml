               <title>
                  <content styleCode="italics">Inactive ingredients</content>
               </title>
               <text>
                  <br/>
                  <paragraph>cherry mint flavor, glacial acetic acid, glycerin, methylparaben, propylene glycol, propylparaben, purified water, sodium acetate trihydrate, sucrose</paragraph>
               </text>
               <effectiveTime value="20260309"/>
            </section>
         </component>
