               <code code="55106-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ACTIVE INGREDIENT SECTION"/>
               <title>
                  <content styleCode="italics">Active ingredient (in each dose)</content>
               </title>
               <text>
                  <paragraph>Polyethylene Glycol 3350, 17 g</paragraph>
               </text>
               <effectiveTime value="20200604"/>
            </section>
