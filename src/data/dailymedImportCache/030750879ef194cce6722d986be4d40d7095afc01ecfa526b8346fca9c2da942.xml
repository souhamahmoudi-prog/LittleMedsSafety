         <component>
            <section>
               <id root="a3e91b2e-8f01-4c38-8e13-405758a7c948"/>
               <code code="51945-4" codeSystem="2.16.840.1.113883.6.1" displayName="PACKAGE LABEL.PRINCIPAL DISPLAY PANEL"/>
               <title>PRINCIPAL DISPLAY PANEL - 6 Packet Carton </title>
               <text>
                  <paragraph>
                     <content styleCode="bold">COMPARE TO</content> the active ingredients of <content styleCode="bold">THERAFLU</content>
                     <sup>®</sup>
                     <br/>
                     <content styleCode="bold">DAYTIME SEVERE COLD &amp; COUGH</content> *See side panel</paragraph>
                  <paragraph>SEE NEW WARNINGS<br/>INFORMATION &amp; DIRECTIONS</paragraph>
                  <paragraph>
                     <content styleCode="bold">NDC 30142-112-07</content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">Kroger</content>
                     <sub>®</sub>
                  </paragraph>
                  <paragraph>FROM OUR FAMILY<br/>TO YOURS</paragraph>
                  <paragraph>
                     <content styleCode="bold">DayTime</content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">Flu + Severe<br/>Cold &amp; Cough</content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">Acetaminophen,</content> Pain Reliever/Fever Reducer<br/>Dextromethorphan HBr, Cough Suppressant<br/>Phenylephrine HCl, Nasal Decongestant</paragraph>
                  <list listType="unordered">
                     <item>Nasal &amp; Sinus Congestion</item>
                     <item>Cough</item>
                     <item>Body Ache</item>
                     <item>Sore Throat Pain</item>
                     <item>Headache</item>
                     <item>Fever</item>
                  </list>
                  <paragraph>
                     <content styleCode="bold">• Our Pharmacists •<br/>Recommend</content>
