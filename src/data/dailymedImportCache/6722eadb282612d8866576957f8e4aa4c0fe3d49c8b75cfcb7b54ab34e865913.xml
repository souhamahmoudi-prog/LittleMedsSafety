               </title>
               <text>
                  <list listType="unordered">
                     <item>
                        <content styleCode="bold">each 30 mL contains</content>: potassium 5 mg, sodium 34 mg
 
  </item>
                     <item>store at controlled room temperature 20-25°C (68-77°F)</item>
                  </list>
               </text>
               <effectiveTime value="20250113"/>
            </section>
