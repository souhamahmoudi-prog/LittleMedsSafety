         </component>
         <component>
            <section ID="Ld80b9411-271e-4756-aebd-b315d021e49b">
               <id root="eff407ba-b360-4a03-9ccc-a175170b88b5"/>
               <code code="53413-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - QUESTIONS SECTION"/>
               <text>
                  <paragraph>
                     <content styleCode="italics">
