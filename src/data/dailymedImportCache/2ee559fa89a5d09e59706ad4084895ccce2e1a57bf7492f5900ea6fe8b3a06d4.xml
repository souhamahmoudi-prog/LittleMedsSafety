               <code code="55106-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ACTIVE INGREDIENT SECTION"/>
               <title>Active ingredients (in each caplet) </title>
               <text>
                  <paragraph>Acetaminophen 250 mg</paragraph>
                  <paragraph>Ibuprofen 125 mg (NSAID*)</paragraph>
                  <paragraph>*nonsteroidal anti-inflammatory drug</paragraph>
               </text>
               <effectiveTime value="20220323"/>
            </section>
