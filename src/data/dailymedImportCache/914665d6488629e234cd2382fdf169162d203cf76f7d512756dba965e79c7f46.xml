         <component>
            <section ID="id_link_15b707b6-2f44-2949-e063-6394a90ad032">
               <id root="2e141369-9e2e-7624-e063-6294a90a25f9"/>
               <code code="51945-4" codeSystem="2.16.840.1.113883.6.1" displayName="PACKAGE LABEL.PRINCIPAL DISPLAY PANEL"/>
               <text>
                  <paragraph/>
                  <paragraph>
                     <renderMultiMedia referencedObject="img_2e14028d-ae61-5678-e063-6394a90a48d3"/>
                  </paragraph>
                  <paragraph/>
                  <paragraph>
                     <renderMultiMedia referencedObject="img_2e141291-5035-5bba-e063-6394a90abbf1"/>
