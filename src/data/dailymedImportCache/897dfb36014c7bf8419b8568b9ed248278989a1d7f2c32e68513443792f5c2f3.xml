         <component>
            <section ID="id_link_5f0effd4-5af2-d7a6-e053-2a91aa0ac4c9">
               <id root="31ce6696-9ef6-9e5b-e063-6294a90a4f34"/>
               <code code="34068-7" codeSystem="2.16.840.1.113883.6.1" displayName="DOSAGE &amp; ADMINISTRATION SECTION"/>
               <title>Directions</title>
               <text>
                  <list listType="unordered">
                     <item>
                        <content styleCode="bold">do not take more than directed</content>
                     </item>
                     <item>adults and children 12 years and over: Take 2 tablets every 6 hours, as needed; not more than 6 tablets in 24 hours. Do not 
   <br/>  take for more than 10 days unless directed by a doctor.
  </item>
                     <item>children under 12 years: ask a doctor</item>
                  </list>
               </text>
               <effectiveTime value="20110413"/>
            </section>
         </component>
