               <code code="34068-7" codeSystem="2.16.840.1.113883.6.1" displayName="DOSAGE &amp; ADMINISTRATION SECTION"/>
               <text>
                  <paragraph>Take 3-4 times daily with water. Ages 12 and older: 1-2 tablets. Ages 2-11: 1 tablet. Under age 2: Consult a doctor. </paragraph>
                  <paragraph/>
               </text>
               <effectiveTime value="20230330"/>
            </section>
