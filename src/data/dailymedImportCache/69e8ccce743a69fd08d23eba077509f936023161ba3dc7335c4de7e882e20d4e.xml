               <text>
                  <paragraph>edetate disodium, glycerin, maltitol, monobasic sodium phosphate, natural and artificial grape flavor, phosphoric acid, propylene glycol, purified water, sodium benzoate, sorbitol, sucralose</paragraph>
               </text>
               <effectiveTime value="20200730"/>
            </section>
