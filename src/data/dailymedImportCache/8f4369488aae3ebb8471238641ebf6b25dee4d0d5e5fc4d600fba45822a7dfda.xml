               <title>PRINCIPAL DISPLAY PANEL - 5 mL Unit Dose Cup</title>
               <text>
                  <paragraph>
                     <content styleCode="bold">MAJOR<sup>®</sup>
                     </content>
                  </paragraph>
                  <paragraph>0904-7278-41</paragraph>
                  <paragraph>
                     <content styleCode="bold">Children's Acetaminophen Oral Suspension</content>
                  </paragraph>
