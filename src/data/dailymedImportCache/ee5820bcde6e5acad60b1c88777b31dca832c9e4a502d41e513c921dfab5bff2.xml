            <section ID="id_link_5462de38-44d9-4dcf-e063-6394a90ab8d3">
               <id root="5462d2bc-f116-5028-e063-6394a90a949d"/>
               <code code="34068-7" codeSystem="2.16.840.1.113883.6.1" displayName="DOSAGE &amp; ADMINISTRATION SECTION"/>
               <title>
                  <content styleCode="bold">
                     <content styleCode="italics">Directions</content>
                  </content>
               </title>
               <text>
                  <list listType="unordered">
                     <item>
                        <content styleCode="bold">this product does not contain directions or complete warnings for adult use. Shake well before using</content>
                     </item>
                     <item>mL= milliliter</item>
                     <item>find right dose or chart below. If possible, use weight to dose; otherwise, use age.</item>
                     <item>repeat dose every 4 hours while symptoms last</item>
                     <item>only use enclosed measuring cup</item>
                     <item>do not give more than 5 times in 24 hours</item>
                     <item>do not give more than 5 days unless directed by a doctor.</item>
                  </list>
                  <paragraph>
                     <renderMultiMedia referencedObject="img_5462d99e-9ffb-c811-e063-6294a90ab6fb"/>
                  </paragraph>
                  <paragraph>† always check with your doctor before administering medicine to your infant/child</paragraph>
               </text>
               <effectiveTime value="20260616"/>
               <component>
                  <observationMedia ID="img_5462d99e-9ffb-c811-e063-6294a90ab6fb">
                     <text>Directions for use</text>
                     <value mediaType="image/jpeg" xsi:type="ED">
                        <reference value="OPMX DIRECTIONS.jpg"/>
                     </value>
                  </observationMedia>
               </component>
            </section>
         </component>
