            <section ID="id_link_340596e3-cc27-35cd-e063-6294a90a7b8c">
               <id root="561393c6-f877-f94a-e063-6294a90a151c"/>
               <code code="55106-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ACTIVE INGREDIENT SECTION"/>
               <title>Active ingredient (in each caplet)</title>
               <text>
                  <paragraph>Active ingredient (in each caplet) Purpose</paragraph>
                  <paragraph>Acetaminophen 250 mg.......................................................................................................Pain reliever 
  <br/>  Aspirin 250 mg (NSAID)*....................................................................................................Pain reliever 
  <br/>  Caffeine 65 mg..............................................................................................................Pain reliever aid
 </paragraph>
                  <paragraph>*nonsteroidal anti-inflammatory drug</paragraph>
               </text>
               <effectiveTime value="20250401"/>
            </section>
