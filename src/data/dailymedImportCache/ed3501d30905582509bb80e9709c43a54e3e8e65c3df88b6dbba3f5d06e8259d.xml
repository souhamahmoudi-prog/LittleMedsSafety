               <code code="69718-5" codeSystem="2.16.840.1.113883.6.1" displayName="STATEMENT OF IDENTITY SECTION"/>
               <text>
                  <table width="100%">
                     <caption/>
                     <tbody>
                        <tr>
                           <td>
                              <content styleCode="bold">                                                                                            Supplement Facts</content>
                           </td>
                        </tr>
                        <tr>
                           <td>Serving Size: 1 mL Daily</td>
                        </tr>
                        <tr>
                           <td>Serving per container:  50</td>
                        </tr>
                        <tr>
                           <td>
                              <content styleCode="bold">Amount per 1 mL (dropperful)                                                                               % Daily Value</content>
                           </td>
                        </tr>
                        <tr>
                           <td>
                              <content styleCode="bold">                                                                              Infants through 12 Months of age         Children 1 through 4 years of age</content>
                           </td>
                        </tr>
                        <tr>
                           <td>Iron (as Ferrous Sulfate)   15 mg                                                     100%                                                  150%</td>
