         <component>
            <section ID="LINK_bdcbd3a6-e8cb-401f-8f41-9f074f7434da">
               <id root="622c9af7-5ec8-4627-bf84-c849b6d70cae"/>
               <code code="34068-7" codeSystem="2.16.840.1.113883.6.1" displayName="DOSAGE &amp; ADMINISTRATION SECTION"/>
               <title>
                  <content styleCode="bold">
                     <content styleCode="italics">Directions</content>
                  </content>
               </title>
               <text>
                  <list listType="unordered" styleCode="Square">
                     <item>
                        <content styleCode="bold">do not take more than directed</content>
                     </item>
                     <item>do not take more than 6 doses in 24 hours</item>
                     <item>mL = milliliter</item>
                     <item>only use the dose cup provided</item>
                     <item>find right dose on chart below</item>
                     <item>take every 4 to 6 hours, or as directed by a doctor</item>
                  </list>
                  <table width="400px">
                     <col/>
                     <col/>
                     <tbody>
                        <tr>
                           <td styleCode=" Botrule Toprule Lrule Rrule">
                              <content styleCode="bold">Age (yr)</content>
                           </td>
                           <td styleCode=" Botrule Toprule Lrule Rrule">
                              <content styleCode="bold">Dose (mL)</content>
                           </td>
                        </tr>
                        <tr>
                           <td styleCode=" Botrule Toprule Lrule Rrule">children under 2 years</td>
                           <td styleCode=" Botrule Toprule Lrule Rrule">do not use</td>
                        </tr>
                        <tr>
                           <td styleCode=" Botrule Toprule Lrule Rrule">children 2 to 5 years</td>
                           <td styleCode=" Botrule Toprule Lrule Rrule">do not use unless directed by a doctor</td>
                        </tr>
                        <tr>
                           <td styleCode=" Botrule Toprule Lrule Rrule">children 6 to 11 years</td>
                           <td styleCode=" Botrule Toprule Lrule Rrule">5 mL to 10 mL</td>
                        </tr>
                     </tbody>
                  </table>
               </text>
               <effectiveTime value="20260522"/>
            </section>
         </component>
         <component>
            <section ID="LINK_bb70b4eb-ccd5-4fec-a7e6-67c37577a61b">
