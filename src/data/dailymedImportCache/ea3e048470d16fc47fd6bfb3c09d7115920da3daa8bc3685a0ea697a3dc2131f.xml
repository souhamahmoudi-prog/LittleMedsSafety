               <title>PRINCIPAL DISPLAY PANEL - 59 mL Bottle Label</title>
               <text>
                  <paragraph>NDC 68016-160-02</paragraph>
                  <paragraph>
                     <content styleCode="bold italics">Premier<br/>Value <sup>®</sup>
                     </content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold italics">Infants'<br/>Pain Relief</content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">PAIN RELIEVER - FEVER REDUCER<br/>ACETAMINOPHEN</content>
                  </paragraph>
