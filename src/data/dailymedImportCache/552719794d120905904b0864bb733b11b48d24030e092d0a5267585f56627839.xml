                     <content styleCode="italics">Active ingredients (in each caplet)</content>
                  </content>
               </title>
               <text>
                  <paragraph>Acetaminophen 250 mg<br/>
Aspirin 250 mg (NSAID*)<br/>
Caffeine 65 mg<br/>
*nonsteroidal anti-inflammatory drug</paragraph>
               </text>
               <effectiveTime value="20260713"/>
            </section>
