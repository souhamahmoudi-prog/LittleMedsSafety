               <code code="34071-1" codeSystem="2.16.840.1.113883.6.1" displayName="WARNINGS SECTION"/>
               <title>WARNINGS:</title>
               <text>
                  <paragraph>
                     <content styleCode="bold">If pregnant or breast-feeding,</content> ask a health care professional before use.</paragraph>
                  <paragraph>
                     <content styleCode="bold">Keep out of reach of children.</content> In case of overdose, get medical help or contact a Poison Control Center right away.</paragraph>
                  <paragraph>Do not use if tamper evident seal is broken or missing.</paragraph>
                  <paragraph>Store in a cool, dry place.</paragraph>
               </text>
               <effectiveTime value="20250606"/>
            </section>
