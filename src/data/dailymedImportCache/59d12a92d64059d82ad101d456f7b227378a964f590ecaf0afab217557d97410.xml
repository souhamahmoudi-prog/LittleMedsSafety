               <code code="44425-7" codeSystem="2.16.840.1.113883.6.1" displayName="STORAGE AND HANDLING SECTION"/>
               <title>
                  <content styleCode="italics">Other information</content>
               </title>
               <text>
                  <list listType="unordered">
                     <item>
                        <caption>•</caption>
                        <content styleCode="bold">each packet contains</content>: potassium 6 mg</item>
                     <item>
                        <caption>•</caption>store at controlled room temperature 20°-25°C (68°-77°F). Protect from excessive heat and moisture. </item>
                  </list>
               </text>
               <effectiveTime value="20161021"/>
            </section>
         </component>
