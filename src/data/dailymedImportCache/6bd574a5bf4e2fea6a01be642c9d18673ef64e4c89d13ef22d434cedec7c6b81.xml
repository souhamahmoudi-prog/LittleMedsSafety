               <code code="69719-3" codeSystem="2.16.840.1.113883.6.1" displayName="HEALTH CLAIM SECTION"/>
               <text>
                  <paragraph>
                     <content styleCode="bold">Call your licensed medical practitioner about side effects. You may report side effects by calling Virtus at 1-888-848-3593 or FDA at 1-800-FDA-1088.</content>
                  </paragraph>
               </text>
               <effectiveTime value="20191108"/>
            </section>
