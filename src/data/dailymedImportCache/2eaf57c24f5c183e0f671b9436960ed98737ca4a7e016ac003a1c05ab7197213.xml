         <component>
            <section ID="LINK_f9e6b486-e6bc-410e-a544-15713934d7c9">
               <id root="9ee0d065-524e-438a-89e4-81025a57466c"/>
               <code code="34068-7" codeSystem="2.16.840.1.113883.6.1" displayName="DOSAGE &amp; ADMINISTRATION SECTION"/>
               <title>
                  <content styleCode="bold">
                     <content styleCode="italics">Directions</content>
                  </content>
               </title>
               <text>
                  <list listType="unordered" styleCode="Square">
                     <item>
                        <content styleCode="bold">do not take more than directed</content>
                     </item>
                     <item>do not take more than 6 doses in 24 hours</item>
                     <item>mL = milliliter</item>
                     <item>only use the dose cup provided</item>
                     <item>find right dose on chart below</item>
                     <item>take every 4 to 6 hours, or as directed by a doctor</item>
                  </list>
                  <table width="252.333px">
                     <col/>
                     <col/>
                     <tbody>
                        <tr>
                           <td styleCode=" Botrule Rrule">
                              <content styleCode="bold">Age (yr)</content>
                           </td>
                           <td styleCode=" Botrule">
                              <content styleCode="bold">Dose (mL)</content>
                           </td>
                        </tr>
                        <tr>
                           <td styleCode=" Botrule Rrule">children under 2 years</td>
                           <td styleCode=" Botrule">do not use</td>
                        </tr>
                        <tr>
                           <td styleCode=" Botrule Rrule">children 2 to 5 years</td>
                           <td styleCode=" Botrule">do not use unless<br/>
            directed by a doctor</td>
                        </tr>
                        <tr>
                           <td styleCode=" Rrule">children 6 to 11 years</td>
                           <td>5 mL to 10 mL</td>
                        </tr>
                     </tbody>
                  </table>
                  <br/>
               </text>
               <effectiveTime value="20260112"/>
            </section>
         </component>
