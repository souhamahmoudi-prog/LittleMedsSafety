               <code code="51727-6" codeSystem="2.16.840.1.113883.6.1" displayName="INACTIVE INGREDIENT SECTION"/>
               <title>Inactive ingredients</title>
               <text>
                  <paragraph>citric acid, FD&amp;C red # 40, FD&amp;C blue # 1, flavor, glycerin. PEG 400, purified water, sodium benzoate, sodium citrate, sodium saccharin, sorbitol</paragraph>
               </text>
               <effectiveTime value="20161013"/>
            </section>
