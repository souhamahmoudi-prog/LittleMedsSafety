               <title>Other information </title>
               <text>
                  <list listType="unordered">
                     <item>
                        <caption>•</caption>store at 20° -25°C (68° -77°F)</item>
                     <item>
                        <caption>•</caption>close cap tightly after use</item>
                     <item>
                        <caption>•</caption>read all product information before using. Keep this box for important information.</item>
                  </list>
               </text>
