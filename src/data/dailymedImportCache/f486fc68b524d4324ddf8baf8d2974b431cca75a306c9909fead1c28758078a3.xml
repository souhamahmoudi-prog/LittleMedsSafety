               <text>
                  <paragraph>
                     <content styleCode="italics">
                        <content styleCode="bold">Other information</content>
                     </content>
                     <br/>
■ 
  <content styleCode="bold">each 5 mL contains:</content> sodium 2 mg
  <br/>
■ store between 20-25°C (68-77°F)
 </paragraph>
               </text>
               <effectiveTime value="20250328"/>
            </section>
         </component>
