            <section ID="id_link_f3cfcdcb-c79e-8d16-e053-2995a90aeb36">
               <id root="f3cfcdcb-c79d-8d16-e053-2995a90aeb36"/>
               <code code="55106-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ACTIVE INGREDIENT SECTION"/>
               <title>
                  <content styleCode="italics">
                     <content styleCode="bold">Active Ingredient (in each tablet)</content>
                  </content>
               </title>
               <text>
                  <paragraph>Famotidine 10 mg
  <br/>
Calcium carbonate 800 mg
  <br/>
Magnesium hydroxide 165 mg
 </paragraph>
               </text>
               <effectiveTime value="20230203"/>
            </section>
