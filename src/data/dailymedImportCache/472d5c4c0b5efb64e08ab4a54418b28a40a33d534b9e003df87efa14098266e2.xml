         <component>
            <section ID="L1a1a82e9-527b-4bf8-b644-7f5ab979da1b">
               <id root="855f48d1-49fc-4c9a-a235-718e81cb3c94"/>
               <code code="69719-3" codeSystem="2.16.840.1.113883.6.1" displayName="HEALTH CLAIM SECTION"/>
               <text>
                  <paragraph>Each teaspoonful (5mL) contains 220mg Ferrous Sulfate, providing approximately 44mg of elemental iron.</paragraph>
                  <paragraph>
                     <content styleCode="bold">OTHER INGREDIENTS:</content> Anhydrous citric acid, Dye FD&amp;C yellow #6, Flavor cherry, Sodium Benzoate, Sucralose, Sucrose, Purified water.</paragraph>
               </text>
               <effectiveTime value="20230814"/>
            </section>
         </component>
         <component>
            <section ID="Lce1d03dc-810d-4d20-bb69-45c40df5fc0a">
               <id root="35c0a6ec-0870-4575-8d06-2139ab4719de"/>
               <code code="50741-8" codeSystem="2.16.840.1.113883.6.1" displayName="SAFE HANDLING WARNING SECTION"/>
               <text>
                  <table width="100%">
                     <caption/>
                     <tbody>
                        <tr styleCode="First Last">
                           <td>
                              <content styleCode="bold">WARNING:</content> Accidental overdose of iron containing supplements is a leading cause of fatal poisoning in children under 6.<br/>
                              <content styleCode="bold">KEEP THIS PRODUCT OUT OF REACH OF CHILDREN.</content>
                              <br/>In case of accidental overdose, call a doctor or Poison Control Center immediately.</td>
                        </tr>
                     </tbody>
                  </table>
                  <paragraph/>
               </text>
               <effectiveTime value="20230814"/>
            </section>
         </component>
         <component>
            <section ID="L0cad1dd0-721b-47a4-bc2b-c5a1608ae76a">
