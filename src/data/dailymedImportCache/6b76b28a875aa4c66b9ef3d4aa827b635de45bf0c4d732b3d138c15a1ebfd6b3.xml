               <title>
                  <content styleCode="bold">Ask a doctor before use</content>
               </title>
               <text>
                  <paragraph>
                     <content styleCode="bold">Ask a doctor before use</content>
                  </paragraph>
                  <list listType="unordered">
                     <item>on chicken pox</item>
                     <item>on measles</item>
