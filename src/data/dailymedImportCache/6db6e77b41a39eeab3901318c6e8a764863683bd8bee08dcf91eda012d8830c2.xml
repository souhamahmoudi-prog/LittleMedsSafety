               <title>Inactive ingredients</title>
               <text>
                  <paragraph>Anhydrous citric acid, edetate disodium, FD&amp;C yellow no. 6, flavor, glycerin, propylene glycol, propyl gallate, purified water, sodium benzoate, sorbitol, sucralose, xanthan gum</paragraph>
               </text>
               <effectiveTime value="20210803"/>
            </section>
         </component>
