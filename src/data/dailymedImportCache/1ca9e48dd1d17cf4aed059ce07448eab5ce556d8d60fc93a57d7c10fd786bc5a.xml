         <component>
            <section>
               <id root="6624f986-8f6f-4969-9b6e-9fcdc62255bd"/>
               <code code="34068-7" codeSystem="2.16.840.1.113883.6.1" displayName="DOSAGE &amp; ADMINISTRATION SECTION"/>
               <title>
                  <content styleCode="italics">
                     <content styleCode="bold">Directions</content>
                  </content>
               </title>
               <text>
                  <paragraph>• take every 4 to 6 hours, or as directed by a physician<br/>• do not take more than 6 doses in 24 hours</paragraph>
                  <table width="50%">
                     <colgroup>
                        <col width="50%" align="left" valign="top"/>
                        <col width="50%" align="left" valign="top"/>
                     </colgroup>
                     <thead>
                        <tr styleCode="Botrule">
                           <th styleCode="Rrule Toprule" align="center">age</th>
                           <th styleCode="Toprule" align="center">dose</th>
                        </tr>
                     </thead>
                     <tbody>
                        <tr styleCode="Botrule">
                           <td styleCode="Rrule" align="left">Children under 2 years of age</td>
                           <td align="left">Do not use</td>
                        </tr>
                        <tr styleCode="Botrule">
                           <td styleCode="Rrule" align="left">Children 2 to under 6 years of age</td>
                           <td align="left">Do not use unless directed by a doctor</td>
                        </tr>
                        <tr>
                           <td styleCode="Rrule" align="left">Children 6 to under 12 years of age</td>
                           <td align="left">5 mL (12.5 mg) to 10 mL (25 mg)</td>
                        </tr>
                     </tbody>
                  </table>
                  <paragraph/>
               </text>
               <effectiveTime value="20231214"/>
            </section>
         </component>
         <component>
            <section>
               <id root="0efbb1c2-fd3b-4b0a-ab35-94acfaffbb08"/>
               <code code="42229-5" codeSystem="2.16.840.1.113883.6.1" displayName="SPL UNCLASSIFIED SECTION"/>
               <title>
                  <content styleCode="italics">
                     <content styleCode="bold">Other information</content>
                  </content>
               </title>
               <text>
                  <paragraph>• each 5 mL contains sodium: 3 mg<br/>• store at 20° to 25°C (68° to 77°F). [See USP Controlled Room Temperature]<br/>• do not use if lid is torn or broken</paragraph>
               </text>
               <effectiveTime value="20231214"/>
            </section>
         </component>
