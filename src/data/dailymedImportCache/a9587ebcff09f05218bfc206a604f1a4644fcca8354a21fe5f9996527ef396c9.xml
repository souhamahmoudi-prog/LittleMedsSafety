               <component>
                  <section ID="LINK_c1d78d00-7919-444b-86ff-9496d24b217f">
                     <id root="d33d3800-2126-4b80-87ca-84430cb46784"/>
                     <code code="50566-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - STOP USE SECTION"/>
                     <title>Stop use and ask a doctor if</title>
                     <text>
                        <list listType="unordered" styleCode="Disk">
                           <item>new symptoms occur</item>
                           <item>redness or swelling is present</item>
                           <item>pain gets worse or lasts more than 5 days</item>
                           <item>fever gets worse or lasts more than 3 days</item>
                        </list>
                        <paragraph>These could be signs of a serious condition.</paragraph>
                     </text>
                     <effectiveTime value="20240411"/>
                  </section>
               </component>
               <component>
                  <section ID="LINK_164f4298-7936-4b30-95e5-cbfe31c4ee83">
                     <id root="55382b37-f82c-487b-9317-495ffda3b853"/>
                     <code code="50565-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - KEEP OUT OF REACH OF CHILDREN SECTION"/>
                     <title>Keep out of reach of children.</title>
                     <text>
                        <paragraph>Overdose warning: Taking more than the recommended dose (overdose) may cause liver damage. In case of overdose, get medical help or contact a Poison Control Center (1-800-222-1222) right away. Quick medical attention is critical even if if you do not notice any signs or symptoms.</paragraph>
                     </text>
                     <effectiveTime value="20240411"/>
                  </section>
               </component>
