            <section>
               <id root="529cc4da-e1de-2dc9-e063-6394a90a6e4e"/>
               <code code="55106-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ACTIVE INGREDIENT SECTION"/>
               <title>
                  <content styleCode="bold">
                     <content styleCode="italics">Active</content>
                  </content>
                  <content styleCode="bold">
                     <content styleCode="italics">i</content>
                  </content>
                  <content styleCode="bold">
                     <content styleCode="italics">ngredient</content>
                  </content>
                  <content styleCode="bold">
                     <content styleCode="italics">(in each tablet</content>
                  </content>
                  <content styleCode="bold">
                     <content styleCode="italics">)</content>
                  </content>
               </title>
               <text>
                  <paragraph>Famotidine USP 10 mg</paragraph>
               </text>
