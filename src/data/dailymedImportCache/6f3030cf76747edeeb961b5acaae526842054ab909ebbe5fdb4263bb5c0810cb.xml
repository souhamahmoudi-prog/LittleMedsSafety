               <title>
                  <content styleCode="bold">
                     <content styleCode="italics">Inactive ingredients</content>
                  </content>
               </title>
               <text>
                  <paragraph>Anhydrous citric acid, carboxymethylcellulose, flavors, glycerin, propylene glycol, sodium benzoate, sorbitol solution, sucralose, water, xylitol</paragraph>
               </text>
               <effectiveTime value="20260101"/>
            </section>
