               <id root="1970305f-005d-fa4e-e063-6394a90af144"/>
               <code code="55105-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - PURPOSE SECTION"/>
               <title>Purpose</title>
               <text>
                  <paragraph>Pain reliever/fever reducer</paragraph>
               </text>
               <effectiveTime value="20240527"/>
               <component>
                  <section ID="id_link_e9218bc1-d4ac-7c8d-e053-2995a90a4b9d">
                     <id root="1970305f-005e-fa4e-e063-6394a90af144"/>
                     <code code="34067-9" codeSystem="2.16.840.1.113883.6.1" displayName="INDICATIONS &amp; USAGE SECTION"/>
                     <title>Uses</title>
                     <text>
                        <paragraph>Temporarily: • Reduces fever 
  <br/>  Relieves minor aches and pains due to: • the common cold • flu • headache • sore throat • toothache
 </paragraph>
                     </text>
                     <effectiveTime value="20240527"/>
                  </section>
               </component>
            </section>
