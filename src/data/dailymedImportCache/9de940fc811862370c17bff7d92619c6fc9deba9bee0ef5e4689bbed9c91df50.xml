               <id root="1d6a4b3b-f078-44f7-887d-68acb87897c4"/>
               <code code="51945-4" codeSystem="2.16.840.1.113883.6.1" displayName="PACKAGE LABEL.PRINCIPAL DISPLAY PANEL"/>
               <title>
                  <content styleCode="bold">Product Label</content>
               </title>
               <text>
                  <paragraph>
                     <content styleCode="italics">
                        <content styleCode="bold">Walgreens</content>
                     </content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">Compare to Children's Tylenol<sup>®</sup>
                     </content>
                     <br/>
                     <content styleCode="bold">Oral Suspension active ingredient</content>
                     <content styleCode="italics">
                        <sup>††</sup>
                     </content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">NDC 0363-0322-24</content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">children's</content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">Pain &amp; Fever</content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">ACETAMINOPHEN</content>
                     <br/>
                     <content styleCode="bold">160 mg PER 5 mL</content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">PAIN RELIEVER /</content>
                     <br/>
                     <content styleCode="bold">FEVER REDUCER</content>
                     <br/>
                     <content styleCode="bold">ORAL SUSPENSION</content>
                  </paragraph>
