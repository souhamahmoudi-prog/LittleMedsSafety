            <section ID="Leccb437f-0fa5-4a59-b2cd-de02f5137cbb">
               <id root="c6b6e589-9e6a-4eee-90d3-9ec0a1e76d2b"/>
               <code code="55106-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ACTIVE INGREDIENT SECTION"/>
               <title/>
               <text>
                  <paragraph>
                     <content styleCode="bold">Active ingredients (in each packet)                                                                   Purposes</content>
                  </paragraph>
                  <paragraph>Acetaminophen 650 mg.............................................................................Pain reliever/fever reducer<br/>Dextromethorphan hydrobromide 20 mg.....................................................Cough suppressant<br/>Phenylephrine hydrochloride 10 mg............................................................Nasal decongestant</paragraph>
               </text>
               <effectiveTime value="20200324"/>
            </section>
