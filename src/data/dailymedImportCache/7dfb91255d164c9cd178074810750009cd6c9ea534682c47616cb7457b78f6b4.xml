               <code code="55106-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ACTIVE INGREDIENT SECTION"/>
               <title>
                  <content styleCode="italics">Active ingredient (in each 5 mL teaspoonful)       Purpose</content>
               </title>
               <text>
                  <paragraph>Cetirizine HCl 5 mg----------------------------------Antihistamine</paragraph>
               </text>
               <effectiveTime value="20260518"/>
            </section>
