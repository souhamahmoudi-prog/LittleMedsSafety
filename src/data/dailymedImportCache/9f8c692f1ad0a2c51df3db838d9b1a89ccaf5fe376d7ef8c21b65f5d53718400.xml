                     <title>
                        <content styleCode="bold">If pregnant or breast-feeding,</content>
                     </title>
                     <text>
                        <paragraph>ask a health professional before use.</paragraph>
                     </text>
                     <effectiveTime value="20260107"/>
                  </section>
               </component>
