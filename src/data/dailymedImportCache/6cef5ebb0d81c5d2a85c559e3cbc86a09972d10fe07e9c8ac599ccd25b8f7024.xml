               <text>
                  <list listType="unordered">
                     <item>
                        <caption>•</caption>
                        <content styleCode="bold">each 15 mL contains: </content>sodium 12 mg</item>
                     <item>
                        <caption>•</caption>store at 20-25°C (68-77°F)</item>
