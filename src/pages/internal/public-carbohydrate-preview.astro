---
import MedicationCarbohydrateReferenceLookup from '../../components/MedicationCarbohydrateReferenceLookup.astro';
import approvedMedicationCarbohydrateRecords from '../../data/approvedMedicationCarbohydrateRecords.json';

const approvedRecords = approvedMedicationCarbohydrateRecords.filter(
  (record) => record.approvalStatus === 'approved',
);
---

<MedicationCarbohydrateReferenceLookup
  approvedRecords={approvedRecords}
  mode="preview"
  title="Local Public Carbohydrate Preview | LittleMeds Safety"
  description="Local-only preview of approved medication carbohydrate records from the current browser session."
/>
