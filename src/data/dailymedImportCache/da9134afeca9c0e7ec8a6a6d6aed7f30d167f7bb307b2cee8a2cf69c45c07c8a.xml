               <code code="55106-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ACTIVE INGREDIENT SECTION"/>
               <text>
                  <paragraph>It is a compound preparation. Each milliliter contains 10.0 mg of Clindamycin Hydrochloride (calculated as Clindamycin),</paragraph>
               </text>
               <effectiveTime value="20240501"/>
            </section>
         </component>
