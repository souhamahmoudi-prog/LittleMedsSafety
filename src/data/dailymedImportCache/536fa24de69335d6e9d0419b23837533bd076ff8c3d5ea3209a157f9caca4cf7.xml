                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">Loratadine</content>
                     <br/>
                     <content styleCode="bold">Oral Solution</content>
                     <br/>
                     <content styleCode="bold">USP, 5 mg/5 mL</content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="italics">(Antihistamine) <content styleCode="bold">ALLERGY</content>
                     </content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">
                        <content styleCode="italics">Non-Drowsy</content>
                     </content>
