            <section ID="Lbfec8bc9-d4fd-47f1-b726-f310cbbd455b">
               <id root="1c9a3136-bfed-4a8a-9bfd-7bddab5f640e"/>
               <code code="50569-3" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ASK DOCTOR SECTION"/>
               <title>Ask a doctor before use if your kid have</title>
               <text>
                  <paragraph>Liver disease</paragraph>
                  <paragraph>Persistent or chronic cough, asthma or emphysema</paragraph>
                  <paragraph>If your kid is allergic to acetaminophen or any other componet of this formula</paragraph>
               </text>
               <effectiveTime value="20170410"/>
            </section>
         </component>
         <component>
            <section ID="Lbd9f8de7-f30d-48ad-8e08-325df488fbff">
               <id root="99412c0a-0524-4b42-bf19-1a56f996c973"/>
               <code code="50566-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - STOP USE SECTION"/>
               <title>Stop use and ask a doctor if</title>
               <text>
                  <paragraph>Symtoms last more than 5 days</paragraph>
                  <paragraph>Fever gets worst or last more than 3 days, or occurs with rash or headache that last, a persistent cough, this could be signs of a serious conditions</paragraph>
                  <paragraph>If your child is taking the bloood thinning drug warfarin</paragraph>
               </text>
               <effectiveTime value="20170410"/>
            </section>
         </component>
