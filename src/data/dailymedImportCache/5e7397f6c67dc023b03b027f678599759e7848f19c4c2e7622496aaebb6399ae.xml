            <section ID="LINK_cfd16790-3c40-4a19-ad80-23cf645074fd">
               <id root="455aec5c-faa8-40cc-b9be-cd749834db43"/>
               <code code="55106-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ACTIVE INGREDIENT SECTION"/>
               <title>Active ingredients (in each 5 mL)</title>
               <text>
                  <paragraph>
                     <content styleCode="bold">Acetaminophen 160 mg</content>
                  </paragraph>
                  <paragraph>Chlorpheniramine maleate 1 mg</paragraph>
                  <paragraph>Dextromethorphan HBr 5 mg</paragraph>
                  <paragraph>Phenylephrine HCI 2.5 mg</paragraph>
               </text>
               <effectiveTime value="20231206"/>
            </section>
