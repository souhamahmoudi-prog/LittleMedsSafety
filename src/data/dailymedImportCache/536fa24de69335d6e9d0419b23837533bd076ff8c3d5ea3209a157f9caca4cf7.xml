            <section ID="ID_931a75d5-c21f-4586-96a7-8b74a494e51f">
               <id root="aa7f2de4-3613-4bf9-aeb4-edb722f2422e"/>
               <code code="55105-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - PURPOSE SECTION"/>
               <title>Purpose</title>
