         <component>
            <section ID="id_link_28ed332e-2d27-caa9-e063-6294a90adfa0">
               <id root="3028988b-9f16-6446-e063-6394a90a4078"/>
               <code code="34068-7" codeSystem="2.16.840.1.113883.6.1" displayName="DOSAGE &amp; ADMINISTRATION SECTION"/>
               <title>
                  <content styleCode="bold">
                     <content styleCode="italics">Directions</content>
                  </content>
               </title>
               <text>
                  <list listType="unordered">
                     <item>
                        <content styleCode="bold">this product does not contain directions or complete warnings for adult use</content>
                     </item>
                     <item>do not exceed 5 doses in a 24-hour period 
   <content styleCode="bold">(see liver warning)</content>
                     </item>
                     <item>follow the “Easy to Use” instructions on the pouch</item>
                  </list>
                  <paragraph>corresponds to your child’s age use the dose that</paragraph>
                  <paragraph/>
                  <paragraph/>
                  <paragraph/>
                  <table border="0" width="100%">
                     <tbody>
                        <tr>
                           <td>
                              <content styleCode="bold">Age (Years)</content>
                           </td>
                           <td>
                              <content styleCode="bold">Dose* </content>
                           </td>
                        </tr>
                        <tr>
                           <td>under 2</td>
                           <td>consult a doctor</td>
                        </tr>
                        <tr>
                           <td>2 to under 6</td>
                           <td>1 vial (5 mL)</td>
                        </tr>
                        <tr>
                           <td>6 to 11</td>
                           <td>2 vials (10 mL)</td>
                        </tr>
                     </tbody>
                  </table>
                  <paragraph>*dose may be repeated every 4 hours while symptoms persist, up to five times a day or as directed by a doctor.</paragraph>
                  <paragraph/>
                  <paragraph/>
               </text>
               <effectiveTime value="20250120"/>
            </section>
         </component>
         <component>
            <section ID="id_link_28ed332e-2d2d-caa9-e063-6294a90adfa0">
               <id root="2ee7b56e-e123-c019-e063-6294a90a5565"/>
               <code code="60561-8" codeSystem="2.16.840.1.113883.6.1" displayName="OTHER SAFETY INFORMATION"/>
               <title>
                  <content styleCode="italics">
                     <content styleCode="bold">Other information</content>
                  </content>
               </title>
               <text>
                  <list listType="unordered">
                     <item>
                        <content styleCode="bold">each 5 mL vial contains: </content>sodium 2 mg
  </item>
                     <item>store between 68-77°F (20-25°C)</item>
                     <item>do not use if pouch or vial is punctured, torn or open</item>
                  </list>
               </text>
               <effectiveTime value="20250120"/>
            </section>
         </component>
