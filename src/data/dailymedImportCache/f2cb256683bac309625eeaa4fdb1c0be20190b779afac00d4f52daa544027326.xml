         <component>
            <section ID="id_link_a7d7cbaa-98de-7a22-e053-2995a90a40e8">
               <id root="44728a34-0f42-c926-e063-6394a90a866b"/>
               <code code="34068-7" codeSystem="2.16.840.1.113883.6.1" displayName="DOSAGE &amp; ADMINISTRATION SECTION"/>
               <text>
                  <paragraph>
                     <content styleCode="italics">
                        <content styleCode="bold">Directions</content>
                     </content>
                  </paragraph>
                  <list listType="unordered">
                     <item>take every 4 to 6 hours, or as directed by a doctor</item>
                     <item>do not take more than 6 doses in 24 hours</item>
                     <item>marked drowsiness may occur</item>
                     <item>use only with enclosed dose cup. Do not use with any other dosing device.</item>
                     <item>
                        <content styleCode="bold">SHAKE WELL BEFORE EACH USE</content>
                     </item>
                  </list>
                  <table border="0" width="100%">
                     <tbody>
                        <tr>
                           <td>adults and children 12 years of age and over</td>
                           <td>10 - 20 mL</td>
                        </tr>
                        <tr>
                           <td>children 6 to under 12 years</td>
                           <td>5 - 10 mL</td>
                        </tr>
                        <tr>
                           <td>children 2 to under 6 years</td>
                           <td>do not use unless directed by a doctor</td>
                        </tr>
                        <tr>
                           <td>children under 2 years</td>
                           <td>
                              <content styleCode="bold">do not use</content>
                           </td>
                        </tr>
                     </tbody>
                  </table>
                  <paragraph/>
               </text>
               <effectiveTime value="20251125"/>
            </section>
         </component>
         <component>
            <section ID="id_link_a7bcc42d-fb48-69c4-e053-2995a90adf73">
