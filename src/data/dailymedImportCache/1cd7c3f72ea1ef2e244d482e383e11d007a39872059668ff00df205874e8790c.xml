         <component>
            <section>
               <id root="7bcf8ead-681f-41e7-8a58-d4f8935f193b"/>
               <code codeSystem="2.16.840.1.113883.6.1" code="34068-7" displayName="DOSAGE &amp; ADMINISTRATION SECTION"/>
               <title>
                  <content styleCode="bold">Directions</content>
               </title>
               <text>
                  <paragraph>Adults and children 12 years of age and over: Take one tablet daily, preferably after a meal, or as directed by a physician. </paragraph>
                  <paragraph>Children under 12 years of age: Consult a physician. Do not chew or crush tablet.</paragraph>
                  <paragraph>
                     <content styleCode="bold">Inactive Ingredients:</content>
                  </paragraph>
                  <paragraph>Microcrystalline Cellulose, Dibasic Calcium Phosphate Dihydrate, Anhydrous Lactose, Hypromellose Phthalate, Croscarmellose Sodium, Stearic Acid, Magnesium Stearate, Triacetin, FD&amp;C Red #40 Aluminum Lake, Colloidal Silicon Dioxide, Titanium Dioxide, Hypromellose, Mineral Oil.</paragraph>
               </text>
               <effectiveTime value="20190215"/>
            </section>
