                     <code code="50565-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - KEEP OUT OF REACH OF CHILDREN SECTION"/>
                     <title>
                        <content styleCode="bold">Keep out of reach of children. </content>
                     </title>
                     <text>
                        <paragraph>In case of overdose, get medical help or contact a Poison Control Center right away (1-800-222-1222).</paragraph>
                     </text>
                     <effectiveTime value="20260626"/>
                  </section>
               </component>
            </section>
         </component>
         <component>
            <section ID="id_link_291a61fc-1414-1b17-e063-6394a90a96af">
               <id root="553382d5-ffef-e249-e063-6394a90a50c6"/>
               <code code="34068-7" codeSystem="2.16.840.1.113883.6.1" displayName="DOSAGE &amp; ADMINISTRATION SECTION"/>
               <title>
                  <content styleCode="italics">
                     <content styleCode="bold">Directions</content>
                  </content>
               </title>
               <text>
                  <paragraph>■ do not exceed 12 chewables in a 24-hour period</paragraph>
                  <paragraph>■ chew thoroughly before swallowing</paragraph>
                  <table border="0">
                     <tbody>
                        <tr>
                           <td>
                              <content styleCode="bold">Age</content>
                           </td>
                           <td>
                              <content styleCode="bold">Dose (chew)</content>
                           </td>
                        </tr>
                        <tr>
                           <td>
                              <paragraph>adults and children 12 years and older </paragraph>
                           </td>
                           <td> take 1-2 chewables every 4-6 hours </td>
                        </tr>
                        <tr>
                           <td>children under 12 years</td>
                           <td>do not use</td>
                        </tr>
                     </tbody>
                  </table>
                  <paragraph/>
               </text>
               <effectiveTime value="20260626"/>
            </section>
         </component>
         <component>
            <section ID="id_link_0c54aa3e-9f38-faa6-e063-6394a90a0127">
               <id root="553382d5-fff2-e249-e063-6394a90a50c6"/>
               <code code="60561-8" codeSystem="2.16.840.1.113883.6.1" displayName="OTHER SAFETY INFORMATION"/>
               <title>
                  <content styleCode="italics">
                     <content styleCode="bold">Other Information</content>
                  </content>
               </title>
               <text>
                  <paragraph>
                     <content styleCode="bold">■ store between 68-77°F (20-25°C) 20-25°C) </content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">■ avoid high humidity and protect from light </content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">■ do not use if foil seal under cap is torn, broken or missing </content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">■ see bottom of bottle for lot number and expiration date</content>
                  </paragraph>
               </text>
               <effectiveTime value="20260626"/>
            </section>
         </component>
