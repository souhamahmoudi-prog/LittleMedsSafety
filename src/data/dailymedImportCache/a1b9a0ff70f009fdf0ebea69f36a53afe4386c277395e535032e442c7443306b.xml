         <component>
            <section ID="LINK_979f927b-ae8f-4b7a-87e4-c6bd84766372">
               <id root="ecf92eb8-e621-4568-bb93-700945fab80b"/>
               <code code="34068-7" codeSystem="2.16.840.1.113883.6.1" displayName="DOSAGE &amp; ADMINISTRATION SECTION"/>
               <title>
                  <content styleCode="bold">
                     <content styleCode="italics">Directions</content>
                  </content>
               </title>
               <text>
                  <list listType="unordered" styleCode="Square">
                     <item>
                        <content styleCode="bold">do not take more than directed</content>
                     </item>
                     <item>take every 4 to 6 hours, or as directed by a doctor</item>
                     <item>do not take more than 6 times in 24 hours</item>
                  </list>
                  <table width="375px">
                     <col/>
                     <col/>
                     <tbody>
                        <tr>
                           <td styleCode=" Botrule Toprule Lrule Rrule">adults and children 12 years and over</td>
                           <td styleCode=" Botrule Toprule Lrule Rrule">1 to 2 tablets</td>
                        </tr>
                        <tr>
                           <td styleCode=" Botrule Toprule Lrule Rrule">children 6 to under 12 years<br/>
                           </td>
                           <td styleCode=" Botrule Toprule Lrule Rrule">1 tablet<br/>
                           </td>
                        </tr>
                        <tr>
                           <td styleCode=" Botrule Toprule Lrule Rrule">children under 6 years<br/>
                           </td>
                           <td styleCode=" Botrule Toprule Lrule Rrule">do not use</td>
                        </tr>
                     </tbody>
                  </table>
               </text>
               <effectiveTime value="20260518"/>
            </section>
         </component>
         <component>
            <section ID="LINK_a13386b8-8a88-42d9-9e1d-47be65145a60">
               <id root="276133e9-c655-4c2f-9152-79d2192dd14e"/>
               <code code="44425-7" codeSystem="2.16.840.1.113883.6.1" displayName="STORAGE AND HANDLING SECTION"/>
               <title>
                  <content styleCode="bold">
                     <content styleCode="italics">Other information</content>
                  </content>
               </title>
               <text>
                  <list listType="unordered" styleCode="Square">
                     <item>
                        <content styleCode="bold">each tablet contains:</content> calcium 30 mg</item>
                     <item>store at 25°C (77°F); excursions permitted between 15°-30°C (59°-86°F)</item>
                     <item>protect from moisture</item>
                     <item>see end flap for expiration date and lot number</item>
                  </list>
               </text>
               <effectiveTime value="20260518"/>
            </section>
         </component>
         <component>
