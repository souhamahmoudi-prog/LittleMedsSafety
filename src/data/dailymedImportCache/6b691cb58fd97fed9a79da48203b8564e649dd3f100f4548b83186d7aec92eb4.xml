         <component>
            <section ID="id_link_156088ab-d50b-2b59-e063-6394a90a4509">
               <id root="448425b6-3953-a860-e063-6294a90aa994"/>
               <code code="55106-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ACTIVE INGREDIENT SECTION"/>
               <text>
                  <paragraph>Acetaminophen 162.5 mg</paragraph>
                  <paragraph>Dextromethorphan HBr 5 mg</paragraph>
                  <paragraph>Doxylamine succinate 3.125 mg</paragraph>
               </text>
               <effectiveTime value="20240603"/>
