                     <content styleCode="bold">Other information</content>
                  </content>
               </title>
               <text>
                  <paragraph>
                     <content styleCode="bold">• each 5 mL contains</content>: sodium 4.0 mg
  <br/>
• store between 20-25ºC (68-77ºF)
 </paragraph>
                  <paragraph>
                     <content styleCode="bold">• do not use if printed inner seal under cap is torn or missing.</content>
                  </paragraph>
               </text>
               <effectiveTime value="20251220"/>
            </section>
         </component>
