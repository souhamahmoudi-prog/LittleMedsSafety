               <text>
                  <paragraph>
                     <content styleCode="bold">Other information</content>
                     <br/>
• 
  <content styleCode="bold">each 5 mL contains:</content> sodium 4 mg
  <br/>
• store between 15-30°C (59-86°F).
  <br/>
• 
  <content styleCode="bold">TAMPER-EVIDENT FEATURE:</content> Do not use if printed safety seal is torn, broken or missing.
 </paragraph>
               </text>
               <effectiveTime value="20250212"/>
            </section>
