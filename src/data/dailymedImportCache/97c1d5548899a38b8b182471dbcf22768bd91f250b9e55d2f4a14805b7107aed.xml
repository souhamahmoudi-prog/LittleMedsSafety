               <title>
                  <content styleCode="bold">
                     <content styleCode="italics">Active ingredient (in each 30 mL)<br/>
                     </content>
                  </content>
               </title>
               <text>
                  <paragraph>Diphenhydramine HCl 50 mg </paragraph>
               </text>
               <effectiveTime value="20260521"/>
            </section>
