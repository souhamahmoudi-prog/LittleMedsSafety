                     <code code="50568-5" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ASK DOCTOR/PHARMACIST SECTION"/>
                     <title>
                        <content styleCode="bold">Ask a doctor or pharmacist before use if your child is</content>
                     </title>
                     <text>
                        <paragraph>taking the blood thinning drug warfarin</paragraph>
                     </text>
                     <effectiveTime value="20260616"/>
                  </section>
               </component>
               <component>
                  <section ID="id_link_5466a2c6-ded6-f7e6-e063-6294a90a2382">
                     <id root="54668f17-608d-1cf2-e063-6294a90a9d99"/>
                     <code code="50567-7" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - WHEN USING SECTION"/>
                     <title>
                        <content styleCode="bold">When using this product </content>
                     </title>
                     <text>
                        <paragraph>
                           <content styleCode="bold">do not exceed recomended dose (see overdose warning)</content>
                        </paragraph>
                     </text>
                     <effectiveTime value="20260616"/>
                  </section>
               </component>
               <component>
                  <section ID="id_link_54669131-76f9-2038-e063-6294a90a9b39">
                     <id root="546675be-6a36-0a63-e063-6294a90ab51d"/>
                     <code code="50566-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - STOP USE SECTION"/>
                     <title>
                        <content styleCode="bold">Stop use and ask a doctor if</content>
                     </title>
                     <text>
                        <list listType="unordered">
                           <item>new symptoms occur   </item>
                           <item>redness or swelling is present</item>
                           <item>pain gets worse or lasts more than 5 days</item>
                           <item>fever gets worse or lasts more than 3 days
   <br/>
	These could be signs of a serious condition.
  </item>
                        </list>
                     </text>
                     <effectiveTime value="20260616"/>
                  </section>
               </component>
               <component>
