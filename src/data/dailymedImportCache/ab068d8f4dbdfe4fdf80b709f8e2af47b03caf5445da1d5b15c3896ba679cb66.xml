               <id root="4480bdd2-2f1c-b56b-e063-6394a90a33d1"/>
               <code code="60561-8" codeSystem="2.16.840.1.113883.6.1" displayName="OTHER SAFETY INFORMATION"/>
               <title>
                  <content styleCode="bold">Other information</content>
               </title>
               <text>
                  <list listType="unordered">
                     <item>read the directions and warnings before use</item>
                     <item>keep the carton. It contains important information.</item>
                     <item>store at 20º - 25ºC (68º - 77ºF)</item>
                     <item>protect from moisture</item>
                  </list>
               </text>
               <effectiveTime value="20251001"/>
            </section>
         </component>
