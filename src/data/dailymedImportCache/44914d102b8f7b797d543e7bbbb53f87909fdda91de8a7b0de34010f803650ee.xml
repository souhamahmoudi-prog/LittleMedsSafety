               <code code="51945-4" codeSystem="2.16.840.1.113883.6.1" displayName="PACKAGE LABEL.PRINCIPAL DISPLAY PANEL"/>
               <title>Package/Label Principal Display Panel</title>
               <text>
                  <paragraph>NDC# 68163-540-06</paragraph>
                  <paragraph>Compare to the active ingredients in Theraflu® Daytime Severe Cold &amp; Cough*</paragraph>
                  <paragraph>Day Time</paragraph>
                  <paragraph>
                     <content styleCode="bold">Severe Cold &amp; Cough</content>
