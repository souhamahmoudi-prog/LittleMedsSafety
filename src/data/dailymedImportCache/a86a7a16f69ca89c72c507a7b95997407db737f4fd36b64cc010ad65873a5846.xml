               <title>Inactive ingredients</title>
               <text>
                  <paragraph>artificial flavor, citric acid anhydrous, corn syrup, FD&amp;C red #40, glycerin, microcrystalline cellulose and carboxymethylcellulose sodium, propylene glycol, purified water, sodium benzoate, sorbitol solution, sucralose, xanthan gum.</paragraph>
               </text>
               <effectiveTime value="20120425"/>
            </section>
         </component>
