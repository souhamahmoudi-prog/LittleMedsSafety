            <section ID="ID_70c05f8c-f404-4d77-a59e-381992489640">
               <id root="58245337-102a-4b07-806b-91e6bb68eab4"/>
               <code codeSystem="2.16.840.1.113883.6.1" code="51945-4" displayName="PACKAGE LABEL.PRINCIPAL DISPLAY PANEL"/>
               <title>Principal Display Panel </title>
               <text>
                  <paragraph>*Compare to the active ingredients in Theraflu Multi-Symptom Flu Relief Max Strength** Daytime*</paragraph>
                  <paragraph>
                     <content styleCode="bold">NDC 46122-841-59</content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">GOOD NEIGHBOR PHARMACY®</content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">
                        <content styleCode="italics">DAYTIME</content>
                     </content>
                  </paragraph>
