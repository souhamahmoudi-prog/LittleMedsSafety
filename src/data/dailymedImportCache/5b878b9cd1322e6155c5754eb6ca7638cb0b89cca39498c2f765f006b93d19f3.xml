            <section ID="Leccb437f-0fa5-4a59-b2cd-de02f5137cbb">
               <id root="53dd4f79-0f05-48d8-883b-a27f3b30f362"/>
               <code code="55106-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ACTIVE INGREDIENT SECTION"/>
               <title/>
               <text>
                  <paragraph>
                     <content styleCode="bold">Active ingredients (in each packet)                                                                   Purposes</content>
                  </paragraph>
                  <paragraph>Acetaminophen 650 mg............................................................................Pain reliever/fever reducer<br/>Diphenhydramine hydrochloride 25 mg......................................................Antihistamine/cough suppressant<br/>Phenylephrine hydrochloride 10 mg............................................................Nasal decongestant</paragraph>
               </text>
               <effectiveTime value="20200324"/>
            </section>
