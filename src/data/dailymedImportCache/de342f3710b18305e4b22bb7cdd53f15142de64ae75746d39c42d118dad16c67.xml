               <code code="51945-4" codeSystem="2.16.840.1.113883.6.1" displayName="PACKAGE LABEL.PRINCIPAL DISPLAY PANEL"/>
               <title>Package/Label Principal Display Panel</title>
               <text>
                  <paragraph>P</paragraph>
                  <paragraph>FOR AGES 2-3 YEARS</paragraph>
                  <paragraph>INFANTS’</paragraph>
                  <paragraph>pain relief</paragraph>
                  <paragraph>ACETAMINOPHEN</paragraph>
                  <paragraph>160 mg PER 5 mL</paragraph>
                  <paragraph>PAIN RELIEVER/FEVER REDUCER</paragraph>
                  <paragraph>SUSPENSION LIQUID</paragraph>
                  <paragraph>• Ibuprofen free</paragraph>
                  <paragraph>• Alcohol free</paragraph>
                  <paragraph>• Aspirin free</paragraph>
                  <paragraph>• Paraben free</paragraph>
