               <code code="51945-4" codeSystem="2.16.840.1.113883.6.1" displayName="PACKAGE LABEL.PRINCIPAL DISPLAY PANEL"/>
               <title>PRINCIPAL DISPLAY PANEL - 5 mg Tablet Blister Pack Carton</title>
               <text>
                  <paragraph>
                     <content styleCode="bold">NDC 51660-754-31</content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">
                        <sup>†</sup>Compare to the active ingredient of Children's Claritin
  
   <sup>®</sup>Chewable
 
  </content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">ages 2 years and older</content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">
                        <content styleCode="italics">Children's</content>
                     </content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">Loratadine Chewable Tablets USP, 5 mg</content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">Antihistamine</content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">Indoor &amp; Outdoor Allergies</content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">30 CHEWABLE TABLETS</content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">
                        <content styleCode="italics">The chewable tablets are to be chewed before swallowing.</content>
                     </content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">Bubble Gum Flavored</content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">Non-Drowsy*</content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">24 Hour Relief of:</content>
                  </paragraph>
                  <list listType="unordered">
                     <item>
                        <content styleCode="bold">
                           <content styleCode="italics">Sneezing</content>
                        </content>
                     </item>
                     <item>
                        <content styleCode="bold">
                           <content styleCode="italics">Runny Nose</content>
                        </content>
                     </item>
                     <item>
                        <content styleCode="bold">
                           <content styleCode="italics">Itchy, Watery Eyes</content>
                        </content>
