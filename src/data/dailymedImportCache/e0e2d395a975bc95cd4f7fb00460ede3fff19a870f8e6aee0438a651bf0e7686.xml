               <code code="51945-4" codeSystem="2.16.840.1.113883.6.1" displayName="PACKAGE LABEL.PRINCIPAL DISPLAY PANEL"/>
               <title>
                  <content styleCode="bold">
                     <content styleCode="italics">Principal display panel</content>
                  </content>
               </title>
               <text>
                  <paragraph>NDC 0363-4808-09</paragraph>
                  <paragraph>
                     <content styleCode="bold">
                        <content styleCode="italics">Walgreens</content>
                     </content>
                  </paragraph>
                  <paragraph>Compare to the active ingredient in<br/>Children’s Benadryl® Chewables<sup>††</sup>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">WALGREENS PHARMACIST RECOMMENDED<sup>†</sup>
                     </content>
                  </paragraph>
