               <title>Inactive Ingredients</title>
               <text>
                  <paragraph>citric acid, cherry flavor, edetate disodium, glycerin, maltitol, polyethylene glycol, propylene glycol, purified water, sodium benzoate, sodium metabisulfite, sorbitol, sucralose. trisodium citrate dihyrate, xanthan gum.</paragraph>
               </text>
               <effectiveTime value="20220201"/>
            </section>
