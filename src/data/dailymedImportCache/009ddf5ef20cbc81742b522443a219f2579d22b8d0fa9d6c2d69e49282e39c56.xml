               <code code="55106-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ACTIVE INGREDIENT SECTION"/>
               <title>Active ingredient (in each dose)</title>
               <text>
                  <paragraph>Polyethylene Glycol 3350, 17 g (cap filled to line)</paragraph>
               </text>
               <effectiveTime value="20140805"/>
            </section>
