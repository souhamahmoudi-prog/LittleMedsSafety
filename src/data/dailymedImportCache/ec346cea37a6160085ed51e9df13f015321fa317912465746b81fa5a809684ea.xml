            <section ID="ID_f5f3c185-694d-44cb-8a15-344772efdc82">
               <id root="570e3782-3377-9824-e063-6394a90a4680"/>
               <code code="34067-9" codeSystem="2.16.840.1.113883.6.1" displayName="INDICATIONS &amp; USAGE SECTION"/>
