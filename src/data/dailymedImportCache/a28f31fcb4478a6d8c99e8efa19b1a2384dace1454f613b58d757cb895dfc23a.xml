               <title>
                  <content styleCode="italics">Other information</content>
               </title>
               <text>
                  <list listType="unordered">
                     <item>read the directions and warnings before use</item>
                     <item>keep the carton. It contains important information.</item>
                     <item>store at 20°-25°C (68°-77°F)</item>
                     <item>protect from moisture</item>
                  </list>
               </text>
               <effectiveTime value="20240116"/>
            </section>
         </component>
