               <code code="60561-8" codeSystem="2.16.840.1.113883.6.1" displayName="OTHER SAFETY INFORMATION"/>
               <title>Other information</title>
               <text>
                  <list listType="unordered">
                     <item>each Single-Use vial contains 8mg of sodium</item>
                     <item>store at 68-77ºF (20-25ºC)</item>
                     <item>tamper evident: do not use if top flap of carton is open. Do not use if any vials are open or broken</item>
                  </list>
               </text>
               <effectiveTime value="20221116"/>
            </section>
         </component>
