         <component>
            <section ID="id_link_48b8579f-763d-b5b9-e063-6294a90a8a6f">
               <id root="4c1866e4-cffe-6d2a-e063-6394a90a22d2"/>
               <code code="51945-4" codeSystem="2.16.840.1.113883.6.1" displayName="PACKAGE LABEL.PRINCIPAL DISPLAY PANEL"/>
