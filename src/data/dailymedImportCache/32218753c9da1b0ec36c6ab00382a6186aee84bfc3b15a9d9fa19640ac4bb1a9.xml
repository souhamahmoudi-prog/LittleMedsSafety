               <code code="55106-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ACTIVE INGREDIENT SECTION"/>
               <title>
                  <content styleCode="italics">Active ingredients (in each caplet)</content>
               </title>
               <text>
                  <paragraph>Diphenhydramine citrate 38 mg</paragraph>
                  <paragraph>Ibuprofen 200 mg (NSAID)*</paragraph>
                  <paragraph>*nonsteroidal anti-inflammatory drug</paragraph>
               </text>
               <effectiveTime value="20210902"/>
            </section>
