            <section ID="LINK_61614e72-357c-40dc-9dde-dace0206306e">
               <id root="6298d6d0-5cbb-40b6-9b99-476e4e652c50"/>
               <code code="55106-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ACTIVE INGREDIENT SECTION"/>
               <title>
                  <content styleCode="bold">
                     <content styleCode="italics">Active ingredients (in each tablet)</content>
                  </content>
               </title>
               <text>
                  <paragraph>Acetaminophen 250 mg<br/>Aspirin 250 mg (NSAID)*<br/>Caffeine 65 mg<br/>*nonsteroidal anti-inflammatory drug</paragraph>
               </text>
               <effectiveTime value="20260701"/>
            </section>
